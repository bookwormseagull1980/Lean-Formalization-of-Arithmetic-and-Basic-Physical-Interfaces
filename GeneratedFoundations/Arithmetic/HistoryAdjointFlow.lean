module

public import GeneratedFoundations.Arithmetic.HistoryAdjointCasimir

/-!
# Relaxation generated by the complete arithmetic adjoint action

The generator is the double commutator already evaluated on the complete
history--phase operation algebra. Its kernel is the scalar subspace. Its
other eigenvalue is the actual carrier dimension, at least four at every
cutoff. The trace part is therefore retained exactly while the complete
traceless response contracts at an explicitly calculated uniform rate.

This is the evolution of the operation-algebra Casimir. It is a different
operator from the Gaussian-weighted history reaction generator; their
coefficients, kernels and spectral conclusions are not identified.
-/

@[expose] public section

noncomputable section

namespace GeneratedFoundations.Arithmetic.HistoryAdjointFlow

open HistoryCliffordAction (Space)
open HistoryAdjointCasimir
open Geometry.HilbertTraceVariation

abbrev Operator (N : ℕ) := Module.End ℂ (Space N)

theorem trace_scalarPart (N : ℕ) (X : Operator N) :
    LinearMap.trace ℂ (Space N) (scalarPart N X) = LinearMap.trace ℂ (Space N) X := by
  have hd : (dimension N : ℂ) ≠ 0 := by exact_mod_cast (dimension_pos N).ne'
  rw [scalarPart, map_smul, trace_identity]
  simp [hd]

def flow (N : ℕ) (t : ℝ) (X : Operator N) : Operator N :=
  scalarPart N X + Real.exp (-t * (dimension N : ℝ)) • tracelessPart N X

theorem trace_flow (N : ℕ) (t : ℝ) (X : Operator N) :
    LinearMap.trace ℂ (Space N) (flow N t X) = LinearMap.trace ℂ (Space N) X := by
  rw [flow, map_add]
  change LinearMap.trace ℂ (Space N) (scalarPart N X) +
    LinearMap.trace ℂ (Space N)
      ((Real.exp (-t * (dimension N : ℝ)) : ℂ) • tracelessPart N X) = _
  rw [map_smul, trace_tracelessPart, smul_zero,
    add_zero, trace_scalarPart]

theorem scalarPart_flow (N : ℕ) (t : ℝ) (X : Operator N) :
    scalarPart N (flow N t X) = scalarPart N X := by
  rw [scalarPart, trace_flow, scalarPart]

theorem tracelessPart_flow (N : ℕ) (t : ℝ) (X : Operator N) :
    tracelessPart N (flow N t X) =
      Real.exp (-t * (dimension N : ℝ)) • tracelessPart N X := by
  rw [tracelessPart, scalarPart_flow, flow]
  abel

@[simp] theorem flow_zero (N : ℕ) (X : Operator N) : flow N 0 X = X := by
  simp only [flow, neg_zero, zero_mul, Real.exp_zero, one_smul]
  exact (complete_decomposition N X).symm

@[simp] theorem flow_zero_input (N : ℕ) (t : ℝ) : flow N t 0 = 0 := by
  simp [flow, scalarPart, tracelessPart]

theorem flow_add_time (N : ℕ) (s t : ℝ) (X : Operator N) :
    flow N s (flow N t X) = flow N (s + t) X := by
  rw [flow, scalarPart_flow, tracelessPart_flow, smul_smul, flow]
  rw [show -(s + t) * (dimension N : ℝ) =
    -s * (dimension N : ℝ) + -t * (dimension N : ℝ) by ring, Real.exp_add]

theorem flow_hasDerivAt_apply (N : ℕ) (t : ℝ) (X : Operator N) (x : Space N) :
    HasDerivAt (fun s : ℝ => flow N s X x) (-(operator N (flow N t X) x)) t := by
  have he := (((hasDerivAt_id t).neg.mul_const (dimension N : ℝ)).exp).smul_const
    (tracelessPart N X x)
  have h := (hasDerivAt_const t (scalarPart N X x)).add he
  simp only [Pi.neg_apply, id_eq] at h
  convert h using 1
  · funext s
    simp [flow, LinearMap.add_apply, LinearMap.smul_apply]
  · rw [operator_eq_tracelessPart, tracelessPart_flow]
    simp only [LinearMap.smul_apply, zero_add]
    module

/-- The full Casimir response form, including its scalar kernel. -/
def responseAction (N : ℕ) (X : Operator N) : ℝ := pair X (operator N X) / 2

theorem responseAction_eq (N : ℕ) (X : Operator N) :
    responseAction N X = (dimension N : ℝ) *
      Geometry.HilbertTraceQuadratic.energy (tracelessPart N X) / 2 := by
  rw [responseAction, complete_pair]

theorem responseAction_nonneg (N : ℕ) (X : Operator N) : 0 ≤ responseAction N X :=
  div_nonneg (complete_pair_nonneg N X) (by norm_num)

theorem responseAction_zero_iff (N : ℕ) (X : Operator N) :
    responseAction N X = 0 ↔ tracelessPart N X = 0 := by
  rw [responseAction_eq, div_eq_zero_iff]
  have hd : (dimension N : ℝ) ≠ 0 := by exact_mod_cast (dimension_pos N).ne'
  simp [hd, Geometry.HilbertTraceQuadratic.energy_eq_zero_iff]

theorem energy_real_smul (N : ℕ) (c : ℝ) (X : Operator N) :
    Geometry.HilbertTraceQuadratic.energy (c • X) =
      c ^ 2 * Geometry.HilbertTraceQuadratic.energy X := by
  change Geometry.HilbertTraceQuadratic.energy ((c : ℂ) • X) = _
  rw [energy_eq_pair, pair_smul_left, pair_smul_right]
  rw [← energy_eq_pair]
  ring

theorem responseAction_flow (N : ℕ) (t : ℝ) (X : Operator N) :
    responseAction N (flow N t X) =
      Real.exp (-2 * t * (dimension N : ℝ)) * responseAction N X := by
  rw [responseAction_eq, tracelessPart_flow, energy_real_smul, responseAction_eq]
  have he : Real.exp (-t * (dimension N : ℝ)) ^ 2 =
      Real.exp (-2 * t * (dimension N : ℝ)) := by
    rw [pow_two, ← Real.exp_add]
    congr 1
    ring
  rw [he]
  ring

/-- The rate eight follows from the actual carrier dimension, not a fitted
or postulated lower bound. It is uniform in the finite history cutoff. -/
theorem responseAction_uniform_decay (N : ℕ) (t : ℝ) (ht : 0 ≤ t) (X : Operator N) :
    responseAction N (flow N t X) ≤ Real.exp (-8 * t) * responseAction N X := by
  rw [responseAction_flow]
  apply mul_le_mul_of_nonneg_right _ (responseAction_nonneg N X)
  apply Real.exp_le_exp.mpr
  have hd : (4 : ℝ) ≤ dimension N := by exact_mod_cast dimension_ge_four N
  nlinarith

theorem responseAction_nonincreasing (N : ℕ) (t : ℝ) (ht : 0 ≤ t) (X : Operator N) :
    responseAction N (flow N t X) ≤ responseAction N X := by
  have he : Real.exp (-8 * t) ≤ 1 := Real.exp_le_one_iff.mpr (by linarith)
  exact (responseAction_uniform_decay N t ht X).trans
    (by nlinarith [responseAction_nonneg N X])

theorem responseAction_flow_deriv (N : ℕ) (t : ℝ) (X : Operator N) :
    HasDerivAt (fun s : ℝ => responseAction N (flow N s X))
      (-2 * (dimension N : ℝ) * responseAction N (flow N t X)) t := by
  have h := (((hasDerivAt_id t).const_mul (-2 * (dimension N : ℝ))).exp).mul_const
    (responseAction N X)
  simp only [id_eq] at h
  convert h using 1
  · funext s
    rw [responseAction_flow]
    congr 2
    ring
  · rw [responseAction_flow]
    ring_nf

structure Conclusions : Prop where
  initial : ∀ N X, flow N 0 X = X
  zero_input : ∀ N t, flow N t 0 = 0
  semigroup : ∀ N s t X, flow N s (flow N t X) = flow N (s + t) X
  generated_equation : ∀ N t X x,
    HasDerivAt (fun s : ℝ => flow N s X x) (-(operator N (flow N t X) x)) t
  conserved_trace : ∀ N t X,
    LinearMap.trace ℂ (Space N) (flow N t X) = LinearMap.trace ℂ (Space N) X
  exact_energy : ∀ N t X, responseAction N (flow N t X) =
    Real.exp (-2 * t * (dimension N : ℝ)) * responseAction N X
  uniform_rate : ∀ N t, 0 ≤ t → ∀ X,
    responseAction N (flow N t X) ≤ Real.exp (-8 * t) * responseAction N X
  lyapunov : ∀ N t, 0 ≤ t → ∀ X,
    responseAction N (flow N t X) ≤ responseAction N X
  actual_derivative : ∀ N t X,
    HasDerivAt (fun s : ℝ => responseAction N (flow N s X))
      (-2 * (dimension N : ℝ) * responseAction N (flow N t X)) t

theorem generated : Conclusions where
  initial := flow_zero
  zero_input := flow_zero_input
  semigroup := flow_add_time
  generated_equation := flow_hasDerivAt_apply
  conserved_trace := trace_flow
  exact_energy := responseAction_flow
  uniform_rate := responseAction_uniform_decay
  lyapunov := responseAction_nonincreasing
  actual_derivative := responseAction_flow_deriv

end GeneratedFoundations.Arithmetic.HistoryAdjointFlow
