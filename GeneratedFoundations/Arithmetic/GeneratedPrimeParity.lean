module

public import GeneratedFoundations.Arithmetic.InternalPrimes

/-!
# Prime parity generated by the native source modes

The internal Euclidean construction supplies a unique multiset of irreducible
circle modes for every nonzero native mode.  This module takes the cardinality
of that generated multiset and forms its central parity.  No classical
Liouville or Moebius function is used in the definition.

The value on a positive natural root is obtained only after applying the
already generated power-mode coordinate.  A later comparison module may prove
that this intrinsic character agrees with a classical arithmetic function;
that comparison is not an input here.
-/

@[expose] public section

noncomputable section

namespace GeneratedFoundations.Arithmetic.GeneratedPrimeParity

open NativeModes

/-- The unique irreducible multiset of a nonzero native mode. -/
def factorMultiset (x : Mode) (hx : x ≠ 0) : Multiset Mode :=
  Classical.choose (native_factor_multiset_existsUnique hx).exists

theorem factorMultiset_spec (x : Mode) (hx : x ≠ 0) :
    (∀ p ∈ factorMultiset x hx, NativeIrreducible p) ∧
      (factorMultiset x hx).prod = x :=
  Classical.choose_spec (native_factor_multiset_existsUnique hx).exists

theorem factorMultiset_unique {x : Mode} (hx : x ≠ 0)
    (s : Multiset Mode)
    (hs : (∀ p ∈ s, NativeIrreducible p) ∧ s.prod = x) :
    s = factorMultiset x hx :=
  (native_factor_multiset_existsUnique hx).unique hs (factorMultiset_spec x hx)

theorem factorMultiset_proof_irrel (x : Mode) (hx hx' : x ≠ 0) :
    factorMultiset x hx = factorMultiset x hx' := rfl

/-- Multiplication concatenates the two generated irreducible multisets. -/
theorem factorMultiset_mul (x y : Mode) (hx : x ≠ 0) (hy : y ≠ 0) :
    factorMultiset (x * y) (native_mul_ne_zero hx hy) =
      factorMultiset x hx + factorMultiset y hy := by
  symm
  apply factorMultiset_unique (native_mul_ne_zero hx hy)
  constructor
  · intro p hp
    rcases Multiset.mem_add.mp hp with hp | hp
    · exact (factorMultiset_spec x hx).1 p hp
    · exact (factorMultiset_spec y hy).1 p hp
  · simp [(factorMultiset_spec x hx).2, (factorMultiset_spec y hy).2]

/-- Internal irreducibility becomes ordinary primality only after applying
the generated power-mode coordinate.  This is a comparison theorem, not an
input to native factorization. -/
theorem index_prime_of_nativeIrreducible {p : Mode} (hp : NativeIrreducible p) :
    Nat.Prime (index p) := by
  rw [Nat.prime_iff_not_exists_mul_eq]
  constructor
  · have h0 : index p ≠ 0 := (index_eq_zero_iff p).not.mpr hp.1
    have h1 : index p ≠ 1 := by
      intro hi
      apply hp.2.1
      apply index_injective
      simpa using hi
    omega
  · rintro ⟨m, n, hm, hn, hmn⟩
    have heq : p = powerMode m * powerMode n := by
      apply index_injective
      simp [hmn]
    rcases hp.2.2 (powerMode m) (powerMode n) heq with hm1 | hn1
    · have hmi : m = 1 := by
        have := congrArg index hm1
        simpa using this
      rw [hmi, one_mul] at hmn
      exact (Nat.lt_irrefl (index p)) (hmn ▸ hn)
    · have hni : n = 1 := by
        have := congrArg index hn1
        simpa using this
      rw [hni, mul_one] at hmn
      exact (Nat.lt_irrefl (index p)) (hmn ▸ hm)

/-- Total generated prime occupancy, with multiplicity. -/
def factorCount (x : Mode) (hx : x ≠ 0) : ℕ :=
  (factorMultiset x hx).card

theorem factorCount_proof_irrel (x : Mode) (hx hx' : x ≠ 0) :
    factorCount x hx = factorCount x hx' := rfl

theorem factorCount_mul (x y : Mode) (hx : x ≠ 0) (hy : y ≠ 0) :
    factorCount (x * y) (native_mul_ne_zero hx hy) =
      factorCount x hx + factorCount y hy := by
  rw [factorCount, factorCount, factorCount, factorMultiset_mul]
  exact Multiset.card_add _ _

/-- Central parity of a nonzero generated mode. -/
def modeCentre (x : Mode) (hx : x ≠ 0) : ℤ :=
  (-1) ^ factorCount x hx

theorem mode_one_ne_zero : (1 : Mode) ≠ 0 := by
  intro h
  have hi := congrArg index h
  simp at hi

@[simp] theorem modeCentre_one : modeCentre 1 mode_one_ne_zero = 1 := by
  have hfac : factorMultiset 1 mode_one_ne_zero = 0 := by
    exact (factorMultiset_unique mode_one_ne_zero 0 (by simp)).symm
  simp [modeCentre, factorCount, hfac]

theorem modeCentre_mul (x y : Mode) (hx : x ≠ 0) (hy : y ≠ 0) :
    modeCentre (x * y) (native_mul_ne_zero hx hy) =
      modeCentre x hx * modeCentre y hy := by
  rw [modeCentre, modeCentre, modeCentre, factorCount_mul, pow_add]

/-- Any multiplicative integer character that sends every generated
irreducible to `-1` agrees with the generated central parity. -/
theorem modeCentre_unique
    (f : Mode → ℤ)
    (fone : f 1 = 1)
    (fmul : ∀ x y, f (x * y) = f x * f y)
    (fprime : ∀ p, NativeIrreducible p → f p = -1)
    (x : Mode) (hx : x ≠ 0) :
    f x = modeCentre x hx := by
  let s := factorMultiset x hx
  have hsprod : s.prod = x := (factorMultiset_spec x hx).2
  have hsprime : ∀ p ∈ s, NativeIrreducible p := (factorMultiset_spec x hx).1
  have hlist_general : ∀ l : List Mode,
      (∀ p ∈ l, NativeIrreducible p) →
        f l.prod = (-1 : ℤ) ^ l.length := by
    intro l hl
    induction l with
    | nil => simpa using fone
    | cons p l ih =>
        rw [List.prod_cons, fmul, fprime p (hl p (by simp)), ih (fun q hq => hl q (by simp [hq]))]
        simp [pow_succ, mul_comm]
  have hlist : f s.toList.prod = (-1 : ℤ) ^ s.toList.length :=
    hlist_general s.toList (fun p hp => hsprime p (Multiset.mem_toList.mp hp))
  rw [Multiset.prod_toList, hsprod] at hlist
  simpa [modeCentre, factorCount, s] using hlist

/-- Prime occupancy of a natural root, read through the generated power mode.
The zero value is a totalization only; generated history fibres are positive. -/
def rootPrimeCount (n : ℕ) : ℕ :=
  if hn : n = 0 then 0 else factorCount (powerMode n) (by
    intro h
    apply hn
    exact powerMode_injective (by simpa using h))

/-- Central parity on natural roots, obtained from the generated mode
factorization. -/
def rootCentre (n : ℕ) : ℤ :=
  if _hn : n = 0 then 0 else (-1) ^ rootPrimeCount n

@[simp] theorem rootCentre_zero : rootCentre 0 = 0 := by
  simp [rootCentre]

@[simp] theorem rootPrimeCount_one : rootPrimeCount 1 = 0 := by
  simp only [rootPrimeCount, one_ne_zero, ↓reduceDIte]
  have hp10 : powerMode 1 ≠ 0 := by
    intro h
    have hi := congrArg index h
    simp at hi
  have hfac : factorMultiset (powerMode 1) hp10 = 0 := by
    simpa only [powerMode_one] using
      (show factorMultiset 1 mode_one_ne_zero = 0 by
        exact (factorMultiset_unique mode_one_ne_zero 0 (by simp)).symm)
  rw [factorCount]
  simp only [factorMultiset_proof_irrel (powerMode 1) _ hp10, hfac,
    Multiset.card_zero]

@[simp] theorem rootCentre_one : rootCentre 1 = 1 := by
  simp [rootCentre]

theorem rootPrimeCount_mul (m n : ℕ) (hm : m ≠ 0) (hn : n ≠ 0) :
    rootPrimeCount (m * n) = rootPrimeCount m + rootPrimeCount n := by
  have hmn : m * n ≠ 0 := Nat.mul_ne_zero hm hn
  simp only [rootPrimeCount, hm, hn, hmn, ↓reduceDIte]
  have hpm : powerMode m ≠ 0 := by
    intro h
    apply hm
    exact powerMode_injective (by simpa using h)
  have hpn : powerMode n ≠ 0 := by
    intro h
    apply hn
    exact powerMode_injective (by simpa using h)
  simpa only [powerMode_mul] using factorCount_mul (powerMode m) (powerMode n) hpm hpn

theorem rootCentre_mul (m n : ℕ) :
    rootCentre (m * n) = rootCentre m * rootCentre n := by
  by_cases hm : m = 0
  · simp [hm]
  by_cases hn : n = 0
  · simp [hn]
  have hmn : m * n ≠ 0 := Nat.mul_ne_zero hm hn
  simp only [rootCentre, hm, hn, hmn, ↓reduceDIte]
  rw [rootPrimeCount_mul m n hm hn, pow_add]

structure Conclusions : Prop where
  intrinsic_factorization : ∀ (x : Mode) (hx : x ≠ 0),
    (∀ p ∈ factorMultiset x hx, NativeIrreducible p) ∧
      (factorMultiset x hx).prod = x
  multiplicative_occupancy : ∀ (x y : Mode) (hx : x ≠ 0) (hy : y ≠ 0),
    factorCount (x * y) (native_mul_ne_zero hx hy) =
      factorCount x hx + factorCount y hy
  intrinsic_character : ∀ (m n : ℕ),
    rootCentre (m * n) = rootCentre m * rootCentre n
  character_unique : ∀ (f : Mode → ℤ), f 1 = 1 →
    (∀ x y, f (x * y) = f x * f y) →
    (∀ p, NativeIrreducible p → f p = -1) →
    ∀ (x : Mode) (hx : x ≠ 0), f x = modeCentre x hx

theorem generatedPrimeParityConclusions : Conclusions where
  intrinsic_factorization := factorMultiset_spec
  multiplicative_occupancy := factorCount_mul
  intrinsic_character := rootCentre_mul
  character_unique := modeCentre_unique

end GeneratedFoundations.Arithmetic.GeneratedPrimeParity
