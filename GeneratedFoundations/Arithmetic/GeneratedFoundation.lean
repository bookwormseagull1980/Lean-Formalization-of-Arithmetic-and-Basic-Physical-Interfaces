variable (d : MinimalCarrier.OrthogonalChangeDatum) (h : MinimalCarrier.IsMinimal d)
variable (o : OrientationOnCarrier d)

/-- Analytic conclusions for one realization of the source. The endpoint
readouts and reflecting operator are constructed internally; their comparison
statements retain the stated calibration and boundary class. -/
structure SourceClosure (μ : ℝ → Measure (TraceLieSpace d h)) (b : ℝ) (hb : 0 < b) : Prop where
  dimension : Module.finrank ℝ d.Carrier = 2
  action_classification :
    ∃ (e : d.Carrier ≃ₗᵢ[ℝ] ℂ) (χ : d.Changes ≃* Circle),
      Continuous χ ∧ Continuous χ.symm ∧
        ∀ g v, e (d.action g v) = (χ g : ℂ) * e v
  complex_structure :
    ∃! F : ℂ →ₐ[ℝ] Module.End ℝ d.Carrier, F Complex.I = carrierQuarterTurn d h o
  coordinate_unique :
    ∃! q : TraceLieSpace d h ≃ₗᵢ[ℝ] ℝ, q (carrierUnit d h o) = 1
  law : ∀ (t : ℝ) (ht : 0 < t),
    (μ t).map (OrientedTraceCoordinate.coordinate d h o) =
      gaussianReal 0 (NNReal.mk t ht.le)
  law_unique : ∀ ν : ℝ → Measure (TraceLieSpace d h),
    HilbertCompositionalAxioms ν → ∀ t : ℝ, 0 < t → μ t = ν t
  entropy : ∀ ν : Measure ℝ, IsProbabilityMeasure ν →
    ν ≪ volume → MemLp (fun x : ℝ => x) 2 ν → (∫ x : ℝ, x ∂ν) = 0 →
    variance (fun x : ℝ => x) ν = b ^ 2 →
      differentialEntropy ν ≤ differentialEntropy
        ((μ (b ^ 2)).map (OrientedTraceCoordinate.coordinate d h o)) ∧
      (differentialEntropy ν = differentialEntropy
          ((μ (b ^ 2)).map (OrientedTraceCoordinate.coordinate d h o)) ↔
        ν = (μ (b ^ 2)).map (OrientedTraceCoordinate.coordinate d h o))
  profile_density : (μ (b ^ 2)).map (OrientedTraceCoordinate.coordinate d h o) =
    volume.withDensity (fun y => ENNReal.ofReal (changeKernel b y))
  amplitude_density : (μ (b ^ 2 / 4)).map (OrientedTraceCoordinate.coordinate d h o) =
    volume.withDensity (fun y => ENNReal.ofReal (state b 0 y ^ 2))
  overlap : ∀ x z : ℝ, GaussianCorrelation.overlap b x z = profile b (x - z)
  information_calibration : ∀ F : CorrelationLevel → ℝ,
    AdditiveLocalInformation F → F (expNeg 1) = 1 →
      ∀ x : ℝ, F (correlationLevel b x) = information b x
  local_selection : IsLeast (uvThresholdSet b) (windowLeft b)
  local_unique : ∃! x : ℝ, 0 < x ∧ information b x = 1
  global_selection : windowRight b = peakEquivalentWidth (profile b)
  global_unique : ∃! x : ℝ, 0 < x ∧ profile b 0 * x = ∫ y : ℝ, profile b y
  endpoints : windowLeft b = Real.sqrt 2 * b ∧
    windowRight b = Real.sqrt (2 * Real.pi) * b ∧
    windowLengthGenerated b = b * (Real.sqrt (2 * Real.pi) - Real.sqrt 2)
  calibrated_readout : ∀ R : ℝ → ℝ → ℝ, ReadoutLaws R →
    HasDerivAt (logarithmicReadout R) 1 0 →
      R (separationScale (windowLeft b)) (separationScale (windowRight b)) = Real.pi
  boundary_selection : ∀ B C : SeparatedBoundary, B.accepts 1 0 → C.accepts 1 0 →
    ∀ f : H2Representative (windowLeft b) (windowRight b),
      (B.accepts (f.value (windowLeft b)) (f.first (windowLeft b)) ∧
        C.accepts (f.value (windowRight b)) (f.first (windowRight b))) ↔ IsNeumann f
  spectrum : intervalNeumannSpectrum (sub_pos.mp (windowLengthGenerated_pos hb)) =
    Set.range (fun n : ℕ => (neumannEigenvalue (windowLengthGenerated b) n : ℂ))
  spectral_basis :
    ∃ B : HilbertBasis ℕ ℂ (ComplexIntervalL2 (windowLeft b) (windowRight b)),
      (∀ f : ComplexIntervalL2 (windowLeft b) (windowRight b),
        f ∈ complexNeumannDomain (windowLeft b) (windowRight b) ↔
          Summable (fun n : ℕ => (neumannEigenvalue (windowLengthGenerated b) n) ^ 2 *
            ‖inner ℂ (B n) f‖ ^ 2)) ∧
      (∀ f : complexNeumannDomain (windowLeft b) (windowRight b), ∀ n : ℕ,
        inner ℂ (B n) ((complexNeumannOperator
          (sub_pos.mp (windowLengthGenerated_pos hb))).toFun f) =
            (neumannEigenvalue (windowLengthGenerated b) n : ℂ) *
              inner ℂ (B n) (f : ComplexIntervalL2 (windowLeft b) (windowRight b)))
  compact_resolvent : ∀ z : ℂ,
    (∀ n : ℕ, z ≠ (neumannEigenvalue (windowLengthGenerated b) n : ℂ)) →
      ∃! S : ComplexIntervalL2 (windowLeft b) (windowRight b) →L[ℂ]
          ComplexIntervalL2 (windowLeft b) (windowRight b),
        IsIntervalNeumannResolvent (sub_pos.mp (windowLengthGenerated_pos hb)) z S ∧
          IsCompactOperator S
  original_source_heat :
    letI : Fact (0 < windowLengthGenerated b) := ⟨windowLengthGenerated_pos hb⟩
    ∀ (s : ℝ≥0), 0 < s → ∀ f : ComplexIntervalL2 0 (windowLengthGenerated b),
      SourceGaussianHeat.average d h (windowLengthGenerated b) o
          (μ (SourceGaussianHeat.sourceParameter (windowLengthGenerated b) s : ℝ))
          (reflectingHaarIsometry (windowLengthGenerated b) f) =
        reflectingHaarIsometry (windowLengthGenerated b)
          (NeumannHeatSemigroup.heat (windowLengthGenerated b) s f)

variable {μ : ℝ → Measure (TraceLieSpace d h)}

/-- The entropy comparison is with the coordinate image of the original law. -/
theorem source_entropy (hμ : HilbertCompositionalAxioms μ) {b : ℝ} (hb : 0 < b)
    (ν : Measure ℝ) [IsProbabilityMeasure ν] (hac : ν ≪ volume)
    (hX : MemLp (fun x : ℝ => x) 2 ν) (hmean : (∫ x : ℝ, x ∂ν) = 0)
    (hvar : variance (fun x : ℝ => x) ν = b ^ 2) :
    differentialEntropy ν ≤ differentialEntropy
        ((μ (b ^ 2)).map (OrientedTraceCoordinate.coordinate d h o)) ∧
      (differentialEntropy ν = differentialEntropy
          ((μ (b ^ 2)).map (OrientedTraceCoordinate.coordinate d h o)) ↔
        ν = (μ (b ^ 2)).map (OrientedTraceCoordinate.coordinate d h o)) := by
  have ht : 0 < b ^ 2 := sq_pos_of_pos hb
  have hv : (NNReal.mk (b ^ 2) ht.le) ≠ 0 := by
    intro hz
    have hh := congrArg (fun x : ℝ≥0 => (x : ℝ)) hz
    exact ht.ne' hh
  rw [hμ.coordinate_law (OrientedTraceCoordinate.coordinate d h o) ht]
  exact ⟨gaussian_entropy_maximal hac hX hmean hv hvar,
    gaussian_entropy_equality_iff hac hX hmean hv hvar⟩

theorem minimalChange_sourceClosure (hμ : HilbertCompositionalAxioms μ)
    {b : ℝ} (hb : 0 < b) : SourceClosure d h o μ b hb := by
  obtain ⟨hdim, hmodel⟩ := MinimalCarrier.minimalCarrier_classification d h
  refine {
    dimension := hdim
    action_classification := hmodel
    complex_structure := carrier_complexScalarAction_existsUnique d h o
    coordinate_unique := OrientedTraceCoordinate.coordinate_existsUnique d h o
    law := fun t ht => hμ.coordinate_law (OrientedTraceCoordinate.coordinate d h o) ht
    law_unique := fun ν hν t ht =>
      hμ.unique (OrientedTraceCoordinate.coordinate d h o) hν ht
    entropy := ?_
    profile_density := GeneratedSourceWindow.coordinate_profile_density d h hμ
      (OrientedTraceCoordinate.coordinate d h o) hb
    amplitude_density := GeneratedSourceWindow.coordinate_state_squared_density d h hμ
      (OrientedTraceCoordinate.coordinate d h o) hb
    overlap := overlap_eq_profile hb
    information_calibration := fun F hF hcal x => calibrated_information hF hcal b x
    local_selection := ?_
    local_unique := uvEndpoint_unique hb
    global_selection := irEndpoint_eq_peakEquivalentWidth b
    global_unique := irEndpoint_unique hb
    endpoints := ⟨uvEndpoint_eq hb, irEndpoint_eq hb, ?_⟩
    calibrated_readout := fun R hR hunit => normalized_readout_endpoint_value hR hunit hb
    boundary_selection := fun B C hB hC f => separatedClosure_selects_neumann B C hB hC f
    spectrum := generatedWindow_neumannSpectrum hb
    spectral_basis := generatedWindow_neumannBasis hb
    compact_resolvent := generatedWindow_neumannResolvent_existsUnique hb
    original_source_heat := ?_ }
  · intro ν hν hac hX hmean hvar
    let : IsProbabilityMeasure ν := hν
    exact source_entropy d h o hμ hb ν hac hX hmean hvar
  · change IsLeast (uvThresholdSet b) (uvEndpoint b)
    rw [uvEndpoint_eq hb]
    exact uvEndpoint_isLeast hb
  · rw [windowLengthGenerated_eq, windowLength_eq hb]
  · let : Fact (0 < windowLengthGenerated b) := ⟨windowLengthGenerated_pos hb⟩
    exact fun s hs f => SourceGaussianHeat.source_average_at_spatial_parameter
      d h (windowLengthGenerated b) o hμ hs f

section NativeArithmetic

variable (L : ℝ) [Fact (0 < L)]
open TypedSourceModes

/-- Winding certifies the already constructed original-group arithmetic. -/
def degreeEquiv : Mode d h L o ≃+* ℕ :=
  ((generatedEquiv d h L o).trans (GeneratedModes.nativeEquiv L)).trans
    WindingCertification.degreeEquiv

theorem degreeEquiv_eq_index (u : Mode d h L o) :
    degreeEquiv d h o L u =
      NativeModes.index (GeneratedModes.toNative L (toGenerated d h L o u)) :=
  WindingCertification.degreeEquiv_eq_index _

theorem degreeEquiv_integral (u : Mode d h L o) :
    (degreeEquiv d h o L u : ℂ) =
      WindingCertification.degreeIntegral (toGenerated d h L o u).val :=
  WindingCertification.degreeEquiv_integral _

theorem degreeEquiv_energy (u : Mode d h L o) :
    (degreeEquiv d h o L u : ℝ) =
      Real.sqrt (NeumannSpectralProjections.energy L
        (GeneratedModes.component L (toGenerated d h L o u)) /
          NeumannScaleTransport.energyUnit L) := by
  rw [degreeEquiv_eq_index]
  exact GeneratedModes.source_degree_energy L _

theorem degreeEquiv_le_iff (u v : Mode d h L o) :
    degreeEquiv d h o L u ≤ degreeEquiv d h o L v ↔ u ≤ v := by
  rw [TypedArithmetic.le_iff_coordinate, GeneratedModes.source_le_iff_native,
    degreeEquiv_eq_index, degreeEquiv_eq_index]
  rfl

theorem degreeEquiv_successor (u : Mode d h L o) :
    degreeEquiv d h o L (successor d h L o u) = degreeEquiv d h o L u + 1 := by
  change degreeEquiv d h o L (u + 1) = _
  rw [map_add, map_one]

/-- The integer certificate is unique among all zero- and successor-preserving functions. -/
theorem degree_existsUnique :
    ∃! f : Mode d h L o → ℕ, f 0 = 0 ∧
      ∀ u, f (successor d h L o u) = f u + 1 := by
  refine ⟨degreeEquiv d h o L, ⟨map_zero _, degreeEquiv_successor d h o L⟩, ?_⟩
  intro f hf
  funext u
  apply TypedArithmetic.successor_induction d h L o
    (P := fun v => f v = degreeEquiv d h o L v) ?_ ?_ u
  · simpa only [map_zero] using hf.1
  · intro v hv
    rw [hf.2, degreeEquiv_successor, hv]

/-- Peano properties concern the original maps and their heat-response order. -/
structure NativePeanoClosure : Prop where
  native_zero : ∀ x : Carrier d h o, (0 : Mode d h L o) x = 1
  native_one : ∀ x : Carrier d h o, (1 : Mode d h L o) x = x
  modulation : ∀ u v : Mode d h L o, ∀ x : Carrier d h o, (u + v) x = u x * v x
  cascade : ∀ u v : Mode d h L o, ∀ x : Carrier d h o, (u * v) x = u (v x)
  successor_injective : Function.Injective (successor d h L o)
  successor_nonzero : ∀ u : Mode d h L o, successor d h L o u ≠ 0
  induction : ∀ P : Mode d h L o → Prop, P 0 →
    (∀ u, P u → P (successor d h L o u)) → ∀ u, P u
  recursion : ∀ (X : Type) (xzero : X) (step : X → X),
    ∃! f : Mode d h L o → X, f 0 = xzero ∧
      ∀ u, f (successor d h L o u) = step (f u)
  response_order : ∀ u v : Mode d h L o, ∀ t : ℝ≥0, 0 < t →
    (u ≤ v ↔ NeumannSpectralProjections.response L
        (GeneratedModes.component L (toGenerated d h L o v)) t ≤
      NeumannSpectralProjections.response L
        (GeneratedModes.component L (toGenerated d h L o u)) t)
  certificate_order : ∀ u v : Mode d h L o,
    degreeEquiv d h o L u ≤ degreeEquiv d h o L v ↔ u ≤ v
  certificate_integral : ∀ u : Mode d h L o,
    (degreeEquiv d h o L u : ℂ) =
      WindingCertification.degreeIntegral (toGenerated d h L o u).val
  certificate_energy : ∀ u : Mode d h L o,
    (degreeEquiv d h o L u : ℝ) = Real.sqrt (NeumannSpectralProjections.energy L
      (GeneratedModes.component L (toGenerated d h L o u)) /
        NeumannScaleTransport.energyUnit L)
  certificate_unique : ∃! f : Mode d h L o → ℕ, f 0 = 0 ∧
    ∀ u, f (successor d h L o u) = f u + 1

theorem originalModes_nativePeano : NativePeanoClosure d h o L where
  native_zero := zero_apply d h L o
  native_one := one_apply d h L o
  modulation := add_apply d h L o
  cascade := mul_apply d h L o
  successor_injective := TypedArithmetic.successor_injective d h L o
  successor_nonzero := TypedArithmetic.successor_ne_zero d h L o
  induction := fun _ => TypedArithmetic.successor_induction d h L o
  recursion := fun _ => TypedArithmetic.recursion_existsUnique d h L o
  response_order := fun u v _t ht =>
    (TypedArithmetic.le_iff_coordinate d h L o u v).trans
      (GeneratedModes.source_order_response L _ _ ht)
  certificate_order := degreeEquiv_le_iff d h o L
  certificate_integral := degreeEquiv_integral d h o L
  certificate_energy := degreeEquiv_energy d h o L
  certificate_unique := degree_existsUnique d h o L

end NativeArithmetic

/-- The actual source, original differential domain and arithmetic share one window. -/
structure SpectralArithmeticClosure (b : ℝ) (hb : 0 < b) : Prop where
  original_modes :
    letI : Fact (0 < windowLengthGenerated b) := ⟨windowLengthGenerated_pos hb⟩
    ∃ U : ComplexIntervalL2 (windowLeft b) (windowRight b) ≃ₗᵢ[ℂ]
        ComplexIntervalL2 0 (windowLengthGenerated b),
      (∀ f : ComplexIntervalL2 (windowLeft b) (windowRight b),
        U f =ᵐ[intervalMeasure 0 (windowLengthGenerated b)]
          fun x => f (x + windowLeft b)) ∧
      ∀ u : TypedSourceModes.Mode d h (windowLengthGenerated b) o,
        ∃! f : complexNeumannDomain (windowLeft b) (windowRight b),
          complexNeumannOperator (sub_pos.mp (windowLengthGenerated_pos hb)) f =
              (neumannEigenvalue (windowLengthGenerated b)
                (GeneratedWindowModes.modeIndex (windowLengthGenerated b) d h o u) : ℂ) •
                  (f : ComplexIntervalL2 (windowLeft b) (windowRight b)) ∧
            ‖(f : ComplexIntervalL2 (windowLeft b) (windowRight b))‖ = 1 ∧
            (∃ r : ℝ, 0 < r ∧
              (complexNeumannRepresentative f).value (windowLeft b) = (r : ℂ)) ∧
            (∀ x ∈ Icc (windowLeft b) (windowRight b),
              (complexNeumannRepresentative f).value x =
                (neumannCosineRepresentative (windowLengthGenerated b)
                  (GeneratedWindowModes.modeIndex (windowLengthGenerated b) d h o u)).value
                    (x - windowLeft b)) ∧
            OrientedLift.lift (windowLengthGenerated b) (U f) =ᵐ[AddCircle.haarAddCircle]
              TypedModeObservations.positiveObservation (windowLengthGenerated b) d h o u
  original_observation :
    letI : Fact (0 < windowLengthGenerated b) := ⟨windowLengthGenerated_pos hb⟩
    ∀ (u : TypedSourceModes.Mode d h (windowLengthGenerated b) o) (g : d.Changes),
      TypedModeObservations.positiveObservation (windowLengthGenerated b) d h o u
          (GeneratedSpectralCircle.spectralCoordinate d h (windowLengthGenerated b) o g) =
        GeneratedWindowModes.sourceObservation (windowLengthGenerated b) d h o u g
  circle_unique :
    letI : Fact (0 < windowLengthGenerated b) := ⟨windowLengthGenerated_pos hb⟩
    ∃! C : d.Changes ≃ₜ* Multiplicative (AddCircle (2 * windowLengthGenerated b)),
      ∀ t, (C (GeneratedSpectralCircle.orientedFlow d h o t)).toAdd =
        ((windowLengthGenerated b / Real.pi * t : ℝ) : AddCircle (2 * windowLengthGenerated b))
  native_peano :
    letI : Fact (0 < windowLengthGenerated b) := ⟨windowLengthGenerated_pos hb⟩
    NativePeanoClosure d h o (windowLengthGenerated b)
  opposite_observation :
    letI : Fact (0 < windowLengthGenerated b) := ⟨windowLengthGenerated_pos hb⟩
    ∀ u : TypedSourceModes.Mode d h (windowLengthGenerated b) o,
      (NegativeOrientedLift.lift (windowLengthGenerated b)
          (TypedModeObservations.sourceRepresentative (windowLengthGenerated b) d h o u :
            ComplexIntervalL2 0 (windowLengthGenerated b)) =ᵐ[AddCircle.haarAddCircle]
        TypedModeObservations.reversedObservation (windowLengthGenerated b) d h o u) ∧
      ∀ z : AddCircle (2 * windowLengthGenerated b),
        TypedModeObservations.reversedObservation (windowLengthGenerated b) d h o u z =
          star (TypedModeObservations.positiveObservation (windowLengthGenerated b) d h o u z)

theorem generatedWindow_spectralArithmetic {b : ℝ} (hb : 0 < b) :
    SpectralArithmeticClosure d h o b hb where
  original_modes := GeneratedWindowModes.generatedWindow_source_modes d h hb o
  original_observation := by
    let : Fact (0 < windowLengthGenerated b) := ⟨windowLengthGenerated_pos hb⟩
    exact GeneratedWindowModes.positiveObservation_sourceCoordinate (windowLengthGenerated b) d h o
  circle_unique := by
    let : Fact (0 < windowLengthGenerated b) := ⟨windowLengthGenerated_pos hb⟩
    exact GeneratedSpectralCircle.carrierCircle_existsUnique d h (windowLengthGenerated b) o
  native_peano := by
    let : Fact (0 < windowLengthGenerated b) := ⟨windowLengthGenerated_pos hb⟩
    exact originalModes_nativePeano d h o (windowLengthGenerated b)
  opposite_observation := by
    let : Fact (0 < windowLengthGenerated b) := ⟨windowLengthGenerated_pos hb⟩
    intro u
    exact ⟨TypedModeObservations.sourceRepresentative_negative_lift
      (windowLengthGenerated b) d h o u,
      TypedModeObservations.reversedObservation_conj (windowLengthGenerated b) d h o u⟩

/-- The continuous Dirac extension of the original law supplies the heat
average at every nonnegative parameter. -/
theorem generatedWindow_sourceHeat (hμ : HilbertCompositionalAxioms μ)
    {b : ℝ} (hb : 0 < b) :
    letI : Fact (0 < windowLengthGenerated b) := ⟨windowLengthGenerated_pos hb⟩
    ∀ (s : ℝ≥0) (f : ComplexIntervalL2 0 (windowLengthGenerated b)),
      SourceGaussianHeat.average d h (windowLengthGenerated b) o
          (SourceGaussianHeat.extendedLaw d h o hμ
            (SourceGaussianHeat.sourceParameter (windowLengthGenerated b) s))
          (reflectingHaarIsometry (windowLengthGenerated b) f) =
        reflectingHaarIsometry (windowLengthGenerated b)
          (NeumannHeatSemigroup.heat (windowLengthGenerated b) s f) := by
  let : Fact (0 < windowLengthGenerated b) := ⟨windowLengthGenerated_pos hb⟩
  exact SourceGaussianHeat.extended_average_at_spatial_parameter d h (windowLengthGenerated b) o hμ

/-- Recursion on the actual generated-window modes also permits targets in
an arbitrary universe. -/
theorem generatedWindow_recursion_existsUnique {X : Type*} (xzero : X) (step : X → X)
    {b : ℝ} (hb : 0 < b) :
    letI : Fact (0 < windowLengthGenerated b) := ⟨windowLengthGenerated_pos hb⟩
    ∃! f : TypedSourceModes.Mode d h (windowLengthGenerated b) o → X,
      f 0 = xzero ∧ ∀ u,
        f (TypedSourceModes.successor d h (windowLengthGenerated b) o u) = step (f u) := by
  let : Fact (0 < windowLengthGenerated b) := ⟨windowLengthGenerated_pos hb⟩
  exact TypedArithmetic.recursion_existsUnique d h (windowLengthGenerated b) o xzero step

/-- Source classification, window selection and original-map Peano arithmetic. -/
theorem minimalChange_to_nativePeanoSemiring (hμ : HilbertCompositionalAxioms μ)
    {b : ℝ} (hb : 0 < b) :
    SourceClosure d h o μ b hb ∧ SpectralArithmeticClosure d h o b hb :=
  ⟨minimalChange_sourceClosure d h o hμ hb, generatedWindow_spectralArithmetic d h o hb⟩

/-- Unique finite prime profiles refer to the same original endomorphisms. -/
theorem minimalChange_to_nativeArithmeticWithFactorization
    (hμ : HilbertCompositionalAxioms μ) {b : ℝ} (hb : 0 < b) :
    SourceClosure d h o μ b hb ∧ SpectralArithmeticClosure d h o b hb ∧
      (letI : Fact (0 < windowLengthGenerated b) := ⟨windowLengthGenerated_pos hb⟩
       (∀ x : TypedSourceModes.Mode d h (windowLengthGenerated b) o, x ≠ 0 →
          ∃! f : TypedSourceModes.Mode d h (windowLengthGenerated b) o →₀ ℕ,
            TypedArithmetic.IsPrimeProfile d h (windowLengthGenerated b) o x f) ∧
        Set.Infinite {p : TypedSourceModes.Mode d h (windowLengthGenerated b) o |
          TypedArithmetic.CompositionIrreducible d h (windowLengthGenerated b) o p}) := by
  refine ⟨minimalChange_sourceClosure d h o hμ hb,
    generatedWindow_spectralArithmetic d h o hb, ?_⟩
  let : Fact (0 < windowLengthGenerated b) := ⟨windowLengthGenerated_pos hb⟩
  exact ⟨fun x hx => TypedArithmetic.primeProfile_existsUnique d h (windowLengthGenerated b) o hx,
    TypedArithmetic.irreducibles_infinite d h (windowLengthGenerated b) o⟩

/-- The canonical comparison applies to two independent minimal change data
and their respective generated windows. -/
theorem nativeTransport_existsUnique
    (e : MinimalCarrier.OrthogonalChangeDatum) (he : MinimalCarrier.IsMinimal e)
    (p : OrientationOnCarrier e) {b c : ℝ} (hb : 0 < b) (hc : 0 < c) :
    letI : Fact (0 < windowLengthGenerated b) := ⟨windowLengthGenerated_pos hb⟩
    letI : Fact (0 < windowLengthGenerated c) := ⟨windowLengthGenerated_pos hc⟩
    ∃! F : TypedSourceModes.Mode d h (windowLengthGenerated b) o →
        TypedSourceModes.Mode e he (windowLengthGenerated c) p,
      GeneratedTransport.IsSourceSpectralTransport d h (windowLengthGenerated b) o
        e he (windowLengthGenerated c) p F := by
  let : Fact (0 < windowLengthGenerated b) := ⟨windowLengthGenerated_pos hb⟩
  let : Fact (0 < windowLengthGenerated c) := ⟨windowLengthGenerated_pos hc⟩
  exact GeneratedTransport.nativeTransport_existsUnique d h (windowLengthGenerated b) o
    e he (windowLengthGenerated c) p

end GeneratedFoundations.Arithmetic.GeneratedFoundation
