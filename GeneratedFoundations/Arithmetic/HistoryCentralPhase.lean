module

public import GeneratedFoundations.Arithmetic.HistoryCentralSectors
public import GeneratedFoundations.Operations.FinitePhaseFlow
public import Mathlib.Analysis.SpecialFunctions.Complex.Log

/-!
# The continuous phase generated by actual prime-occupation parity

The weights are the already generated central character on each positive
root, repeated over its complete history and finite phase fibre. They are
not charges copied from a physical representation. Their self-adjoint
generator is exactly the previously constructed grading operator.

The resulting continuous unitary group acts on the original coefficient
space, commutes with its Gaussian scale flow and history reflection, and
has an exact two-pi kernel detected by the actual unit-root fibre. Even
operators commute with it; odd operators intertwine opposite parameters.
Both statements concern full endomorphisms, including every cross-root
matrix coefficient.
-/

@[expose] public section

noncomputable section

namespace GeneratedFoundations.Arithmetic.HistoryCentralPhase

open HistoryCentralSectors
namespace Phase
export Operations.FinitePhaseFlow (phase)
end Phase

def weight {N : ℕ} (i : Label N) : ℝ :=
  GeneratedPrimeParity.rootCentre (i.1.val + 1)

theorem weight_coe {N : ℕ} (i : Label N) :
    (weight i : ℂ) = sign i.1.val := by
  rw [sign_eq_rootCentre]
  simp [weight]

theorem weight_cases {N : ℕ} (i : Label N) : weight i = 1 ∨ weight i = -1 := by
  rcases sign_cases i.1.val with h | h
  · left
    exact_mod_cast ((weight_coe i).trans h)
  · right
    exact_mod_cast ((weight_coe i).trans h)

theorem weight_positive_iff {N : ℕ} (i : Label N) : weight i = 1 ↔ Positive i := by
  change weight i = 1 ↔ sign i.1.val = 1
  rw [← weight_coe]
  exact_mod_cast (Iff.rfl : weight i = 1 ↔ weight i = 1)

def flow (N : ℕ) (t : ℝ) : Module.End ℂ (Space N) :=
  Operations.FinitePhaseFlow.flow weight t

@[simp] theorem flow_apply (N : ℕ) (t : ℝ) (x : Space N) (i : Label N) :
    flow N t x i = Phase.phase weight t i * x i := rfl

theorem generator_eq_grading (N : ℕ) :
    Operations.FinitePhaseFlow.generator (weight (N := N)) = grading N := by
  ext x i
  simp [weight_coe]

theorem flow_zero (N : ℕ) : flow N 0 = 1 :=
  Operations.FinitePhaseFlow.flow_zero weight

theorem flow_add (N : ℕ) (s t : ℝ) : flow N (s + t) = flow N s * flow N t :=
  Operations.FinitePhaseFlow.flow_add weight s t

theorem flow_inner (N : ℕ) (t : ℝ) (x y : Space N) :
    inner ℂ (flow N t x) (flow N t y) = inner ℂ x y :=
  Operations.FinitePhaseFlow.flow_inner weight t x y

theorem flow_continuous (N : ℕ) (x : Space N) :
    Continuous (fun t : ℝ => flow N t x) :=
  Operations.FinitePhaseFlow.flow_continuous weight x

theorem flow_derivative (N : ℕ) (t : ℝ) (x : Space N) (i : Label N) :
    HasDerivAt (fun s : ℝ => flow N s x i)
      (Complex.I * grading N (flow N t x) i) t := by
  simpa only [flow, generator_eq_grading] using
    Operations.FinitePhaseFlow.flow_hasDerivAt_coordinate weight t x i

theorem flow_eq_exp (N : ℕ) (t : ℝ) :
    Operations.FinitePhaseFlow.continuousModel (flow N t) =
      NormedSpace.exp ((Complex.I * (t : ℂ)) •
        Operations.FinitePhaseFlow.continuousModel (grading N)) := by
  simpa only [flow, generator_eq_grading] using
    Operations.FinitePhaseFlow.flow_eq_exp (weight (N := N)) t

/-- The sector formula is derived on the original carrier rather than
defining an evolution on an independently doubled space. -/
theorem flow_sectors (N : ℕ) (t : ℝ) :
    flow N t = Complex.exp (Complex.I * (t : ℂ)) • positiveProjection N +
      Complex.exp (-Complex.I * (t : ℂ)) • negativeProjection N := by
  ext x i
  by_cases hi : Positive i
  · have hw := (weight_positive_iff i).mpr hi
    simp [Phase.phase, Operations.FinitePhaseFlow.phase, hi, hw]
  · have hw : weight i = -1 := (weight_cases i).resolve_left
      (fun h => hi ((weight_positive_iff i).mp h))
    simp [Phase.phase, Operations.FinitePhaseFlow.phase, hi, hw]

theorem flow_gaussian (N : ℕ) (s t : ℝ) :
    flow N s * gaussian N t = gaussian N t * flow N s := by
  ext x i
  change Phase.phase weight s i * (_ * x i) = _ * (Phase.phase weight s i * x i)
  ring

theorem flow_reflection (N : ℕ) (t : ℝ) :
    flow N t * reflection N = reflection N * flow N t := by
  ext x i
  rfl

theorem odd_intertwines (N : ℕ) (t : ℝ) (T : Module.End ℂ (Space N))
    (hT : grading N * T = -(T * grading N)) :
    flow N t * T = T * flow N (-t) := by
  obtain ⟨hp, hn⟩ := odd_exchanges N T hT
  rw [flow_sectors, flow_sectors, add_mul, mul_add,
    smul_mul_assoc, smul_mul_assoc, mul_smul_comm, mul_smul_comm, hp, hn]
  have h1 : Complex.I * ((-t : ℝ) : ℂ) = -Complex.I * (t : ℂ) := by push_cast; ring
  have h2 : -Complex.I * ((-t : ℝ) : ℂ) = Complex.I * (t : ℂ) := by push_cast; ring
  rw [h1, h2, add_comm]

def unitLabel (N : ℕ) : Label N :=
  ⟨⟨0, Nat.zero_lt_succ N⟩, HistoryModuleRepresentation.base 0⟩

@[simp] theorem unit_weight (N : ℕ) : weight (unitLabel N) = 1 := by
  simp [weight, unitLabel]

/-- A genuine nonzero source coordinate detects the whole phase kernel. -/
theorem flow_eq_one_iff (N : ℕ) (t : ℝ) :
    flow N t = 1 ↔ ∃ k : ℤ, t = k * (2 * Real.pi) := by
  constructor
  · intro h
    have he := congrArg (fun A : Module.End ℂ (Space N) =>
      A (PiLp.single 2 (unitLabel N) 1) (unitLabel N)) h
    have hex : Complex.exp (Complex.I * (t : ℂ)) = 1 := by
      simpa [Phase.phase, Operations.FinitePhaseFlow.phase, PiLp.single_apply] using he
    obtain ⟨k, hk⟩ := Complex.exp_eq_one_iff.mp hex
    refine ⟨k, ?_⟩
    have hi := congrArg Complex.im hk
    simpa using hi
  · rintro ⟨k, rfl⟩
    ext x i
    have hphase : Phase.phase weight (k * (2 * Real.pi)) i = 1 := by
      rcases weight_cases i with hw | hw
      · dsimp [Phase.phase, Operations.FinitePhaseFlow.phase]
        rw [hw]
        convert Complex.exp_int_mul_two_pi_mul_I k using 1
        congr 1
        push_cast
        ring
      · dsimp [Phase.phase, Operations.FinitePhaseFlow.phase]
        rw [hw]
        convert Complex.exp_int_mul_two_pi_mul_I (-k) using 1
        congr 1
        push_cast
        ring
    simp [hphase]

structure Conclusions : Prop where
  generated_weights : ∀ N (i : Label N), (weight i : ℂ) = sign i.1.val
  actual_generator : ∀ N,
    Operations.FinitePhaseFlow.generator (weight (N := N)) = grading N
  group_law : ∀ N s t, flow N (s + t) = flow N s * flow N t
  full_inner_product : ∀ N t (x y : Space N),
    inner ℂ (flow N t x) (flow N t y) = inner ℂ x y
  strong_continuity : ∀ N (x : Space N), Continuous (fun t : ℝ => flow N t x)
  actual_exponential : ∀ N t,
    Operations.FinitePhaseFlow.continuousModel (flow N t) =
      NormedSpace.exp ((Complex.I * (t : ℂ)) •
        Operations.FinitePhaseFlow.continuousModel (grading N))
  exact_kernel : ∀ N t, flow N t = 1 ↔ ∃ k : ℤ, t = k * (2 * Real.pi)
  scale_compatibility : ∀ N s t, flow N s * gaussian N t = gaussian N t * flow N s
  odd_transport : ∀ N t (T : Module.End ℂ (Space N)),
    grading N * T = -(T * grading N) → flow N t * T = T * flow N (-t)

theorem generated : Conclusions where
  generated_weights := fun _ i => weight_coe i
  actual_generator := generator_eq_grading
  group_law := flow_add
  full_inner_product := flow_inner
  strong_continuity := flow_continuous
  actual_exponential := flow_eq_exp
  exact_kernel := flow_eq_one_iff
  scale_compatibility := flow_gaussian
  odd_transport := odd_intertwines

end GeneratedFoundations.Arithmetic.HistoryCentralPhase
