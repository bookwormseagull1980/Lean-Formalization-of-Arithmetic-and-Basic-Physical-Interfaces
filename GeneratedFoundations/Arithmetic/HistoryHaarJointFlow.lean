module

public import GeneratedFoundations.Arithmetic.HistoryHaarJointHessian

/-!
# Evolution generated by the complete joint arithmetic Hessian

The full connection evolves by its already constructed differential heat
semigroup; the homogeneous state evolves by the defining response derived
from the same arithmetic source. Their Hilbert product has the exact lower
edge computed for the joint Hessian. The strong right generator has precisely
that Hessian's full domain. No finite-mode restriction is made on the
connection, and the flow is the vacuum linearization of the coupled action.
-/

@[expose] public section

noncomputable section

open Filter
open scoped Topology NNReal LinearPMap

namespace GeneratedFoundations.Arithmetic.HistoryHaarJointFlow

open HistoryHaarJointHessian

def flow (N : ℕ) (t : ℝ≥0) (x : Space N) : Space N :=
  WithLp.toLp 2 (HistoryHaarHeatFlow.heat N t x.fst,
    HistoryDefiningDynamics.flow N t x.snd)

@[simp] theorem flow_fst (N : ℕ) (t : ℝ≥0) (x : Space N) :
    (flow N t x).fst = HistoryHaarHeatFlow.heat N t x.fst := rfl

@[simp] theorem flow_snd (N : ℕ) (t : ℝ≥0) (x : Space N) :
    (flow N t x).snd = HistoryDefiningDynamics.flow N t x.snd := rfl

@[simp] theorem flow_zero (N : ℕ) (x : Space N) : flow N 0 x = x := by
  apply (WithLp.equiv 2 _).injective
  simp [flow]
  exact Prod.ext rfl rfl

@[simp] theorem flow_zero_input (N : ℕ) (t : ℝ≥0) : flow N t 0 = 0 := by
  apply (WithLp.equiv 2 _).injective
  simp [flow]

theorem flow_add (N : ℕ) (s t : ℝ≥0) (x : Space N) :
    flow N (s + t) x = flow N s (flow N t x) := by
  apply (WithLp.equiv 2 _).injective
  change (HistoryHaarHeatFlow.heat N (s + t) x.fst,
    HistoryDefiningDynamics.flow N (↑(s + t)) x.snd) =
    (HistoryHaarHeatFlow.heat N s (HistoryHaarHeatFlow.heat N t x.fst),
      HistoryDefiningDynamics.flow N s (HistoryDefiningDynamics.flow N t x.snd))
  rw [HistoryHaarHeatFlow.heat_add, HistoryDefiningDynamics.flow_add, NNReal.coe_add]

theorem flow_continuous (N : ℕ) (x : Space N) :
    Continuous (fun t : ℝ≥0 => flow N t x) := by
  exact (WithLp.prod_continuous_toLp 2 _ _).comp
    ((HistoryHaarHeatFlow.heat_stronglyContinuous N x.fst).prodMk
      ((HistoryDefiningDynamics.flow_continuous N x.snd).comp continuous_subtype_val))

theorem flow_preserves_domain (N : ℕ) (t : ℝ≥0) {x : Space N}
    (hx : x ∈ (operator N).domain) : flow N t x ∈ (operator N).domain := by
  apply (domain_iff N _).mpr
  exact HistoryHaarHeatFlow.heat_preserves_domain N t ((domain_iff N x).mp hx)

/-- Sharp full-space norm decay; its constant is independent of the cutoff. -/
theorem flow_norm_decay (N : ℕ) (t : ℝ≥0) (x : Space N) :
    ‖flow N t x‖ ≤ Real.exp (-gapSq N * (t : ℝ)) * ‖x‖ := by
  have hA : ‖(flow N t x).fst‖ ≤
      Real.exp (-gapSq N * (t : ℝ)) * ‖x.fst‖ := by
    apply (HistoryHaarHeatFlow.heat_norm_decay N t x.fst).trans
    apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
    apply Real.exp_le_exp.mpr
    have h := mul_le_mul_of_nonneg_right (min_le_left 4
      (HistoryDefiningResponse.coefficient N)) t.property
    change gapSq N * (t : ℝ) ≤ 4 * (t : ℝ) at h
    linarith
  have hψ : ‖(flow N t x).snd‖ ≤
      Real.exp (-gapSq N * (t : ℝ)) * ‖x.snd‖ := by
    rw [flow_snd, HistoryDefiningDynamics.norm_flow]
    apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
    apply Real.exp_le_exp.mpr
    have h := mul_le_mul_of_nonneg_right (min_le_right 4
      (HistoryDefiningResponse.coefficient N)) t.property
    change gapSq N * (t : ℝ) ≤ HistoryDefiningResponse.coefficient N * (t : ℝ) at h
    linarith
  have ha2 := pow_le_pow_left₀ (norm_nonneg _) hA 2
  have hp2 := pow_le_pow_left₀ (norm_nonneg _) hψ 2
  have hsq : ‖flow N t x‖ ^ 2 ≤
      (Real.exp (-gapSq N * (t : ℝ)) * ‖x‖) ^ 2 := by
    rw [WithLp.prod_norm_sq_eq_of_L2, mul_pow, WithLp.prod_norm_sq_eq_of_L2]
    nlinarith
  exact (sq_le_sq₀ (norm_nonneg _)
    (mul_nonneg (Real.exp_pos _).le (norm_nonneg _))).mp hsq

theorem flow_uniform_decay (N : ℕ) (t : ℝ≥0) (x : Space N) :
    ‖flow N t x‖ ≤ Real.exp (-(15 / 8 : ℝ) * (t : ℝ)) * ‖x‖ := by
  apply (flow_norm_decay N t x).trans
  apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
  apply Real.exp_le_exp.mpr
  have h := mul_le_mul_of_nonneg_right (gapSq_lower N) t.property
  convert! neg_le_neg h using 1 <;> ring_nf <;> rfl

def HasRightGenerator (N : ℕ) (x y : Space N) : Prop :=
  Tendsto (fun t : ℝ≥0 => ((t : ℝ)⁻¹ : ℂ) • (flow N t x - x)) (𝓝[>] 0) (𝓝 y)

private theorem coe_tendsto_right :
    Tendsto (fun t : ℝ≥0 => (t : ℝ)) (𝓝[>] 0) (𝓝[>] (0 : ℝ)) := by
  apply tendsto_nhdsWithin_iff.mpr
  refine ⟨?_, ?_⟩
  · exact (continuous_subtype_val.continuousAt (x := (0 : ℝ≥0))).tendsto.mono_left
      nhdsWithin_le_nhds
  · filter_upwards [self_mem_nhdsWithin] with t ht
    exact ht

private theorem state_rightGenerator (N : ℕ) (ψ : State N) :
    Tendsto (fun t : ℝ≥0 => ((t : ℝ)⁻¹ : ℂ) •
      (HistoryDefiningDynamics.flow N t ψ - ψ)) (𝓝[>] 0)
      (𝓝 (-(HistoryDefiningResponse.response N ψ))) := by
  have h := (HistoryDefiningDynamics.flow_hasDerivAt N 0 ψ).tendsto_slope_zero_right.comp
    coe_tendsto_right
  convert! h using 1
  · funext t
    simp only [Function.comp_def, zero_add, HistoryDefiningDynamics.flow_zero]
    rw [← Complex.ofReal_inv]
    exact Complex.coe_smul ((t : ℝ)⁻¹) (HistoryDefiningDynamics.flow N t ψ - ψ)
  · simp only [HistoryDefiningDynamics.flow_zero]

theorem rightGenerator_on_domain (N : ℕ) (x : (operator N).domain) :
    HasRightGenerator N x.val (-(operator N x)) := by
  have ha := HistoryHaarHeatGenerator.rightGenerator_on_domain N
    ⟨x.val.fst, (domain_iff N x.val).mp x.property⟩
  have hm := state_rightGenerator N x.val.snd
  have h := (WithLp.prod_continuous_toLp 2 _ _).continuousAt.tendsto.comp
    (ha.prodMk_nhds hm)
  rw [operator_components]
  unfold HasRightGenerator
  convert h using 1
  · funext t
    apply (WithLp.equiv 2 _).injective
    exact Prod.ext rfl rfl
  · rfl

theorem mem_domain_of_rightGenerator (N : ℕ) (x y : Space N)
    (hy : HasRightGenerator N x y) : x ∈ (operator N).domain := by
  apply (domain_iff N x).mpr
  apply HistoryHaarHeatGenerator.mem_domain_of_rightGenerator N x.fst y.fst
  have h := (WithLp.continuous_fst 2 _ _).continuousAt.tendsto.comp hy
  exact h

theorem rightGenerator_iff (N : ℕ) (x y : Space N) :
    HasRightGenerator N x y ↔
      ∃ hx : x ∈ (operator N).domain, y = -(operator N ⟨x, hx⟩) := by
  constructor
  · intro hy
    have hx := mem_domain_of_rightGenerator N x y hy
    exact ⟨hx, tendsto_nhds_unique hy (rightGenerator_on_domain N ⟨x, hx⟩)⟩
  · rintro ⟨hx, rfl⟩
    exact rightGenerator_on_domain N ⟨x, hx⟩

structure Conclusions : Prop where
  identity : ∀ N x, flow N 0 x = x
  composition : ∀ N s t x, flow N (s + t) x = flow N s (flow N t x)
  complete_continuity : ∀ N x, Continuous (fun t : ℝ≥0 => flow N t x)
  exact_domain : ∀ N x y, HasRightGenerator N x y ↔
    ∃ hx : x ∈ (operator N).domain, y = -(operator N ⟨x, hx⟩)
  invariant_domain : ∀ N t x, x ∈ (operator N).domain → flow N t x ∈ (operator N).domain
  sharp_decay : ∀ N t x, ‖flow N t x‖ ≤ Real.exp (-gapSq N * (t : ℝ)) * ‖x‖
  uniform_decay : ∀ N t x, ‖flow N t x‖ ≤
    Real.exp (-(15 / 8 : ℝ) * (t : ℝ)) * ‖x‖

theorem generated : Conclusions where
  identity := flow_zero
  composition := flow_add
  complete_continuity := flow_continuous
  exact_domain := rightGenerator_iff
  invariant_domain := fun N t _x => flow_preserves_domain N t
  sharp_decay := flow_norm_decay
  uniform_decay := flow_uniform_decay

end GeneratedFoundations.Arithmetic.HistoryHaarJointFlow
