/-!
# Common arithmetic and physical foundation

This module is the zero-input common-root theorem. Minimal unbiased
compositional change has already selected its canonical carrier and unique
compositional law. Unit covariance fixes the positive Gaussian width to one,
and the original complex rotation supplies the orientation. Neither quantity
is accepted from a caller.

The proof below uses the source, spectral and factorization constructions
directly at this canonical realization. Coordinate comparisons are proved
separately; a family of parameterized aggregate conclusions is not required
to construct the common root.
-/

@[expose] public section

noncomputable section

open GeneratedFoundations.Source
open GeneratedFoundations.Source.CanonicalRealization
open GeneratedFoundations.Correlation
open GeneratedFoundations.Spectral
open GeneratedFoundations.Arithmetic
open GeneratedFoundations.Arithmetic.GeneratedFoundation
open GeneratedFoundations.Arithmetic.ReducedExpression
open GeneratedFoundations.Arithmetic.CompleteHistory
open GeneratedFoundations.Arithmetic.CompleteNaturalObject
open GeneratedFoundations.Arithmetic.CompleteHistoryGeometry
open GeneratedFoundations.Arithmetic.CompleteHistoryTransport
open GeneratedFoundations.Arithmetic.CompleteHistoryDynamics
open GeneratedFoundations.Arithmetic.TypedSourceModes

namespace GeneratedFoundations.CommonFoundation

/-- The arithmetic and physical conclusions generated by the unique canonical
realization of minimal unbiased compositional change. This proposition has no
carrier, law, width, orientation, coupling or boundary argument. -/
structure Conclusions : Prop where
  source_closure :
    SourceClosure CanonicalRoot.generated.change CanonicalRoot.generated.minimal
      orientation CanonicalRoot.generated.law width width_pos
  spectral_arithmetic :
    SpectralArithmeticClosure CanonicalRoot.generated.change
      CanonicalRoot.generated.minimal orientation width width_pos
  factorization :
    letI : Fact (0 < windowLengthGenerated width) :=
      ⟨windowLengthGenerated_pos width_pos⟩
    (∀ x : Mode CanonicalRoot.generated.change CanonicalRoot.generated.minimal
          (windowLengthGenerated width) orientation,
        x ≠ 0 →
          ∃! f : Mode CanonicalRoot.generated.change CanonicalRoot.generated.minimal
              (windowLengthGenerated width) orientation →₀ ℕ,
            TypedArithmetic.IsPrimeProfile CanonicalRoot.generated.change
              CanonicalRoot.generated.minimal (windowLengthGenerated width)
              orientation x f) ∧
      Set.Infinite {p : Mode CanonicalRoot.generated.change
          CanonicalRoot.generated.minimal (windowLengthGenerated width) orientation |
        TypedArithmetic.CompositionIrreducible CanonicalRoot.generated.change
          CanonicalRoot.generated.minimal (windowLengthGenerated width)
          orientation p}
  expression_resolution :
    letI : Fact (0 < windowLengthGenerated width) :=
      ⟨windowLengthGenerated_pos width_pos⟩
    IsGeneratedResolution CanonicalRoot.generated.change
      CanonicalRoot.generated.minimal (windowLengthGenerated width) orientation
  complete_history_source : CompleteHistory.Conclusions
  complete_natural_object : CompleteNaturalObject.Conclusions
  complete_history_geometry : CompleteHistoryGeometry.Conclusions
  complete_history_transport : CompleteHistoryTransport.Conclusions
  complete_history_dynamics : CompleteHistoryDynamics.Conclusions
  joint_occupation_scale : JointOccupationScale.Conclusions
  canonical_mobius_readout : Analysis.CanonicalMobiusReadout.Conclusions
  canonical_endpoint_ledger : Analysis.CanonicalEndpointLedger.Conclusions
  prime_cylinder_descent : Analysis.PrimeCylinderDescent.Conclusions
  prime_cylinder_scale_budget :
    Analysis.PrimeCylinderScaleBudget.ScaleBudgetConclusions
  natural_cutoff_prime_descent : Analysis.NaturalCutoffPrimeDescent.Conclusions
  maximum_prime_generation : Analysis.MaximumPrimeFactorStage.StageConclusions
  maximum_prime_relative_ledger : Analysis.MaximumPrimeFactorRelativeStage.Conclusions
  gaussian_window_ledger : Analysis.GaussianWindowCapacity.Conclusions
  gaussian_prefix_tail : Analysis.GaussianPrefixTail.Conclusions
  natural_source_scale_budget : Analysis.NaturalSourceScaleBudget.Conclusions
  physical_interface : Physical.SourcePhysicalInterface.CoreConclusions

/-- Minimal unbiased compositional change generates the complete common world
without any realization argument. -/
theorem generated : Conclusions := by
  refine {
    source_closure := GeneratedFoundation.minimalChange_sourceClosure
      CanonicalRoot.generated.change CanonicalRoot.generated.minimal orientation
      CanonicalRoot.generated.compositional width_pos
    spectral_arithmetic := GeneratedFoundation.generatedWindow_spectralArithmetic
      CanonicalRoot.generated.change CanonicalRoot.generated.minimal orientation width_pos
    factorization := ?_
    expression_resolution := ?_
    complete_history_source := CompleteHistory.completeHistoryConclusions
    complete_natural_object := CompleteNaturalObject.completeNaturalObjectConclusions
    complete_history_geometry := CompleteHistoryGeometry.completeHistoryGeometryConclusions
    complete_history_transport := CompleteHistoryTransport.completeHistoryTransportConclusions
    complete_history_dynamics := CompleteHistoryDynamics.completeHistoryDynamicsConclusions
    joint_occupation_scale := JointOccupationScale.jointOccupationScaleConclusions
    canonical_mobius_readout :=
      Analysis.CanonicalMobiusReadout.canonicalMobiusReadoutConclusions
    canonical_endpoint_ledger := Analysis.CanonicalEndpointLedger.conclusions
    prime_cylinder_descent := Analysis.PrimeCylinderDescent.conclusions
    prime_cylinder_scale_budget := Analysis.PrimeCylinderScaleBudget.conclusions
    natural_cutoff_prime_descent := Analysis.NaturalCutoffPrimeDescent.conclusions
    maximum_prime_generation := Analysis.MaximumPrimeFactorStage.conclusions
    maximum_prime_relative_ledger := Analysis.MaximumPrimeFactorRelativeStage.conclusions
    gaussian_window_ledger := Analysis.GaussianWindowCapacity.conclusions
    gaussian_prefix_tail := Analysis.GaussianPrefixTail.conclusions
    natural_source_scale_budget := Analysis.NaturalSourceScaleBudget.conclusions
    physical_interface := Physical.SourcePhysicalInterface.generatedCore }
  · let : Fact (0 < windowLengthGenerated width) :=
      ⟨windowLengthGenerated_pos width_pos⟩
    exact ⟨fun x hx => TypedArithmetic.primeProfile_existsUnique
        CanonicalRoot.generated.change CanonicalRoot.generated.minimal
        (windowLengthGenerated width) orientation hx,
      TypedArithmetic.irreducibles_infinite CanonicalRoot.generated.change
        CanonicalRoot.generated.minimal (windowLengthGenerated width) orientation⟩
  · exact @generatedResolution CanonicalRoot.generated.change
      CanonicalRoot.generated.minimal (windowLengthGenerated width)
      ⟨windowLengthGenerated_pos width_pos⟩ orientation

end GeneratedFoundations.CommonFoundation
