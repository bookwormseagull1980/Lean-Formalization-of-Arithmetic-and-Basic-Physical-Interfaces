module

public import GeneratedFoundations.Physical.SourceTTCapacitySpectrum
public import GeneratedFoundations.Physical.SourceTTNativeEndpoint
public import Mathlib.Algebra.Polynomial.Eval.Defs

/-!
# Complete positive references of the original TT comparison channel

A reference must preserve positivity of every polynomial comparison on
the original eight-branch frequency domain. This condition contains no
numerical endpoint. The actual source range determines exactly which
references satisfy it, and its greatest reference characterizes one member
of the already implemented crossing-update family.

The results characterize that existing map by complete comparison
properties. They do not identify comparison evaluation with the original
Gaussian trace, or assert that physical source evolution must maximize
the reference. No new physical update or admissibility axiom is installed.
-/

@[expose] public section
noncomputable section

namespace GeneratedFoundations.Physical.SourceTTCompleteComparisonClosure

open SourceTTCapacitySpectrum (Frequency readout readout_bounds readout_range)
open SourceTTNativeEndpoint (crossingUpdate crossing_update_eq)

/-- Evaluation at a reference retains the order of every polynomial
observable generated by the actual comparison readout. -/
def PositiveReference (θ : ℝ) : Prop :=
  ∀ p : Polynomial ℝ, (∀ x : Frequency, 0 ≤ p.eval (readout x)) → 0 ≤ p.eval θ

theorem positiveReference_iff (θ : ℝ) :
    PositiveReference θ ↔ θ ∈ Set.Icc (0 : ℝ) (4 / 27) := by
  constructor
  · intro h
    have hlo := h Polynomial.X (fun x => by simpa using (readout_bounds x).1)
    have hhi := h (Polynomial.C (4 / 27) - Polynomial.X) (fun x => by
      simpa using sub_nonneg.mpr (readout_bounds x).2)
    constructor
    · simpa using hlo
    · simp only [Polynomial.eval_sub, Polynomial.eval_C, Polynomial.eval_X] at hhi
      linarith
  · intro h p hp
    have hm : θ ∈ Set.range readout := by rw [readout_range]; exact h
    obtain ⟨x, hx⟩ := hm
    rw [← hx]
    exact hp x

/-- Positivity of all generated comparisons is equivalent to evaluation
at an actual frequency readout; the source range was proved independently. -/
theorem positiveReference_iff_actual_readout (θ : ℝ) :
    PositiveReference θ ↔ ∃ x : Frequency, readout x = θ := by
  rw [positiveReference_iff, ← readout_range]
  rfl

/-- A radius whose collective readout admits a positive reference in the
original comparison algebra. This is a comparison class, not a declaration
that every such radius is reached by the physical source update. -/
def CompleteReferenceAt (A c : ℝ) : Prop :=
  0 < c ∧ PositiveReference (A / c)

theorem completeReferenceAt_iff_realizable (A c : ℝ) :
    CompleteReferenceAt A c ↔ SourceTTClosureBoundary.Realizable A c := by
  constructor
  · rintro ⟨hc, hr⟩
    have hb := (positiveReference_iff (A / c)).1 hr
    obtain ⟨y, hy, he⟩ := SourceTTClosureBoundary.exists_split_of_mem_range hb.1 hb.2
    exact ⟨hc, y, ⟨hy.1, by linarith [hy.2]⟩, he.symm⟩
  · rintro ⟨hc, y, hy, he⟩
    refine ⟨hc, (positiveReference_iff (A / c)).2 ?_⟩
    rw [he, SourceTTClosureBoundary.splitResponse_eq]
    exact ⟨mul_nonneg hy.1 (sq_nonneg _),
      SourceTensorResponseEndpoint.massWeightedResponse_le hy.1 hy.2⟩

/-- The old scalar-split realization class is therefore recovered from
the complete positive comparison algebra of the actual retained source. -/
theorem completeReferenceAt_iff {A : ℝ} (hA : 0 < A) (c : ℝ) :
    CompleteReferenceAt A c ↔ SourceTensorResponseEndpoint.endpointRoot A ≤ c := by
  rw [completeReferenceAt_iff_realizable, SourceTTClosureBoundary.realizable_iff hA]

theorem least_complete_reference {A : ℝ} (hA : 0 < A) :
    IsLeast {c : ℝ | CompleteReferenceAt A c}
      (SourceTensorResponseEndpoint.endpointRoot A) := by
  have he : {c : ℝ | CompleteReferenceAt A c} =
      Set.Ici (SourceTensorResponseEndpoint.endpointRoot A) := by
    ext c
    exact completeReferenceAt_iff hA c
  rw [he]
  exact isLeast_Ici

/-- No generated positive comparison permits a larger reference. This is
an extremal property, separate from positivity alone. -/
def SharpReference (θ : ℝ) : Prop :=
  PositiveReference θ ∧ ∀ η : ℝ, PositiveReference η → η ≤ θ

theorem sharpReference_iff (θ : ℝ) : SharpReference θ ↔ θ = (4 / 27 : ℝ) := by
  constructor
  · rintro ⟨hθ, hmax⟩
    have hu := ((positiveReference_iff θ).1 hθ).2
    have hl := hmax (4 / 27) ((positiveReference_iff _).2 (by norm_num))
    exact le_antisymm hu hl
  · rintro rfl
    exact ⟨(positiveReference_iff _).2 (by norm_num),
      fun η hη => ((positiveReference_iff η).1 hη).2⟩

/-- The reference is itself positively realizable and covers every
response in the original comparison domain. This states the two roles
of a complete capacity reference without naming an endpoint value. -/
def CoveringReference (θ : ℝ) : Prop :=
  PositiveReference θ ∧ ∀ x : Frequency, readout x ≤ θ

theorem coveringReference_iff_sharp (θ : ℝ) :
    CoveringReference θ ↔ SharpReference θ := by
  constructor
  · rintro ⟨hθ, hcover⟩
    refine ⟨hθ, ?_⟩
    intro η hη
    obtain ⟨x, hx⟩ := (positiveReference_iff_actual_readout η).1 hη
    rw [← hx]
    exact hcover x
  · rintro ⟨hθ, hmax⟩
    exact ⟨hθ, fun x => hmax (readout x)
      ((positiveReference_iff_actual_readout _).2 ⟨x, rfl⟩)⟩

theorem existsUnique_coveringReference : ∃! θ : ℝ, CoveringReference θ := by
  refine ⟨4 / 27, (coveringReference_iff_sharp _).2 ((sharpReference_iff _).2 rfl), ?_⟩
  intro θ hθ
  exact (sharpReference_iff θ).1 ((coveringReference_iff_sharp θ).1 hθ)

/-- For the existing update, membership in the complete reference class
is exactly the positivity condition on its supplied comparison level. -/
theorem existing_update_complete_iff {A θ c : ℝ}
    (hA : 0 < A) (hθ : 0 < θ) (hc : 0 < c) :
    CompleteReferenceAt A (crossingUpdate A θ c) ↔ PositiveReference θ := by
  rw [crossing_update_eq hA hθ hc]
  have hr : A / (A / θ) = θ := by field_simp
  simp only [CompleteReferenceAt, div_pos hA hθ, true_and, hr]

/-- Among the implemented level-crossing maps, the map landing on the
least complete reference is characterized uniquely by a sharp reference.
Neither side prescribes a physical evolution law. -/
theorem existing_update_boundary_iff_sharp {A θ c : ℝ}
    (hA : 0 < A) (hθ : 0 < θ) (hc : 0 < c) :
    IsLeast {r : ℝ | CompleteReferenceAt A r} (crossingUpdate A θ c) ↔
      SharpReference θ := by
  have hs : {r : ℝ | CompleteReferenceAt A r} =
      {r : ℝ | SourceTTClosureBoundary.Realizable A r} := by
    ext r
    exact completeReferenceAt_iff_realizable A r
  rw [hs, SourceTTNativeEndpoint.update_least_boundary_iff_level hA hθ hc,
    sharpReference_iff]

theorem implemented_update_complete_boundary {A c : ℝ} (hA : 0 < A) (hc : 0 < c) :
    IsLeast {r : ℝ | CompleteReferenceAt A r} (crossingUpdate A (4 / 27) c) :=
  (existing_update_boundary_iff_sharp hA (by norm_num) hc).2
    ((sharpReference_iff _).2 rfl)

/-- A characterization of the existing update by source comparison
properties. To assert that physical evolution must have this reference,
one must establish its covering role in that evolution. -/
theorem existing_update_boundary_iff_covering {A θ c : ℝ}
    (hA : 0 < A) (hθ : 0 < θ) (hc : 0 < c) :
    IsLeast {r : ℝ | CompleteReferenceAt A r} (crossingUpdate A θ c) ↔
      CoveringReference θ := by
  rw [existing_update_boundary_iff_sharp hA hθ hc, coveringReference_iff_sharp]

theorem covering_reference_update {A θ c : ℝ}
    (hA : 0 < A) (hc : 0 < c) (hθ : CoveringReference θ) :
    crossingUpdate A θ c = SourceTensorResponseEndpoint.endpointRoot A ∧
      A / crossingUpdate A θ c = (4 / 27 : ℝ) := by
  have he := (sharpReference_iff θ).1 ((coveringReference_iff_sharp θ).1 hθ)
  subst θ
  rw [crossing_update_eq hA (by norm_num) hc]
  constructor
  · unfold SourceTensorResponseEndpoint.endpointRoot
    ring
  · field_simp

theorem distinct_references_cannot_both_cover {θ η : ℝ}
    (hθ : CoveringReference θ) (hη : CoveringReference η) : θ = η :=
  existsUnique_coveringReference.unique hθ hη

/-- Positivity of the reference and coverage of the generated comparison
fix the closed radius, without inserting a numerical matching level. -/
theorem complete_comparison_endpoint_iff {A c : ℝ} (hA : 0 < A) :
    (0 < c ∧ CoveringReference (A / c)) ↔
      c = SourceTensorResponseEndpoint.endpointRoot A := by
  constructor
  · rintro ⟨hc, hcover⟩
    have hm := (sharpReference_iff (A / c)).1
      ((coveringReference_iff_sharp _).1 hcover)
    exact (SourceTensorResponseEndpoint.endpointResidual_eq_zero_iff hA hc).1
      (sub_eq_zero.mpr hm)
  · rintro rfl
    refine ⟨SourceTensorResponseEndpoint.endpointRoot_pos hA,
      (coveringReference_iff_sharp _).2 ((sharpReference_iff _).2 ?_)⟩
    exact sub_eq_zero.mp (SourceTensorResponseEndpoint.endpointResidual_root hA)

/-- Any operation satisfying the complete comparison characterization
agrees with the existing endpoint operation on positive inputs. This is
a uniqueness result for comparison closure, not for all source dynamics. -/
theorem complete_comparison_operation_unique {A : ℝ} (hA : 0 < A)
    {F G : ℝ → ℝ}
    (hF : ∀ c, 0 < c → 0 < F c ∧ CoveringReference (A / F c))
    (hG : ∀ c, 0 < c → 0 < G c ∧ CoveringReference (A / G c)) :
    ∀ c, 0 < c → F c = G c := by
  intro c hc
  exact ((complete_comparison_endpoint_iff hA).1 (hF c hc)).trans
    ((complete_comparison_endpoint_iff hA).1 (hG c hc)).symm

theorem existing_operation_characterized {A : ℝ} (hA : 0 < A)
    {F : ℝ → ℝ}
    (hF : ∀ c, 0 < c → 0 < F c ∧ CoveringReference (A / F c)) :
    ∀ c, 0 < c → F c = crossingUpdate A (4 / 27) c := by
  intro c hc
  have hroot := (complete_comparison_endpoint_iff hA).1 (hF c hc)
  exact hroot.trans (covering_reference_update hA hc
    ((coveringReference_iff_sharp _).2 ((sharpReference_iff _).2 rfl))).1.symm

end GeneratedFoundations.Physical.SourceTTCompleteComparisonClosure
