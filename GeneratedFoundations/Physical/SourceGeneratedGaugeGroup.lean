module

public import GeneratedFoundations.Physical.SourceGlobalGaugeGroup
public import GeneratedFoundations.Physical.SourceColourPhase
public import GeneratedFoundations.Physical.SourceScalarGaugeCovariance
public import Mathlib.Algebra.Group.Subgroup.Lattice

/-!
# The source-generated effective gauge group

The three factors used in the coordinate calculation are not introduced here
as an additional physical datum.  The colour factor is the determinant-one
part of unitary comparison on the generated three-dimensional colour carrier;
the weak factor is generated by the two source spin axes; and the phase circle
is exhausted by the unique vacuum lift.  This file records how those three
families generate the actual operator group on the sixteen-dimensional matter
carrier.

The intrinsic group is the range of the complete source action.  The familiar
product and its diagonal subgroup of order six are a presentation of this
operator group.  The final section descends the already classified scalar
doublet to the same effective group and records its colour, weak and phase
characters.
-/

@[expose] public section

noncomputable section

namespace GeneratedFoundations.Physical.SourceGeneratedGaugeGroup

open SourceChiralCarrier SourceScalarConnector ReversalRealConnector

abbrev ColourGroup := SourceColourPhase.ColourSpecialUnitary
abbrev WeakGroup := Operations.SourceSpinCornerGroup.SU2
abbrev PhaseGroup := Circle
abbrev Presentation := ColourGroup × WeakGroup × PhaseGroup

abbrev MatterUnits := (Module.End ℂ FullMatter)ˣ
abbrev SpinorUnits := (Module.End ℂ Spinor)ˣ

/-- Inclusion of determinant-one changes of the generated colour frame. -/
def colourInclusion : ColourGroup →* Presentation where
  toFun g := (g, 1, 1)
  map_one' := by simp
  map_mul' _ _ := by simp

/-- Inclusion of the group generated by the two source spin axes. -/
def weakInclusion : WeakGroup →* Presentation where
  toFun g := (1, g, 1)
  map_one' := by simp
  map_mul' _ _ := by simp

/-- Inclusion of the phase circle exhausted by the vacuum lift. -/
def phaseInclusion : PhaseGroup →* Presentation where
  toFun z := (1, 1, z)
  map_one' := by simp
  map_mul' _ _ := by simp

/-- The direct-product coordinates are recovered from the three source
families, and no additional coordinate remains. -/
theorem presentation_factorization (g : Presentation) :
    colourInclusion g.1 * weakInclusion g.2.1 * phaseInclusion g.2.2 = g := by
  rcases g with ⟨g3, g2, z⟩
  simp [colourInclusion, weakInclusion, phaseInclusion]

/-- The three factor coordinates in the displayed factorization are unique. -/
theorem presentation_factorization_unique (g3 : ColourGroup) (g2 : WeakGroup)
    (z : PhaseGroup) (g : Presentation)
    (h : colourInclusion g3 * weakInclusion g2 * phaseInclusion z = g) :
    g3 = g.1 ∧ g2 = g.2.1 ∧ z = g.2.2 := by
  simpa [colourInclusion, weakInclusion, phaseInclusion, Prod.ext_iff] using h

/-- The complete action of a pure colour-frame change. -/
def colourOperators : ColourGroup →* MatterUnits :=
  SourceGlobalGaugeGroup.unitRepresentation.comp colourInclusion

/-- The complete action of a pure source-spin change. -/
def weakOperators : WeakGroup →* MatterUnits :=
  SourceGlobalGaugeGroup.unitRepresentation.comp weakInclusion

/-- The complete action of a pure lifted phase change. -/
def phaseOperators : PhaseGroup →* MatterUnits :=
  SourceGlobalGaugeGroup.unitRepresentation.comp phaseInclusion

/-- The intrinsic gauge group is the group of invertible matter operators
actually produced by the complete source action. -/
abbrev GeneratedGaugeGroup := SourceGlobalGaugeGroup.unitRepresentation.range

/-- Subgroup generated by the three source families, before using the kernel
calculation. -/
def sourceFactorClosure : Subgroup MatterUnits :=
  Subgroup.closure
    (Set.range colourOperators ∪ Set.range weakOperators ∪ Set.range phaseOperators)

theorem colourOperators_mem_generated (g : ColourGroup) :
    colourOperators g ∈ GeneratedGaugeGroup := ⟨colourInclusion g, rfl⟩

theorem weakOperators_mem_generated (g : WeakGroup) :
    weakOperators g ∈ GeneratedGaugeGroup := ⟨weakInclusion g, rfl⟩

theorem phaseOperators_mem_generated (z : PhaseGroup) :
    phaseOperators z ∈ GeneratedGaugeGroup := ⟨phaseInclusion z, rfl⟩

/-- The actual operator group is exactly, and minimally, generated by colour
frame changes, source-spin changes and the lifted phase circle. -/
theorem sourceFactorClosure_eq_generated :
    sourceFactorClosure = GeneratedGaugeGroup := by
  apply le_antisymm
  · apply (Subgroup.closure_le GeneratedGaugeGroup).2
    intro U hU
    rcases hU with (hU | hU) | hU
    · rcases hU with ⟨g, rfl⟩
      exact colourOperators_mem_generated g
    · rcases hU with ⟨g, rfl⟩
      exact weakOperators_mem_generated g
    · rcases hU with ⟨z, rfl⟩
      exact phaseOperators_mem_generated z
  · intro U hU
    rcases hU with ⟨g, rfl⟩
    have hc : colourOperators g.1 ∈ sourceFactorClosure :=
      Subgroup.subset_closure (Or.inl (Or.inl ⟨g.1, rfl⟩))
    have hw : weakOperators g.2.1 ∈ sourceFactorClosure :=
      Subgroup.subset_closure (Or.inl (Or.inr ⟨g.2.1, rfl⟩))
    have hp : phaseOperators g.2.2 ∈ sourceFactorClosure :=
      Subgroup.subset_closure (Or.inr ⟨g.2.2, rfl⟩)
    have hm := Subgroup.mul_mem sourceFactorClosure
      (Subgroup.mul_mem sourceFactorClosure hc hw) hp
    change SourceGlobalGaugeGroup.unitRepresentation g ∈ sourceFactorClosure
    simpa only [colourOperators, weakOperators, phaseOperators, MonoidHom.comp_apply,
      ← map_mul, presentation_factorization] using hm

/-- Least-subgroup formulation of source generation. -/
theorem generatedGaugeGroup_least (K : Subgroup MatterUnits)
    (hColour : ∀ g, colourOperators g ∈ K)
    (hWeak : ∀ g, weakOperators g ∈ K)
    (hPhase : ∀ z, phaseOperators z ∈ K) :
    GeneratedGaugeGroup ≤ K := by
  rw [← sourceFactorClosure_eq_generated]
  apply (Subgroup.closure_le K).2
  intro U hU
  rcases hU with (hU | hU) | hU
  · rcases hU with ⟨g, rfl⟩
    exact hColour g
  · rcases hU with ⟨g, rfl⟩
    exact hWeak g
  · rcases hU with ⟨z, rfl⟩
    exact hPhase z

/-- The intrinsic operator group and the quotient of the source presentation
by its computed order-six kernel are the same group. -/
def generatedGaugeGroupEquivEffective :
    GeneratedGaugeGroup ≃* SourceGlobalGaugeGroup.EffectiveGroup :=
  SourceGlobalGaugeGroup.effectiveGroupEquivRange.symm

/-! ## The scalar doublet on the intrinsic effective group -/

def scalarLinearAction (g : Presentation) : Module.End ℂ Spinor where
  toFun := SourceScalarGaugeCovariance.scalarAction g
  map_add' x y := by
    simp [SourceScalarGaugeCovariance.scalarAction, Matrix.mulVec_add]
  map_smul' a x := by
    simp [SourceScalarGaugeCovariance.scalarAction, Matrix.mulVec_smul, smul_smul, mul_comm]

@[simp] theorem scalarLinearAction_apply (g : Presentation) (H : Spinor) :
    scalarLinearAction g H = SourceScalarGaugeCovariance.scalarAction g H := rfl

def scalarUnitAction (g : Presentation) : SpinorUnits where
  val := scalarLinearAction g
  inv := scalarLinearAction g⁻¹
  val_inv := by
    apply LinearMap.ext
    intro H
    change SourceScalarGaugeCovariance.scalarAction g
        (SourceScalarGaugeCovariance.scalarAction g⁻¹ H) = H
    rw [← SourceScalarGaugeCovariance.scalarAction_mul]
    simp [SourceScalarGaugeCovariance.scalarAction_one]
  inv_val := by
    apply LinearMap.ext
    intro H
    change SourceScalarGaugeCovariance.scalarAction g⁻¹
        (SourceScalarGaugeCovariance.scalarAction g H) = H
    rw [← SourceScalarGaugeCovariance.scalarAction_mul]
    simp [SourceScalarGaugeCovariance.scalarAction_one]

def scalarUnitRepresentation : Presentation →* SpinorUnits where
  toFun := scalarUnitAction
  map_one' := by
    apply Units.ext
    apply LinearMap.ext
    intro H
    exact SourceScalarGaugeCovariance.scalarAction_one H
  map_mul' g k := by
    apply Units.ext
    apply LinearMap.ext
    intro H
    exact SourceScalarGaugeCovariance.scalarAction_mul g k H

theorem centralSix_le_scalarKernel :
    SourceGlobalGaugeGroup.centralSix ≤ scalarUnitRepresentation.ker := by
  intro g hg
  have hs_mem : g ∈ SourceGaugeTransport.representation.ker := by
    rw [SourceGaugeTransport.kernel_eq_zpowers]
    simpa [SourceGlobalGaugeGroup.centralSix] using hg
  have hs : SourceGaugeTransport.representation g = 1 :=
    MonoidHom.mem_ker.mp hs_mem
  have hc : GlobalGaugeKernel.representation g = 1 :=
    (SourceGaugeTransport.representation_eq_one_iff g).mp hs
  obtain ⟨z, hz⟩ := (GlobalGaugeKernel.kernel_iff_exists_centralEmbedding g).mp hc
  apply Units.ext
  apply LinearMap.ext
  intro H
  change SourceScalarGaugeCovariance.scalarAction g H = H
  rw [← hz]
  simpa using SourceScalarGaugeCovariance.scalarAction_central_relift z 1 H

/-- The scalar action is an action of the effective group itself, not merely
of a chosen product-group lift. -/
def effectiveScalarRepresentation :
    SourceGlobalGaugeGroup.EffectiveGroup →* SpinorUnits :=
  QuotientGroup.lift SourceGlobalGaugeGroup.centralSix scalarUnitRepresentation
    centralSix_le_scalarKernel

@[simp] theorem effectiveScalarRepresentation_mk (g : Presentation) :
    effectiveScalarRepresentation (QuotientGroup.mk' SourceGlobalGaugeGroup.centralSix g) =
      scalarUnitRepresentation g := by
  simp [effectiveScalarRepresentation]

/-- Transfer of the scalar action to the intrinsic operator-group definition. -/
def generatedScalarRepresentation : GeneratedGaugeGroup →* SpinorUnits :=
  effectiveScalarRepresentation.comp generatedGaugeGroupEquivEffective.toMonoidHom

/-- The generated scalar is a colour singlet. -/
theorem scalar_colour_trivial (g3 : ColourGroup) (H : Spinor) :
    SourceScalarGaugeCovariance.scalarAction (colourInclusion g3) H = H := by
  simp [SourceScalarGaugeCovariance.scalarAction, colourInclusion]

/-- On the weak source group the scalar is the defining doublet. -/
theorem scalar_weak_defining (g2 : WeakGroup) (H : Spinor) :
    SourceScalarGaugeCovariance.scalarAction (weakInclusion g2) H =
      (g2 : Operations.SourceSpinCorner.Mat2).mulVec H := by
  simp [SourceScalarGaugeCovariance.scalarAction, weakInclusion]

/-- Along the unique vacuum lift the primitive phase character is one half. -/
theorem scalar_phase_half (t : ℝ) (H : Spinor) :
    SourceScalarGaugeCovariance.scalarAction
        (phaseInclusion (SourcePhaseLift.phase t)) H =
      Complex.exp (((t : ℂ) * Complex.I) / 2) • H := by
  simpa [phaseInclusion] using SourceScalarGaugeCovariance.scalarAction_phase t H

/-- The source constructions used to identify the three presentation factors. -/
structure FactorOriginConclusions where
  colour_frame_split : ∀ (g : SourceJointResponse.W ≃ₗᵢ[ℂ] SourceJointResponse.W),
    ∃ (z : Circle) (U : ColourGroup),
      SourceLocalizedFrames.colourFrameMatrix g =
          (z : ℂ) • (U : SourceColourPhase.ColourMatrix) ∧
        (z : ℂ) ^ 3 = (SourceLocalizedFrames.colourFrameMatrix g).det
  weak_axes_generate : Subgroup.closure
      (Set.range Operations.SourceSpinCornerGroup.zElement ∪
        Set.range Operations.SourceSpinCornerGroup.yElement) = ⊤
  phase_exhausted : Function.Surjective SourcePhaseLift.phase
  presentation_complete : ∀ g : Presentation,
    colourInclusion g.1 * weakInclusion g.2.1 * phaseInclusion g.2.2 = g
  operator_group_generated : sourceFactorClosure = GeneratedGaugeGroup
  operator_group_least : ∀ (K : Subgroup MatterUnits),
    (∀ g, colourOperators g ∈ K) → (∀ g, weakOperators g ∈ K) →
      (∀ z, phaseOperators z ∈ K) → GeneratedGaugeGroup ≤ K
  central_kernel : SourceGlobalGaugeGroup.unitRepresentation.ker =
    SourceGlobalGaugeGroup.centralSix
  central_kernel_card : Nat.card SourceGlobalGaugeGroup.centralSix = 6
  effective_identification :
    GeneratedGaugeGroup ≃* SourceGlobalGaugeGroup.EffectiveGroup
  scalar_effective :
    SourceGlobalGaugeGroup.EffectiveGroup →* SpinorUnits
  scalar_colour : ∀ g H,
    SourceScalarGaugeCovariance.scalarAction (colourInclusion g) H = H
  scalar_weak : ∀ g H,
    SourceScalarGaugeCovariance.scalarAction (weakInclusion g) H =
      (g : Operations.SourceSpinCorner.Mat2).mulVec H
  scalar_phase : ∀ t H,
    SourceScalarGaugeCovariance.scalarAction
        (phaseInclusion (SourcePhaseLift.phase t)) H =
      Complex.exp (((t : ℂ) * Complex.I) / 2) • H

def sourceGeneratedGaugeGroup : FactorOriginConclusions where
  colour_frame_split := SourceColourPhase.colourFrame_exists_phase_specialUnitary
  weak_axes_generate := Operations.SourceSpinCornerGroup.generated_subgroup_eq_top
  phase_exhausted := SourcePhaseLift.phase_surjective
  presentation_complete := presentation_factorization
  operator_group_generated := sourceFactorClosure_eq_generated
  operator_group_least := generatedGaugeGroup_least
  central_kernel := SourceGlobalGaugeGroup.unitRepresentation_kernel
  central_kernel_card := SourceGlobalGaugeGroup.centralSix_card
  effective_identification := generatedGaugeGroupEquivEffective
  scalar_effective := effectiveScalarRepresentation
  scalar_colour := scalar_colour_trivial
  scalar_weak := scalar_weak_defining
  scalar_phase := scalar_phase_half

/-- Propositional certificate used by the common root theorem.  The concrete
equivalence and representations remain the definitions above; this record
certifies their generated origin without placing data inside a `Prop`-valued
root conclusion. -/
structure FactorOriginProperties : Prop where
  colour_frame_split : ∀ (g : SourceJointResponse.W ≃ₗᵢ[ℂ] SourceJointResponse.W),
    ∃ (z : Circle) (U : ColourGroup),
      SourceLocalizedFrames.colourFrameMatrix g =
          (z : ℂ) • (U : SourceColourPhase.ColourMatrix) ∧
        (z : ℂ) ^ 3 = (SourceLocalizedFrames.colourFrameMatrix g).det
  weak_axes_generate : Subgroup.closure
      (Set.range Operations.SourceSpinCornerGroup.zElement ∪
        Set.range Operations.SourceSpinCornerGroup.yElement) = ⊤
  phase_exhausted : Function.Surjective SourcePhaseLift.phase
  operator_group_generated : sourceFactorClosure = GeneratedGaugeGroup
  operator_group_least : ∀ (K : Subgroup MatterUnits),
    (∀ g, colourOperators g ∈ K) → (∀ g, weakOperators g ∈ K) →
      (∀ z, phaseOperators z ∈ K) → GeneratedGaugeGroup ≤ K
  central_kernel : SourceGlobalGaugeGroup.unitRepresentation.ker =
    SourceGlobalGaugeGroup.centralSix
  central_kernel_card : Nat.card SourceGlobalGaugeGroup.centralSix = 6
  effective_identification : Nonempty
    (GeneratedGaugeGroup ≃* SourceGlobalGaugeGroup.EffectiveGroup)
  scalar_descends : SourceGlobalGaugeGroup.centralSix ≤ scalarUnitRepresentation.ker
  scalar_colour : ∀ g H,
    SourceScalarGaugeCovariance.scalarAction (colourInclusion g) H = H
  scalar_weak : ∀ g H,
    SourceScalarGaugeCovariance.scalarAction (weakInclusion g) H =
      (g : Operations.SourceSpinCorner.Mat2).mulVec H
  scalar_phase : ∀ t H,
    SourceScalarGaugeCovariance.scalarAction
        (phaseInclusion (SourcePhaseLift.phase t)) H =
      Complex.exp (((t : ℂ) * Complex.I) / 2) • H

theorem sourceGeneratedGaugeGroupProperties : FactorOriginProperties where
  colour_frame_split := SourceColourPhase.colourFrame_exists_phase_specialUnitary
  weak_axes_generate := Operations.SourceSpinCornerGroup.generated_subgroup_eq_top
  phase_exhausted := SourcePhaseLift.phase_surjective
  operator_group_generated := sourceFactorClosure_eq_generated
  operator_group_least := generatedGaugeGroup_least
  central_kernel := SourceGlobalGaugeGroup.unitRepresentation_kernel
  central_kernel_card := SourceGlobalGaugeGroup.centralSix_card
  effective_identification := ⟨generatedGaugeGroupEquivEffective⟩
  scalar_descends := centralSix_le_scalarKernel
  scalar_colour := scalar_colour_trivial
  scalar_weak := scalar_weak_defining
  scalar_phase := scalar_phase_half

end GeneratedFoundations.Physical.SourceGeneratedGaugeGroup
