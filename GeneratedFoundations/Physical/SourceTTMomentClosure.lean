module

public import GeneratedFoundations.Physical.SourceTTComparisonMeasure
public import GeneratedFoundations.Physical.SourceTTCompleteComparisonClosure

/-!
# The existing TT closure characterized by complete source comparisons

The reference is tested against the original eight-branch frequency
trace. Its moments are the normalized mixed connected responses already
calculated from the same precision source. A complete reference is both
positively realizable and sufficient for every comparison order. These
conditions contain no matching value and uniquely characterize the
existing level-crossing operation.

The response order is not a physical time. The characterization concerns
the generated capacity comparison algebra; the original directional
source retains the additional information described by its joint mass
response hierarchy.
-/

@[expose] public section
noncomputable section
open MeasureTheory

namespace GeneratedFoundations.Physical.SourceTTMomentClosure

open SourceTTComparisonMeasure
open SourceTTComparisonTransport (traceMoment)
open SourceTTCompleteComparisonClosure

/-- The moments retain the complete original frequency and colour
weights. For positive orders these are the mixed connected precision
responses with their universal Gaussian factorial removed. -/
def sourceMoment (n : ℕ) : ℝ := traceMoment n 0 0

theorem sourceMoment_eq_integral (n : ℕ) :
    sourceMoment n = ∫ x, response x ^ n ∂sourceMeasure :=
  (source_moment n).symm

theorem sourceMoment_eq_normalized_connected (n : ℕ) (hn : 1 ≤ n) :
    sourceMoment n = SourceTTComparisonTransport.normalizedConnectedTrace n 0 :=
  (SourceTTComparisonTransport.normalizedConnectedTrace_eq n hn 0).symm

theorem sourceMoment_connected_identity (n : ℕ) (hn : 1 ≤ n) :
    SourceTTComparisonTransport.connectedTrace n 0 =
      ((-1 : ℝ) ^ (3 * n) * ((3 * n - 1).factorial : ℝ) / 2) * sourceMoment n :=
  SourceTTComparisonTransport.connectedTrace_eq n hn 0

/-- All successive response orders determine the least common capacity
bound from the original source, without a numerical endpoint premise. -/
theorem source_successor_tests_iff (θ : ℝ) :
    (∀ n : ℕ, sourceMoment (n + 1) ≤ θ * sourceMoment n) ↔
      (4 / 27 : ℝ) ≤ θ := by
  simpa only [sourceMoment, source_moment] using
    (Operations.PositiveMomentCompletion.moment_successor_bound_iff
      (μ := sourceMeasure) (r := θ) response_continuous.measurable
      response_bounds (by norm_num) peak_mass)

/-- Equivalent positivity tests in the actual weighted trace. -/
theorem source_integral_tests_iff (θ : ℝ) :
    (∀ n : ℕ, 0 ≤ ∫ x, response x ^ n * (θ - response x) ∂sourceMeasure) ↔
      (4 / 27 : ℝ) ≤ θ :=
  Operations.PositiveMomentCompletion.positive_tests_iff
    response_continuous.measurable response_bounds (by norm_num) peak_mass

/-- Positivity of the full polynomial localizing form is an observable
test of coverage in the same source trace. -/
def LocalizingPositive (θ : ℝ) : Prop :=
  ∀ p : Polynomial ℝ,
    0 ≤ ∫ x, (θ - response x) * (p.eval (response x)) ^ 2 ∂sourceMeasure

theorem localizingPositive_iff (θ : ℝ) :
    LocalizingPositive θ ↔ (4 / 27 : ℝ) ≤ θ :=
  Operations.PositiveMomentCompletion.polynomial_tests_iff
    response_continuous.measurable response_bounds (by norm_num) peak_mass

/-- A reference is generated by the same comparison algebra and covers
all its actual connected response orders. No endpoint value occurs in
this definition. -/
def CompleteMomentReference (θ : ℝ) : Prop :=
  PositiveReference θ ∧ ∀ n : ℕ, sourceMoment (n + 1) ≤ θ * sourceMoment n

theorem completeMomentReference_iff (θ : ℝ) :
    CompleteMomentReference θ ↔ θ = (4 / 27 : ℝ) := by
  constructor
  · rintro ⟨hpos, hbound⟩
    exact le_antisymm ((positiveReference_iff θ).1 hpos).2
      ((source_successor_tests_iff θ).1 hbound)
  · rintro rfl
    exact ⟨(positiveReference_iff _).2 (by norm_num),
      (source_successor_tests_iff _).2 le_rfl⟩

theorem completeMomentReference_iff_covering (θ : ℝ) :
    CompleteMomentReference θ ↔ CoveringReference θ := by
  rw [completeMomentReference_iff, coveringReference_iff_sharp, sharpReference_iff]

/-- The full localizing quadratic form and the actual mixed connected
response hierarchy provide the same complete comparison criterion. -/
theorem completeMomentReference_iff_localizing (θ : ℝ) :
    CompleteMomentReference θ ↔ PositiveReference θ ∧ LocalizingPositive θ := by
  simp only [CompleteMomentReference, source_successor_tests_iff, localizingPositive_iff]

theorem existsUnique_completeMomentReference :
    ∃! θ : ℝ, CompleteMomentReference θ := by
  refine ⟨4 / 27, (completeMomentReference_iff _).2 rfl, ?_⟩
  intro θ hθ
  exact (completeMomentReference_iff θ).1 hθ

/-- Complete source response tests characterize the closed radius. The
numerical matching equation is a conclusion of the criterion. -/
theorem source_comparison_closure_iff {A c : ℝ} (hA : 0 < A) :
    (0 < c ∧ CompleteMomentReference (A / c)) ↔
      c = SourceTensorResponseEndpoint.endpointRoot A := by
  rw [completeMomentReference_iff_covering, complete_comparison_endpoint_iff hA]

/-- An exact test of the already implemented level-crossing family by
complete same-source responses. -/
theorem existing_update_boundary_iff_complete_responses {A θ c : ℝ}
    (hA : 0 < A) (hθ : 0 < θ) (hc : 0 < c) :
    IsLeast {r : ℝ | CompleteReferenceAt A r}
        (SourceTTNativeEndpoint.crossingUpdate A θ c) ↔
      CompleteMomentReference θ := by
  rw [existing_update_boundary_iff_covering hA hθ hc,
    completeMomentReference_iff_covering]

/-- The existing operation satisfies the complete criterion at every
positive input radius. Its reference does not change the source trace. -/
theorem implemented_operation_complete {A c : ℝ} (hA : 0 < A) (hc : 0 < c) :
    0 < SourceTTNativeEndpoint.crossingUpdate A (4 / 27) c ∧
      CompleteMomentReference (A / SourceTTNativeEndpoint.crossingUpdate A (4 / 27) c) := by
  apply (source_comparison_closure_iff hA).2
  exact (covering_reference_update hA hc
    ((coveringReference_iff_sharp _).2 ((sharpReference_iff _).2 rfl))).1

/-- Uniqueness among operations satisfying the complete comparison
criterion, including operations not initially written in crossing form. -/
theorem operation_unique_from_complete_responses {A : ℝ} (hA : 0 < A)
    {F : ℝ → ℝ}
    (hF : ∀ c, 0 < c → 0 < F c ∧ CompleteMomentReference (A / F c)) :
    ∀ c, 0 < c → F c = SourceTTNativeEndpoint.crossingUpdate A (4 / 27) c := by
  apply existing_operation_characterized hA
  intro c hc
  exact ⟨(hF c hc).1,
    (completeMomentReference_iff_covering _).1 (hF c hc).2⟩

end GeneratedFoundations.Physical.SourceTTMomentClosure
