module

public import GeneratedFoundations.Physical.SourceGeneratedYangMillsPhysicalHessian
public import GeneratedFoundations.Physical.SourceGeneratedYangMillsResponseHessian
public import Mathlib.Data.Finsupp.Order
public import Mathlib.Tactic.Linarith

/-!
# Local source variation and the complete modal quadratic form

The finite core used here is not a shell table with one coordinate per
eigenvalue.  Its labels are the complete physical response labels: the radial
direction and every generated coclosed branch, polarization and colour
direction.  Its coefficients are the source Casimirs plus the Gaussian
response shift.  Separately, differentiation of the complete local source
action gives its radial coefficient and its zero mixed derivative.

The finite-support form therefore determines the already constructed unique
self-adjoint multiplier on the Hilbert completion. No cutoff or omitted
multiplicity enters that lower bound. The coefficient identity below is
complemented by the original-field construction in
`SourceHaarYangMillsHessian`: the complete differentiated one-form basis,
nonlinear Haar action and its second variation determine the unique
self-adjoint response on the actual weak-divergence kernel.
-/

@[expose] public section

noncomputable section

open GeneratedFoundations.Physical.SourceGeneratedYangMillsGap
open GeneratedFoundations.Physical.SourceGeneratedCoclosedOneForm
  (CoclosedModeIndex modeEigenvalue branchCasimir
    modeEigenvalue_eq_sourceCasimir_add_shift)
open GeneratedFoundations.Physical.SourceRadialMassIntertwiner (scoreVariance)
open GeneratedFoundations.Physical.SourceGeneratedYangMillsPhysicalHessian
open GeneratedFoundations.Physical.SourceGeneratedYangMillsResponseHessian

namespace GeneratedFoundations.Physical.SourceGeneratedYangMillsFullReduction

/-- Algebraic finite core of the complete physical response space. -/
abbrev FiniteResponseCore := PhysicalMode →₀ ℝ

/-- Squared coefficient norm on the complete finite core. -/
def normSq (x : FiniteResponseCore) : ℝ :=
  x.sum fun _ coefficient => coefficient ^ 2

/-- Modal quadratic form with the generated response coefficients. -/
def hessianQuadratic (L z : ℝ) (x : FiniteResponseCore) : ℝ :=
  x.sum fun mode coefficient =>
    physicalEigenvalue L z mode * coefficient ^ 2

/-- The source Hodge/Casimir contribution to one physical mode. The radial
response is a scalar restoring direction and therefore has no one-form Hodge
term; every coclosed mode carries its generated branch Casimir. -/
def sourceHodgeEigenvalue (L : ℝ) : PhysicalMode → ℝ
  | .radial => 0
  | .coclosed mode => branchCasimir mode / L ^ 2

/-- The response contribution generated by the same Gaussian source. -/
def sourceResponseEigenvalue (L z : ℝ) : PhysicalMode → ℝ
  | .radial => scoreVariance z * SourceConformalResponse.completeCurvature z
  | .coclosed _ => coclosedResponseShift L z

/-- Each coefficient of the complete Hessian is exactly the sum of its source
Hodge/Casimir part and its generated Gaussian response part. -/
theorem physicalEigenvalue_eq_source_decomposition (L z : ℝ)
    (mode : PhysicalMode) :
    physicalEigenvalue L z mode =
      sourceHodgeEigenvalue L mode + sourceResponseEigenvalue L z mode := by
  cases mode with
  | radial =>
      simp only [physicalEigenvalue, sourceHodgeEigenvalue,
        sourceResponseEigenvalue, zero_add]
      exact normalizedRadialMassSq_eq_scoreVariance_mul_completeCurvature z
  | coclosed mode =>
      rw [physicalEigenvalue, modeEigenvalue_eq_sourceCasimir_add_shift]
      rfl

/-- The finite-core quadratic form written directly from the two generated
source contributions, before any lower estimate is taken. -/
def sourceDecomposedQuadratic (L z : ℝ) (x : FiniteResponseCore) : ℝ :=
  x.sum fun mode coefficient =>
    (sourceHodgeEigenvalue L mode + sourceResponseEigenvalue L z mode) *
      coefficient ^ 2

/-- Exact coefficient decomposition on the full mode core. This identity
retains every branch, polarization and colour coordinate. -/
theorem hessianQuadratic_eq_sourceDecomposedQuadratic (L z : ℝ)
    (x : FiniteResponseCore) :
    hessianQuadratic L z x = sourceDecomposedQuadratic L z x := by
  classical
  apply Finsupp.sum_congr
  intro mode _
  rw [physicalEigenvalue_eq_source_decomposition]

/-- The corresponding quadratic action. -/
def quadraticAction (L z : ℝ) (x : FiniteResponseCore) : ℝ :=
  (1 / 2 : ℝ) * hessianQuadratic L z x

/-- Polarized Hessian on the complete finite core. -/
def hessianPairing (L z : ℝ) (x y : FiniteResponseCore) : ℝ :=
  x.sum fun mode coefficient =>
    physicalEigenvalue L z mode * coefficient * y mode

/-- Pure radial finite-core response. -/
def radialCore (coefficient : ℝ) : FiniteResponseCore :=
  Finsupp.single .radial coefficient

/-- Pure generated coclosed response in one complete mode. -/
def coclosedCore (mode : CoclosedModeIndex) (coefficient : ℝ) :
    FiniteResponseCore :=
  Finsupp.single (.coclosed mode) coefficient

@[simp] theorem normSq_zero : normSq (0 : FiniteResponseCore) = 0 := by
  simp [normSq]

@[simp] theorem hessianQuadratic_zero (L z : ℝ) :
    hessianQuadratic L z (0 : FiniteResponseCore) = 0 := by
  simp [hessianQuadratic]

@[simp] theorem hessianPairing_self (L z : ℝ) (x : FiniteResponseCore) :
    hessianPairing L z x x = hessianQuadratic L z x := by
  simp only [hessianPairing, hessianQuadratic, Finsupp.sum, pow_two, mul_assoc]

@[simp] theorem hessianQuadratic_radial (L z coefficient : ℝ) :
    hessianQuadratic L z (radialCore coefficient) =
      normalizedRadialMassSq z * coefficient ^ 2 := by
  classical
  simp [hessianQuadratic, radialCore, physicalEigenvalue]

@[simp] theorem hessianQuadratic_coclosed (L z : ℝ)
    (mode : CoclosedModeIndex) (coefficient : ℝ) :
    hessianQuadratic L z (coclosedCore mode coefficient) =
      modeEigenvalue L z mode * coefficient ^ 2 := by
  classical
  simp [hessianQuadratic, coclosedCore, physicalEigenvalue]

/-- The radial and every coclosed coordinate are exactly orthogonal in the
complete finite-core Hessian. -/
@[simp] theorem hessianPairing_radial_coclosed_zero (L z r c : ℝ)
    (mode : CoclosedModeIndex) :
    hessianPairing L z (radialCore r) (coclosedCore mode c) = 0 := by
  classical
  simp [hessianPairing, radialCore, coclosedCore]

@[simp] theorem hessianPairing_coclosed_radial_zero (L z r c : ℝ)
    (mode : CoclosedModeIndex) :
    hessianPairing L z (coclosedCore mode c) (radialCore r) = 0 := by
  classical
  simp [hessianPairing, radialCore, coclosedCore]

/-- The local common-action calculation and the complete modal reduction have
the same zero radial--connection mixed block. -/
theorem mixed_block_is_generated (L z radial : ℝ)
    (A : SourceFourDimensionalYangMills.MatrixConnectionJet)
    (mode : CoclosedModeIndex) (coefficient : ℝ) :
    commonHessianPairing L z radial 0 zeroMatrixConnectionJet A = 0 ∧
      hessianPairing L z (radialCore radial)
        (coclosedCore mode coefficient) = 0 := by
  exact ⟨commonHessianPairing_radial_connection_zero L z radial A,
    hessianPairing_radial_coclosed_zero L z radial coefficient mode⟩

/-- Every summand of the complete core form is nonnegative on the condensed
response branch. -/
theorem hessianQuadratic_nonneg {L z : ℝ} (hL : 0 < L) (hz : 0 < z)
    (x : FiniteResponseCore) : 0 ≤ hessianQuadratic L z x := by
  unfold hessianQuadratic
  exact Finsupp.sum_nonneg' fun mode =>
    mul_nonneg (physicalEigenvalue_pos hL hz mode).le (sq_nonneg _)

/-- Cutoff-free coercivity on the complete finite support core. -/
theorem gap_mul_normSq_le_hessianQuadratic (L z : ℝ)
    (x : FiniteResponseCore) :
    generatedYangMillsGapSq L z * normSq x ≤
      hessianQuadratic L z x := by
  classical
  unfold normSq hessianQuadratic
  rw [Finsupp.mul_sum]
  apply Finsupp.sum_le_sum
  intro mode _
  exact mul_le_mul_of_nonneg_right
    (gap_le_physicalEigenvalue L z mode) (sq_nonneg (x mode))

/-- The exact lower edge is attained on the finite core. -/
theorem hessianQuadratic_minimizer (L z : ℝ) :
    hessianQuadratic L z
        (Finsupp.single (minimizingMode L z) 1) =
      generatedYangMillsGapSq L z := by
  classical
  simp [hessianQuadratic, physicalEigenvalue_minimizingMode]

/-- The complete finite-core eigenvalue list is exactly the list defining the
unique self-adjoint response Hessian on the Hilbert completion. -/
theorem finite_core_closes_to_operator (L z : ℝ) :
    IsSelfAdjoint (operator L z) ∧
      (∀ mode,
        operator L z
            ⟨physicalBasis mode, basis_mem_domain L z mode⟩ =
          (physicalEigenvalue L z mode : ℂ) • physicalBasis mode) ∧
      (∀ mode,
        generatedYangMillsGapSq L z ≤ physicalEigenvalue L z mode) := by
  exact ⟨operator_selfAdjoint L z, operator_basis L z,
    gap_le_physicalEigenvalue L z⟩

/-- Local variational results and full modal closure. The fields keep these
two statements distinct until a differential realization intertwining them
has been constructed. -/
structure Conclusions : Prop where
  local_mixed_zero : ∀ L z radial A,
    commonHessianPairing L z radial 0 zeroMatrixConnectionJet A = 0
  modal_mixed_zero : ∀ L z r c mode,
    hessianPairing L z (radialCore r) (coclosedCore mode c) = 0
  coclosed_from_source : ∀ L z mode,
    modeEigenvalue L z mode = branchCasimir mode / L ^ 2 +
      coclosedResponseShift L z
  radial_from_source : ∀ z,
    normalizedRadialMassSq z =
      scoreVariance z * SourceConformalResponse.completeCurvature z
  radial_restoring_derivative : ∀ {z : ℝ}, 0 < z →
    HasDerivAt (SourceGeneratedRadialVariation.sourceRadialForce z)
      (normalizedRadialMassSq z) 0
  radial_potential_second_derivative : ∀ {z : ℝ}, 0 < z →
    HasDerivAt (fun r : ℝ => deriv
      (SourceGeneratedRadialVariation.sourceRadialPotential z) r)
      (normalizedRadialMassSq z) 0
  nonlinear_common_second_derivative : ∀ {z : ℝ}, 0 < z → ∀ L radial A,
    HasDerivAt (fun t : ℝ => deriv (fun u : ℝ =>
      sourceCommonResponseAction L z (u * radial) (scaleMatrixConnectionJet u A)) t)
      (commonQuadraticSecondVariation L z radial A) 0
  nonlinear_mixed_second_derivative : ∀ L z radial A,
    HasDerivAt (fun s : ℝ => deriv (fun t : ℝ =>
      sourceCommonResponseAction L z (s * radial) (scaleMatrixConnectionJet t A)) 0)
      0 0
  complete_source_decomposition : ∀ L z x,
    hessianQuadratic L z x = sourceDecomposedQuadratic L z x
  complete_coercivity : ∀ L z x,
    generatedYangMillsGapSq L z * normSq x ≤
      hessianQuadratic L z x
  unique_closed_hessian : ∀ L z, IsSelfAdjoint (operator L z)
  selfAdjoint_extension_unique : ∀ L z T,
    IsSelfAdjoint T → finiteCore L z ≤ T → T = operator L z
  exact_closed_domain : ∀ L z f,
    f ∈ (operator L z).domain ↔
      Summable (fun mode : PhysicalMode =>
        physicalEigenvalue L z mode ^ 2 *
          ‖inner ℂ (physicalBasis mode) f‖ ^ 2)
  exact_bottom : ∀ L z,
    hessianQuadratic L z
        (Finsupp.single (minimizingMode L z) 1) =
      generatedYangMillsGapSq L z
  condensed_positive : ∀ L
      (hL : SourceInternalYangMillsResponse.criticalRadius < L),
    0 < generatedYangMillsGapSq L
      (SourceGeneratedYangMillsAction.condensedAmplitude L hL)

theorem conclusions : Conclusions where
  local_mixed_zero := commonHessianPairing_radial_connection_zero
  modal_mixed_zero := hessianPairing_radial_coclosed_zero
  coclosed_from_source := modeEigenvalue_eq_sourceCasimir_add_shift
  radial_from_source := normalizedRadialMassSq_eq_scoreVariance_mul_completeCurvature
  radial_restoring_derivative :=
    SourceGeneratedRadialVariation.sourceRadialForce_hasDerivAt_zero
  radial_potential_second_derivative :=
    SourceGeneratedRadialVariation.sourceRadialPotential_secondDeriv_zero
  nonlinear_common_second_derivative := sourceCommonResponseAction_secondDeriv
  nonlinear_mixed_second_derivative := sourceCommonResponseAction_mixed_secondDeriv_zero
  complete_source_decomposition := hessianQuadratic_eq_sourceDecomposedQuadratic
  complete_coercivity := gap_mul_normSq_le_hessianQuadratic
  unique_closed_hessian := operator_selfAdjoint
  selfAdjoint_extension_unique :=
    SourceGeneratedYangMillsPhysicalHessian.selfAdjoint_extension_unique
  exact_closed_domain := operator_domain_iff_summable
  exact_bottom := hessianQuadratic_minimizer
  condensed_positive := condensed_operator_positive_bottom

end GeneratedFoundations.Physical.SourceGeneratedYangMillsFullReduction
