private theorem positive_from_sum_difference {V : Type*} [AddCommGroup V] [Module ℂ V]
    (P Q G e : V) (hs : P + Q = e) (hg : G = P - Q) :
    P = (1 / 2 : ℂ) • (e + G) := by
  rw [← hs, hg]
  module

private theorem negative_from_sum_difference {V : Type*} [AddCommGroup V] [Module ℂ V]
    (P Q G e : V) (hs : P + Q = e) (hg : G = P - Q) :
    Q = (1 / 2 : ℂ) • (e - G) := by
  rw [← hs, hg]
  module

theorem matter_leftProjection_formula :
    SourceChiralCarrier.leftProjection =
      (1 / 2 : ℂ) • (1 + SourceChiralCarrier.grading) :=
  positive_from_sum_difference _ _ _ _ SourceChiralCarrier.projections_sum
    SourceChiralCarrier.grading_eq_projections

theorem matter_rightProjection_formula :
    SourceChiralCarrier.rightProjection =
      (1 / 2 : ℂ) • (1 - SourceChiralCarrier.grading) :=
  negative_from_sum_difference _ _ _ _ SourceChiralCarrier.projections_sum
    SourceChiralCarrier.grading_eq_projections

private theorem map_positive_from_grading {A B : Type*} [Ring A] [Ring B]
    [Algebra ℂ A] [Algebra ℂ B] (f : A →ₐ[ℂ] B) (P G : A) (G' : B)
    (hP : P = (1 / 2 : ℂ) • (1 + G)) (hG : f G = G') :
    f P = (1 / 2 : ℂ) • (1 + G') := by
  rw [hP, map_smul, map_add, map_one, hG]

private theorem map_negative_from_grading {A B : Type*} [Ring A] [Ring B]
    [Algebra ℂ A] [Algebra ℂ B] (f : A →ₐ[ℂ] B) (P G : A) (G' : B)
    (hP : P = (1 / 2 : ℂ) • (1 - G)) (hG : f G = G') :
    f P = (1 / 2 : ℂ) • (1 - G') := by
  rw [hP, map_smul, map_sub, map_one, hG]

/-- The left matter projector is the generated positive central projector. -/
theorem fullMatrixCoordinates_leftProjection :
    SourceChiralCarrier.fullMatrixCoordinates SourceChiralCarrier.leftProjection =
      colourPositive 4 := by
  exact (map_positive_from_grading
    SourceChiralCarrier.fullMatrixCoordinates.toAlgEquiv.toAlgHom _ _ _
    matter_leftProjection_formula SourceChiralCarrier.fullMatrixCoordinates_grading).trans
      (colourPositive_formula 4).symm

/-- The right matter projector is the generated negative central projector. -/
theorem fullMatrixCoordinates_rightProjection :
    SourceChiralCarrier.fullMatrixCoordinates SourceChiralCarrier.rightProjection =
      colourNegative 4 := by
  exact (map_negative_from_grading
    SourceChiralCarrier.fullMatrixCoordinates.toAlgEquiv.toAlgHom _ _ _
    matter_rightProjection_formula SourceChiralCarrier.fullMatrixCoordinates_grading).trans
      (colourNegative_formula 4).symm

def sourcePositive {b : ℝ} (hb : 0 < b) :
    GeneratedFoundations.Operations.SourceSpinCorner.End :=
  GeneratedFoundations.Operations.FiniteHermiteCorner.corner hb
    (sourceMode (d := 4)) (colourPositive 4)

def sourceNegative {b : ℝ} (hb : 0 < b) :
    GeneratedFoundations.Operations.SourceSpinCorner.End :=
  GeneratedFoundations.Operations.FiniteHermiteCorner.corner hb
    (sourceMode (d := 4)) (colourNegative 4)

theorem hermite_leftProjection {b : ℝ} (hb : 0 < b) (x : SourceChiralCarrier.FullMatter) :
    SourceChiralCarrier.hermiteIsometry hb (SourceChiralCarrier.leftProjection x) =
      sourcePositive hb (SourceChiralCarrier.hermiteIsometry hb x) := by
  rw [SourceChiralCarrier.hermiteIsometry_intertwines, fullMatrixCoordinates_leftProjection]
  rfl

theorem hermite_rightProjection {b : ℝ} (hb : 0 < b) (x : SourceChiralCarrier.FullMatter) :
    SourceChiralCarrier.hermiteIsometry hb (SourceChiralCarrier.rightProjection x) =
      sourceNegative hb (SourceChiralCarrier.hermiteIsometry hb x) := by
  rw [SourceChiralCarrier.hermiteIsometry_intertwines, fullMatrixCoordinates_rightProjection]
  rfl

theorem sourcePositive_fixes_iff {b : ℝ} (hb : 0 < b) (x : SourceChiralCarrier.FullMatter) :
    sourcePositive hb (SourceChiralCarrier.hermiteIsometry hb x) =
        SourceChiralCarrier.hermiteIsometry hb x ↔ SourceChiralCarrier.leftProjection x = x := by
  rw [← hermite_leftProjection]
  exact (SourceChiralCarrier.hermiteIsometry hb).injective.eq_iff

theorem sourceNegative_fixes_iff {b : ℝ} (hb : 0 < b) (x : SourceChiralCarrier.FullMatter) :
    sourceNegative hb (SourceChiralCarrier.hermiteIsometry hb x) =
        SourceChiralCarrier.hermiteIsometry hb x ↔ SourceChiralCarrier.rightProjection x = x := by
  rw [← hermite_rightProjection]
  exact (SourceChiralCarrier.hermiteIsometry hb).injective.eq_iff

def leftSourceEmbedding {b : ℝ} (hb : 0 < b) :
    SourceMinimalRepresentation.SourceCarrier →ₗ[ℂ]
      GeneratedFoundations.Correlation.ComplexGaussianStates.ComplexL2 :=
  (SourceChiralCarrier.hermiteIsometry hb).toLinearMap.comp SourceChiralCarrier.leftInclusion

def rightSourceEmbedding {b : ℝ} (hb : 0 < b) :
    SourceMinimalRepresentation.SourceCarrier →ₗ[ℂ]
      GeneratedFoundations.Correlation.ComplexGaussianStates.ComplexL2 :=
  (SourceChiralCarrier.hermiteIsometry hb).toLinearMap.comp SourceChiralCarrier.rightInclusion

theorem leftSourceEmbedding_injective {b : ℝ} (hb : 0 < b) :
    Function.Injective (leftSourceEmbedding hb) := by
  intro x y h
  change SourceChiralCarrier.hermiteIsometry hb (SourceChiralCarrier.leftInclusion x) =
    SourceChiralCarrier.hermiteIsometry hb (SourceChiralCarrier.leftInclusion y) at h
  have hxy := (SourceChiralCarrier.hermiteIsometry hb).injective h
  exact congrArg (fun v => (WithLp.ofLp v).1) hxy

theorem rightSourceEmbedding_injective {b : ℝ} (hb : 0 < b) :
    Function.Injective (rightSourceEmbedding hb) := by
  intro x y h
  change SourceChiralCarrier.hermiteIsometry hb (SourceChiralCarrier.rightInclusion x) =
    SourceChiralCarrier.hermiteIsometry hb (SourceChiralCarrier.rightInclusion y) at h
  have hxy := (SourceChiralCarrier.hermiteIsometry hb).injective h
  exact congrArg (fun v => (WithLp.ofLp v).2) hxy

open GeneratedFoundations.Operations.FiniteHermiteCorner in
theorem sourcePositive_range {b : ℝ} (hb : 0 < b) :
    LinearMap.range (sourcePositive hb).toLinearMap = LinearMap.range (leftSourceEmbedding hb) := by
  ext F
  constructor
  · rintro ⟨G, rfl⟩
    have hm := projection_mem hb (sourceMode (d := 4)) G
    rw [← SourceChiralCarrier.hermiteIsometry_range hb] at hm
    obtain ⟨x, hx⟩ := hm
    change SourceChiralCarrier.hermiteIsometry hb x = projection hb (sourceMode (d := 4)) G at hx
    refine ⟨(WithLp.ofLp x).1, ?_⟩
    change SourceChiralCarrier.hermiteIsometry hb
      (SourceChiralCarrier.leftProjection x) = sourcePositive hb G
    rw [hermite_leftProjection, hx]
    change (sourcePositive hb * projection hb (sourceMode (d := 4))) G = sourcePositive hb G
    rw [show sourcePositive hb * projection hb (sourceMode (d := 4)) = sourcePositive hb from
      mul_projection hb _ (sourceMode_injective 4) (colourPositive 4)]
  · rintro ⟨x, rfl⟩
    refine ⟨leftSourceEmbedding hb x, ?_⟩
    change sourcePositive hb (SourceChiralCarrier.hermiteIsometry hb
      (SourceChiralCarrier.leftInclusion x)) =
      SourceChiralCarrier.hermiteIsometry hb (SourceChiralCarrier.leftInclusion x)
    rw [← hermite_leftProjection]
    rfl

open GeneratedFoundations.Operations.FiniteHermiteCorner in
theorem sourceNegative_range {b : ℝ} (hb : 0 < b) :
    LinearMap.range (sourceNegative hb).toLinearMap = LinearMap.range (rightSourceEmbedding hb) := by
  ext F
  constructor
  · rintro ⟨G, rfl⟩
    have hm := projection_mem hb (sourceMode (d := 4)) G
    rw [← SourceChiralCarrier.hermiteIsometry_range hb] at hm
    obtain ⟨x, hx⟩ := hm
    change SourceChiralCarrier.hermiteIsometry hb x = projection hb (sourceMode (d := 4)) G at hx
    refine ⟨(WithLp.ofLp x).2, ?_⟩
    change SourceChiralCarrier.hermiteIsometry hb
      (SourceChiralCarrier.rightProjection x) = sourceNegative hb G
    rw [hermite_rightProjection, hx]
    change (sourceNegative hb * projection hb (sourceMode (d := 4))) G = sourceNegative hb G
    rw [show sourceNegative hb * projection hb (sourceMode (d := 4)) = sourceNegative hb from
      mul_projection hb _ (sourceMode_injective 4) (colourNegative 4)]
  · rintro ⟨x, rfl⟩
    refine ⟨rightSourceEmbedding hb x, ?_⟩
    change sourceNegative hb (SourceChiralCarrier.hermiteIsometry hb
      (SourceChiralCarrier.rightInclusion x)) =
      SourceChiralCarrier.hermiteIsometry hb (SourceChiralCarrier.rightInclusion x)
    rw [← hermite_rightProjection]
    rfl

theorem sourcePositive_finrank {b : ℝ} (hb : 0 < b) :
    Module.finrank ℂ (LinearMap.range (sourcePositive hb).toLinearMap) = 8 := by
  rw [sourcePositive_range, LinearMap.finrank_range_of_inj (leftSourceEmbedding_injective hb)]
  exact SourceMinimalRepresentation.sourceCarrier_finrank

theorem sourceNegative_finrank {b : ℝ} (hb : 0 < b) :
    Module.finrank ℂ (LinearMap.range (sourceNegative hb).toLinearMap) = 8 := by
  rw [sourceNegative_range, LinearMap.finrank_range_of_inj (rightSourceEmbedding_injective hb)]
  exact SourceMinimalRepresentation.sourceCarrier_finrank

end GeneratedFoundations.Physical.SourceCliffordChirality
