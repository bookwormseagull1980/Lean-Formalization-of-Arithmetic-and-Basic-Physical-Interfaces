module

public import GeneratedFoundations.Physical.SourcePhaseLift
public import Mathlib.Algebra.Algebra.Prod
public import Mathlib.LinearAlgebra.Prod
public import Mathlib.LinearAlgebra.Dimension.Constructions
public import Mathlib.LinearAlgebra.Matrix.ToLin
public import Mathlib.LinearAlgebra.Matrix.Kronecker
public import Mathlib.RingTheory.RootsOfUnity.Complex

/-!
# The exact kernel of the vacuum-reduced coordinate action

The unreduced right colour response is evaluated at the already derived
vacuum stabilizer. Its two columns have weights four and minus two; the
right scalar columns have weights zero and minus six. Together with the
left blocks, these define the complete sixteen-dimensional coordinate
representation, including its neutral line.

The kernel is computed from the action on this entire vector space. It is
the cyclic subgroup of order six generated by the central element with
phase exp(i pi/3), colour scalar exp(2 i pi/3), and weak scalar minus one.

This is a theorem about the vacuum-reduced coordinate representation.
Transport to the original matter carrier also requires the separate
source-carrier coordinate maps and their agreement with the Gaussian
vacuum spin frame; that agreement is not assumed or proved here.
-/

@[expose] public section

noncomputable section

open scoped Kronecker ComplexConjugate
open GeneratedFoundations.Operations.SourceSpinCorner (Mat2)
open GeneratedFoundations.Operations.SourceSpinCornerGroup (SU2)
open GeneratedFoundations.Physical.SourcePhaseLift

namespace GeneratedFoundations.Physical.GlobalGaugeKernel

abbrev Mat3 := Matrix (Fin 3) (Fin 3) ℂ
abbrev Mat1 := Matrix (Fin 1) (Fin 1) ℂ
abbrev MatQ := Matrix (Fin 3 × Fin 2) (Fin 3 × Fin 2) ℂ
abbrev SU3 := Matrix.specialUnitaryGroup (Fin 3) ℂ
abbrev GaugeGroup := SU3 × SU2 × Circle

abbrev QSpace := (Fin 3 × Fin 2) → ℂ
abbrev LSpace := Fin 2 → ℂ
abbrev ColourSpace := Fin 3 → ℂ
abbrev Line := Fin 1 → ℂ

/-- Six blocks, with the neutral right line retained. -/
abbrev Matter := (QSpace × LSpace) × ((ColourSpace × ColourSpace) × (Line × Line))

abbrev BlockAlgebra := (MatQ × Mat2) × ((Mat3 × Mat3) × (Mat1 × Mat1))

theorem matter_finrank : Module.finrank ℂ Matter = 16 := by
  simp [Matter, QSpace, LSpace, ColourSpace, Line, Module.finrank_prod]

/-- The right colour block before imposing the vacuum stabilizer. -/
def rightColouredMatrix (g3 : SU3) (gR : SU2) (z : Circle) : MatQ :=
  (z : ℂ) • ((g3 : Mat3) ⊗ₖ (gR : Mat2))

/-- Both reduced right colour columns are computed from the unreduced action. -/
theorem rightColouredMatrix_stabilizer (g3 : SU3) (z : Circle) :
    rightColouredMatrix g3 (stabilizerFrame z) z =
      (g3 : Mat3) ⊗ₖ Matrix.diagonal ![(z : ℂ) ^ 4, ((z : ℂ) ^ 2)⁻¹] := by
  rw [rightColouredMatrix, stabilizerFrame_matrix]
  ext ⟨a, i⟩ ⟨b, j⟩
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.smul_apply, pow_succ] <;>
    field_simp [Circle.coe_ne_zero z]

theorem rightColoured_upper (g3 : SU3) (z : Circle) (a b : Fin 3) :
    rightColouredMatrix g3 (stabilizerFrame z) z (a, 0) (b, 0) =
      ((z : ℂ) ^ 4 • (g3 : Mat3)) a b := by
  rw [rightColouredMatrix_stabilizer]
  simp [mul_comm]

theorem rightColoured_lower (g3 : SU3) (z : Circle) (a b : Fin 3) :
    rightColouredMatrix g3 (stabilizerFrame z) z (a, 1) (b, 1) =
      (((z : ℂ) ^ 2)⁻¹ • (g3 : Mat3)) a b := by
  rw [rightColouredMatrix_stabilizer]
  simp [mul_comm]

theorem rightColoured_cross (g3 : SU3) (z : Circle) (a b : Fin 3)
    (i j : Fin 2) (hij : i ≠ j) :
    rightColouredMatrix g3 (stabilizerFrame z) z (a, i) (b, j) = 0 := by
  rw [rightColouredMatrix_stabilizer]
  simp [hij]

/-- The scalar columns are the two actual columns of the vacuum-stabilized
right scalar action, including the column fixed pointwise. -/
theorem rightScalar_columns (z : Circle) :
    rightScalarMatrix (stabilizerFrame z) z 0 0 = 1 ∧
      rightScalarMatrix (stabilizerFrame z) z 1 1 = ((z : ℂ) ^ 6)⁻¹ := by
  rw [rightScalarMatrix_stabilizerFrame]
  simp

/-- Integer weights are respectively 1, -3, 4, -2, 0, -6. -/
def blocks (g : GaugeGroup) : BlockAlgebra :=
  (((g.2.2 : ℂ) • ((g.1 : Mat3) ⊗ₖ (g.2.1 : Mat2)),
      ((g.2.2 : ℂ) ^ 3)⁻¹ • (g.2.1 : Mat2)),
    (((g.2.2 : ℂ) ^ 4 • (g.1 : Mat3),
      ((g.2.2 : ℂ) ^ 2)⁻¹ • (g.1 : Mat3)),
      (1, ((g.2.2 : ℂ) ^ 6)⁻¹ • (1 : Mat1))))

theorem blocks_one : blocks 1 = 1 := by
  simp [blocks]

theorem blocks_mul (g h : GaugeGroup) : blocks (g * h) = blocks g * blocks h := by
  simp [blocks, mul_pow, mul_inv_rev, smul_smul,
    ← Matrix.mul_kronecker_mul, mul_comm]

def blockRepresentation : GaugeGroup →* BlockAlgebra where
  toFun := blocks
  map_one' := blocks_one
  map_mul' := blocks_mul

def leftMatrixAction : MatQ × Mat2 →ₐ[ℂ] Module.End ℂ (QSpace × LSpace) :=
  (LinearMap.prodMapAlgHom ℂ QSpace LSpace).comp
    (AlgHom.prodMap Matrix.toLinAlgEquiv'.toAlgHom Matrix.toLinAlgEquiv'.toAlgHom)

def quarkMatrixAction : Mat3 × Mat3 →ₐ[ℂ]
    Module.End ℂ (ColourSpace × ColourSpace) :=
  (LinearMap.prodMapAlgHom ℂ ColourSpace ColourSpace).comp
    (AlgHom.prodMap Matrix.toLinAlgEquiv'.toAlgHom Matrix.toLinAlgEquiv'.toAlgHom)

def leptonMatrixAction : Mat1 × Mat1 →ₐ[ℂ] Module.End ℂ (Line × Line) :=
  (LinearMap.prodMapAlgHom ℂ Line Line).comp
    (AlgHom.prodMap Matrix.toLinAlgEquiv'.toAlgHom Matrix.toLinAlgEquiv'.toAlgHom)

def rightMatrixAction : (Mat3 × Mat3) × (Mat1 × Mat1) →ₐ[ℂ]
    Module.End ℂ ((ColourSpace × ColourSpace) × (Line × Line)) :=
  (LinearMap.prodMapAlgHom ℂ (ColourSpace × ColourSpace) (Line × Line)).comp
    (AlgHom.prodMap quarkMatrixAction leptonMatrixAction)

def matrixAction : BlockAlgebra →ₐ[ℂ] Module.End ℂ Matter :=
  (LinearMap.prodMapAlgHom ℂ (QSpace × LSpace)
    ((ColourSpace × ColourSpace) × (Line × Line))).comp
      (AlgHom.prodMap leftMatrixAction rightMatrixAction)

/-- The complete action on vectors, not just a list of scalar weights. -/
def representation : GaugeGroup →* Module.End ℂ Matter :=
  matrixAction.toMonoidHom.comp blockRepresentation

private theorem prodMap_eq_one_iff {V W : Type*}
    [AddCommGroup V] [AddCommGroup W] [Module ℂ V] [Module ℂ W]
    (A : Module.End ℂ V) (B : Module.End ℂ W) :
    A.prodMap B = 1 ↔ A = 1 ∧ B = 1 := by
  constructor
  · intro h
    constructor
    · ext x
      exact congrArg (fun T : Module.End ℂ (V × W) => (T (x, 0)).1) h
    · ext y
      exact congrArg (fun T : Module.End ℂ (V × W) => (T (0, y)).2) h
  · rintro ⟨rfl, rfl⟩
    exact LinearMap.prodMap_one

private theorem toLin_eq_one_iff {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι ℂ) : Matrix.toLinAlgEquiv' A = 1 ↔ A = 1 := by
  constructor
  · intro h
    exact Matrix.toLinAlgEquiv'.injective (h.trans Matrix.toLinAlgEquiv'_one.symm)
  · rintro rfl
    exact Matrix.toLinAlgEquiv'_one

theorem matrixAction_eq_one_iff (A : BlockAlgebra) : matrixAction A = 1 ↔ A = 1 := by
  change ((Matrix.toLinAlgEquiv' A.1.1).prodMap (Matrix.toLinAlgEquiv' A.1.2)).prodMap
    (((Matrix.toLinAlgEquiv' A.2.1.1).prodMap (Matrix.toLinAlgEquiv' A.2.1.2)).prodMap
      ((Matrix.toLinAlgEquiv' A.2.2.1).prodMap (Matrix.toLinAlgEquiv' A.2.2.2))) = 1 ↔ _
  simp only [prodMap_eq_one_iff, toLin_eq_one_iff, Prod.ext_iff, Prod.fst_one, Prod.snd_one]

theorem representation_eq_one_iff_blocks (g : GaugeGroup) :
    representation g = 1 ↔ blocks g = 1 := matrixAction_eq_one_iff (blocks g)

private theorem inv_smul_eq_one_iff {n : ℕ} (a : ℂ) (ha : a ≠ 0)
    (M : Matrix (Fin n) (Fin n) ℂ) : a⁻¹ • M = 1 ↔ M = a • 1 := by
  constructor
  · intro h
    simpa only [smul_smul, mul_inv_cancel₀ ha, one_smul] using
      congrArg (fun N : Matrix (Fin n) (Fin n) ℂ => a • N) h
  · intro h
    rw [h, smul_smul, inv_mul_cancel₀ ha, one_smul]

private theorem scalar_one_injective {n : ℕ} [NeZero n] :
    Function.Injective (fun a : ℂ => a • (1 : Matrix (Fin n) (Fin n) ℂ)) := by
  intro a b hab
  simpa using congrArg (fun M : Matrix (Fin n) (Fin n) ℂ => M 0 0) hab

/-- Three full vector blocks force the central form; every remaining block
is then checked, including the neutral right line. -/
theorem representation_kernel_iff (g3 : SU3) (gL : SU2) (z : Circle) :
    representation (g3, gL, z) = 1 ↔
      z ^ 6 = 1 ∧ (g3 : Mat3) = (z : ℂ) ^ 2 • (1 : Mat3) ∧
        (gL : Mat2) = (z : ℂ) ^ 3 • (1 : Mat2) := by
  rw [representation_eq_one_iff_blocks]
  constructor
  · intro h
    have he : ((z : ℂ) ^ 6)⁻¹ • (1 : Mat1) = 1 :=
      congrArg (fun A : BlockAlgebra => A.2.2.2) h
    have hzcomplex : (z : ℂ) ^ 6 = 1 := by
      have hi : ((z : ℂ) ^ 6)⁻¹ = 1 :=
        scalar_one_injective (he.trans (one_smul ℂ (1 : Mat1)).symm)
      exact inv_eq_one.mp hi
    have hz : z ^ 6 = 1 := Subtype.ext (by simpa using hzcomplex)
    have hd : ((z : ℂ) ^ 2)⁻¹ • (g3 : Mat3) = 1 :=
      congrArg (fun A : BlockAlgebra => A.2.1.2) h
    have hl : ((z : ℂ) ^ 3)⁻¹ • (gL : Mat2) = 1 :=
      congrArg (fun A : BlockAlgebra => A.1.2) h
    exact ⟨hz,
      (inv_smul_eq_one_iff _ (pow_ne_zero 2 (Circle.coe_ne_zero z)) _).mp hd,
      (inv_smul_eq_one_iff _ (pow_ne_zero 3 (Circle.coe_ne_zero z)) _).mp hl⟩
  · rintro ⟨hz, h3, hL⟩
    have hzcomplex : (z : ℂ) ^ 6 = 1 := by
      simpa using congrArg (fun w : Circle => (w : ℂ)) hz
    change (((z : ℂ) • ((g3 : Mat3) ⊗ₖ (gL : Mat2)),
      ((z : ℂ) ^ 3)⁻¹ • (gL : Mat2)),
      (((z : ℂ) ^ 4 • (g3 : Mat3), ((z : ℂ) ^ 2)⁻¹ • (g3 : Mat3)),
        ((1 : Mat1), ((z : ℂ) ^ 6)⁻¹ • (1 : Mat1)))) = 1
    rw [h3, hL]
    have hq : (z : ℂ) * ((z : ℂ) ^ 3 * (z : ℂ) ^ 2) = (z : ℂ) ^ 6 := by ring
    have hu : (z : ℂ) ^ 4 * (z : ℂ) ^ 2 = (z : ℂ) ^ 6 := by ring
    simp only [Matrix.smul_kronecker, Matrix.kronecker_smul, Matrix.one_kronecker_one,
      smul_smul, hq, hu, hzcomplex, inv_one, one_smul,
      inv_mul_cancel₀ (pow_ne_zero 2 (Circle.coe_ne_zero z)),
      inv_mul_cancel₀ (pow_ne_zero 3 (Circle.coe_ne_zero z))]
    rfl

/-- Sixth roots form a subgroup of the existing phase circle. -/
def sixthRoots : Subgroup Circle where
  carrier := {z | z ^ 6 = 1}
  one_mem' := one_pow 6
  mul_mem' := by
    intro z w hz hw
    change z ^ 6 = 1 at hz
    change w ^ 6 = 1 at hw
    change (z * w) ^ 6 = 1
    rw [mul_pow, hz, hw, one_mul]
  inv_mem' := by
    intro z hz
    change z ^ 6 = 1 at hz
    change (z⁻¹) ^ 6 = 1
    rw [inv_pow, hz, inv_one]

def scalarSpecialUnitary (n : ℕ) (z : Circle) (hz : z ^ n = 1) :
    Matrix.specialUnitaryGroup (Fin n) ℂ := by
  refine ⟨(z : ℂ) • 1, (Matrix.mem_specialUnitaryGroup_iff).mpr ⟨?_, ?_⟩⟩
  · apply Matrix.mem_unitaryGroup_iff.mpr
    have hc : star (z : ℂ) = (z : ℂ)⁻¹ := by
      change conj (z : ℂ) = (z : ℂ)⁻¹
      simpa only [Circle.coe_inv] using (Circle.coe_inv_eq_conj z).symm
    simp [star_smul, hc, Circle.coe_ne_zero]
  · have hzc : (z : ℂ) ^ n = 1 := by
      simpa using congrArg (fun w : Circle => (w : ℂ)) hz
    simpa [Matrix.det_smul] using hzc

theorem square_cube_six (z : sixthRoots) : ((z : Circle) ^ 2) ^ 3 = 1 := by
  simpa only [← pow_mul] using (show (z : Circle) ^ 6 = 1 from z.property)

theorem cube_square_six (z : sixthRoots) : ((z : Circle) ^ 3) ^ 2 = 1 := by
  simpa only [← pow_mul] using (show (z : Circle) ^ 6 = 1 from z.property)

def centralEmbedding : sixthRoots →* GaugeGroup where
  toFun z :=
    (scalarSpecialUnitary 3 ((z : Circle) ^ 2) (square_cube_six z),
      scalarSpecialUnitary 2 ((z : Circle) ^ 3) (cube_square_six z), z)
  map_one' := by
    apply Prod.ext
    · apply Subtype.ext
      simp [scalarSpecialUnitary]
    · apply Prod.ext
      · apply Subtype.ext
        simp [scalarSpecialUnitary]
      · rfl
  map_mul' z w := by
    apply Prod.ext
    · apply Subtype.ext
      simp [scalarSpecialUnitary, mul_pow, smul_smul, mul_comm]
    · apply Prod.ext
      · apply Subtype.ext
        simp [scalarSpecialUnitary, mul_pow, smul_smul, mul_comm]
      · rfl

@[simp] theorem centralEmbedding_phase (z : sixthRoots) :
    (centralEmbedding z).2.2 = (z : Circle) := rfl

@[simp] theorem centralEmbedding_colour (z : sixthRoots) :
    ((centralEmbedding z).1 : Mat3) = ((z : Circle) : ℂ) ^ 2 • (1 : Mat3) := by
  simp [centralEmbedding, scalarSpecialUnitary]

@[simp] theorem centralEmbedding_weak (z : sixthRoots) :
    ((centralEmbedding z).2.1 : Mat2) = ((z : Circle) : ℂ) ^ 3 • (1 : Mat2) := by
  simp [centralEmbedding, scalarSpecialUnitary]

theorem centralEmbedding_injective : Function.Injective centralEmbedding := by
  intro z w h
  exact Subtype.ext (congrArg (fun g : GaugeGroup => g.2.2) h)

theorem centralEmbedding_mem_kernel (z : sixthRoots) :
    representation (centralEmbedding z) = 1 := by
  apply (representation_kernel_iff _ _ _).mpr
  exact ⟨z.property, centralEmbedding_colour z, centralEmbedding_weak z⟩

theorem kernel_iff_exists_centralEmbedding (g : GaugeGroup) :
    representation g = 1 ↔ ∃ z : sixthRoots, centralEmbedding z = g := by
  rcases g with ⟨g3, gL, z⟩
  constructor
  · intro hg
    obtain ⟨hz, h3, hL⟩ := (representation_kernel_iff g3 gL z).mp hg
    refine ⟨⟨z, hz⟩, ?_⟩
    apply Prod.ext
    · apply Subtype.ext
      exact (centralEmbedding_colour ⟨z, hz⟩).trans h3.symm
    · apply Prod.ext
      · apply Subtype.ext
        exact (centralEmbedding_weak ⟨z, hz⟩).trans hL.symm
      · rfl
  · rintro ⟨w, hw⟩
    rw [← hw]
    exact centralEmbedding_mem_kernel w

def zeta : Circle := Circle.exp (Real.pi / 3)

theorem zeta_complex_eq : (zeta : ℂ) = Complex.exp (2 * Real.pi * Complex.I / 6) := by
  rw [zeta, Circle.coe_exp]
  congr 1
  push_cast
  ring

theorem zeta_complex_primitive : IsPrimitiveRoot (zeta : ℂ) 6 := by
  rw [zeta_complex_eq]
  exact Complex.isPrimitiveRoot_exp 6 (by norm_num)

theorem zeta_primitive : IsPrimitiveRoot zeta 6 :=
  IsPrimitiveRoot.coe_submonoidClass_iff.mp zeta_complex_primitive

def rootGenerator : sixthRoots := ⟨zeta, zeta_primitive.pow_eq_one⟩

def generator : GaugeGroup := centralEmbedding rootGenerator

theorem generator_phase : generator.2.2 = Circle.exp (Real.pi / 3) := rfl

theorem generator_colour : (generator.1 : Mat3) =
    Complex.exp (2 * Real.pi * Complex.I / 3) • (1 : Mat3) := by
  rw [generator, centralEmbedding_colour]
  have he : ((rootGenerator : Circle) : ℂ) ^ 2 =
      Complex.exp (2 * Real.pi * Complex.I / 3) := by
    change (Circle.exp (Real.pi / 3) : ℂ) ^ 2 = _
    rw [Circle.coe_exp, ← Complex.exp_nat_mul]
    congr 1
    push_cast
    ring
  rw [he]

theorem generator_weak : (generator.2.1 : Mat2) = -(1 : Mat2) := by
  rw [generator, centralEmbedding_weak]
  have he : ((rootGenerator : Circle) : ℂ) ^ 3 = -1 := by
    change (Circle.exp (Real.pi / 3) : ℂ) ^ 3 = -1
    rw [Circle.coe_exp, ← Complex.exp_nat_mul]
    have harg : (3 : ℂ) * (((Real.pi / 3 : ℝ) : ℂ) * Complex.I) =
        (Real.pi : ℂ) * Complex.I := by push_cast; ring
    norm_num only [Nat.cast_ofNat]
    rw [harg, Complex.exp_pi_mul_I]
  rw [he, neg_one_smul]

theorem generator_mem_kernel : representation generator = 1 :=
  centralEmbedding_mem_kernel rootGenerator

theorem generator_pow_six : generator ^ 6 = 1 := by
  have hr : rootGenerator ^ 6 = 1 := Subtype.ext zeta_primitive.pow_eq_one
  rw [generator, ← map_pow, hr, map_one]

theorem generator_order : orderOf generator = 6 := by
  apply (orderOf_eq_iff (by norm_num : 0 < (6 : ℕ))).mpr
  refine ⟨generator_pow_six, ?_⟩
  intro n hn hpos h
  have hz : zeta ^ n = 1 := congrArg (fun g : GaugeGroup => g.2.2) h
  exact zeta_primitive.pow_ne_one_of_pos_of_lt hpos.ne' hn hz

/-- Each kernel element is one of the six powers of the displayed central generator. -/
theorem kernel_iff_generator_power (g : GaugeGroup) :
    representation g = 1 ↔ ∃ n : ℕ, n < 6 ∧ generator ^ n = g := by
  constructor
  · intro hg
    obtain ⟨z, rfl⟩ := (kernel_iff_exists_centralEmbedding g).mp hg
    have hz : (((z : Circle) : ℂ)) ^ 6 = 1 := by
      simpa using congrArg (fun w : Circle => (w : ℂ)) z.property
    obtain ⟨n, hn, he⟩ := zeta_complex_primitive.eq_pow_of_pow_eq_one hz
    have hphase : zeta ^ n = (z : Circle) := Subtype.ext (by simpa using he)
    have hroot : rootGenerator ^ n = z := Subtype.ext hphase
    refine ⟨n, hn, ?_⟩
    rw [generator, ← map_pow, hroot]
  · rintro ⟨n, _, rfl⟩
    rw [map_pow, generator_mem_kernel, one_pow]

theorem kernel_eq_zpowers : representation.ker = Subgroup.zpowers generator := by
  apply le_antisymm
  · intro g hg
    obtain ⟨n, _, hn⟩ := (kernel_iff_generator_power g).mp hg
    rw [← hn]
    exact (Subgroup.zpowers generator).pow_mem (Subgroup.mem_zpowers generator) n
  · exact Subgroup.zpowers_le.mpr generator_mem_kernel

theorem kernel_card : Nat.card representation.ker = 6 := by
  rw [kernel_eq_zpowers, Nat.card_zpowers, generator_order]

end GeneratedFoundations.Physical.GlobalGaugeKernel
