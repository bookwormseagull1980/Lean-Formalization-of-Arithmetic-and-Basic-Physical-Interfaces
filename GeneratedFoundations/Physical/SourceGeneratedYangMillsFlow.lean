module

public import GeneratedFoundations.Physical.SourceGeneratedYangMillsCoercivity

/-!
# Generated Yang--Mills dissipative flow

The Euler operator of the generated quadratic action exponentiates mode by
mode.  Because every mode is bounded below by the same generated spectral
bottom, the resulting semigroup contracts the full action at a rate that is
independent of the finite spectral cutoff.
-/

@[expose] public section

noncomputable section

open scoped BigOperators

namespace GeneratedFoundations.Physical.SourceGeneratedYangMillsFlow

open SourceGeneratedYangMillsGap SourceGeneratedYangMillsAction
open SourceGeneratedYangMillsEquation SourceGeneratedYangMillsCoercivity

/-- The exact semigroup generated by the reduced Yang--Mills Euler operator. -/
def spectralFlow {N : ℕ} (L z time : ℝ) (x : SpectralConfiguration N) :
    SpectralConfiguration N :=
  ⟨Real.exp (-time * normalizedRadialMassSq z) * x.radial,
    fun i => Real.exp (-time * coclosedMassIndex L z (i.1 + 1)) *
      x.coclosed i⟩

@[simp] theorem flow_zero_time {N : ℕ} (L z : ℝ)
    (x : SpectralConfiguration N) : spectralFlow L z 0 x = x := by
  cases x
  simp [spectralFlow]

@[simp] theorem flow_zero {N : ℕ} (L z time : ℝ) :
    spectralFlow L z time (SpectralConfiguration.zero N) =
      SpectralConfiguration.zero N := by
  simp [spectralFlow, SpectralConfiguration.zero]

theorem flow_add_time {N : ℕ} (L z s t : ℝ)
    (x : SpectralConfiguration N) :
    spectralFlow L z s (spectralFlow L z t x) =
      spectralFlow L z (s + t) x := by
  cases x with
  | mk radial coclosed =>
      have hr :
          Real.exp (-s * normalizedRadialMassSq z) *
              (Real.exp (-t * normalizedRadialMassSq z) * radial) =
            Real.exp (-(s + t) * normalizedRadialMassSq z) * radial := by
        rw [show -(s + t) * normalizedRadialMassSq z =
              -s * normalizedRadialMassSq z +
                -t * normalizedRadialMassSq z by ring,
            Real.exp_add]
        ring
      have hc :
          (fun i => Real.exp (-s * coclosedMassIndex L z (i.1 + 1)) *
              (Real.exp (-t * coclosedMassIndex L z (i.1 + 1)) *
                coclosed i)) =
            fun i => Real.exp (-(s + t) *
              coclosedMassIndex L z (i.1 + 1)) * coclosed i := by
        funext i
        rw [show -(s + t) * coclosedMassIndex L z (i.1 + 1) =
              -s * coclosedMassIndex L z (i.1 + 1) +
                -t * coclosedMassIndex L z (i.1 + 1) by ring,
            Real.exp_add]
        ring
      simp only [spectralFlow]
      rw [hr, hc]

private theorem weighted_exp_decay {gap mass time value : ℝ}
    (hgapmass : gap ≤ mass) (hmass : 0 ≤ mass) (htime : 0 ≤ time) :
    mass * (Real.exp (-time * mass) * value) ^ 2 ≤
      Real.exp (-2 * time * gap) * (mass * value ^ 2) := by
  have hexpSq : Real.exp (-time * mass) ^ 2 =
      Real.exp (-2 * time * mass) := by
    rw [pow_two, ← Real.exp_add]
    congr 1
    ring
  have hexp : Real.exp (-2 * time * mass) ≤
      Real.exp (-2 * time * gap) := by
    rw [Real.exp_le_exp]
    nlinarith
  rw [mul_pow, hexpSq]
  simpa [mul_assoc, mul_left_comm, mul_comm] using
    mul_le_mul_of_nonneg_right hexp (mul_nonneg hmass (sq_nonneg value))

/-- The generated action contracts exponentially at twice the spectral-bottom
rate.  The estimate is uniform in the number of retained coclosed shells. -/
theorem spectralAction_flow_le {N : ℕ} {L z time : ℝ}
    (hL : 0 < L) (hz : 0 < z) (htime : 0 ≤ time)
    (x : SpectralConfiguration N) :
    spectralAction L z (spectralFlow L z time x) ≤
      Real.exp (-2 * time * generatedYangMillsGapSq L z) *
        spectralAction L z x := by
  have hrad := weighted_exp_decay
    (generatedYangMillsGapSq_le_radial L z)
    (normalizedRadialMassSq_pos hz).le htime (value := x.radial)
  have hmode : ∀ i : Fin N,
      coclosedMassIndex L z (i.1 + 1) *
          (Real.exp (-time * coclosedMassIndex L z (i.1 + 1)) *
            x.coclosed i) ^ 2 ≤
        Real.exp (-2 * time * generatedYangMillsGapSq L z) *
          (coclosedMassIndex L z (i.1 + 1) * x.coclosed i ^ 2) := by
    intro i
    exact weighted_exp_decay
      (generatedYangMillsGapSq_le_coclosed
        (Nat.succ_le_succ (Nat.zero_le i.1)))
      (coclosedMassIndex_pos hL hz (i.1 + 1)).le htime
      (value := x.coclosed i)
  have hsum := Finset.sum_le_sum fun i (_hi : i ∈ Finset.univ) => hmode i
  rw [← Finset.mul_sum] at hsum
  change
    (1 / 2 : ℝ) * normalizedRadialMassSq z *
          (Real.exp (-time * normalizedRadialMassSq z) * x.radial) ^ 2 +
        (1 / 2 : ℝ) * ∑ i,
          coclosedMassIndex L z (i.1 + 1) *
            (Real.exp (-time * coclosedMassIndex L z (i.1 + 1)) *
              x.coclosed i) ^ 2 ≤
      Real.exp (-2 * time * generatedYangMillsGapSq L z) *
        ((1 / 2 : ℝ) * normalizedRadialMassSq z * x.radial ^ 2 +
          (1 / 2 : ℝ) * ∑ i,
            coclosedMassIndex L z (i.1 + 1) * x.coclosed i ^ 2)
  calc
    _ = (1 / 2 : ℝ) *
          (normalizedRadialMassSq z *
            (Real.exp (-time * normalizedRadialMassSq z) * x.radial) ^ 2) +
        (1 / 2 : ℝ) * ∑ i,
          coclosedMassIndex L z (i.1 + 1) *
            (Real.exp (-time * coclosedMassIndex L z (i.1 + 1)) *
              x.coclosed i) ^ 2 := by ring
    _ ≤ (1 / 2 : ℝ) *
          (Real.exp (-2 * time * generatedYangMillsGapSq L z) *
            (normalizedRadialMassSq z * x.radial ^ 2)) +
        (1 / 2 : ℝ) *
          (Real.exp (-2 * time * generatedYangMillsGapSq L z) *
            ∑ i, coclosedMassIndex L z (i.1 + 1) * x.coclosed i ^ 2) :=
      add_le_add
        (mul_le_mul_of_nonneg_left hrad (by norm_num))
        (mul_le_mul_of_nonneg_left hsum (by norm_num))
    _ = Real.exp (-2 * time * generatedYangMillsGapSq L z) *
        ((1 / 2 : ℝ) * normalizedRadialMassSq z * x.radial ^ 2 +
          (1 / 2 : ℝ) * ∑ i,
            coclosedMassIndex L z (i.1 + 1) * x.coclosed i ^ 2) := by ring

/-- In particular, the action is nonincreasing along forward generated time. -/
theorem spectralAction_flow_le_initial {N : ℕ} {L z time : ℝ}
    (hL : 0 < L) (hz : 0 < z) (htime : 0 ≤ time)
    (x : SpectralConfiguration N) :
    spectralAction L z (spectralFlow L z time x) ≤
      spectralAction L z x := by
  have hdecay : Real.exp (-2 * time * generatedYangMillsGapSq L z) ≤ 1 := by
    rw [Real.exp_le_one_iff]
    exact mul_nonpos_of_nonpos_of_nonneg
      (mul_nonpos_of_nonpos_of_nonneg (by norm_num) htime)
      (generatedYangMillsGapSq_pos hL hz).le
  calc
    spectralAction L z (spectralFlow L z time x) ≤
        Real.exp (-2 * time * generatedYangMillsGapSq L z) *
          spectralAction L z x := spectralAction_flow_le hL hz htime x
    _ ≤ spectralAction L z x := by
      have haction := spectralAction_nonneg hL hz x
      nlinarith

/-- Bundled semigroup and stability interface. -/
structure Properties : Prop where
  semigroup : ∀ {N} L z s t (x : SpectralConfiguration N),
    spectralFlow L z s (spectralFlow L z t x) =
      spectralFlow L z (s + t) x
  exponential_stability : ∀ {N L z time}, 0 < L → 0 < z → 0 ≤ time →
    ∀ x : SpectralConfiguration N,
      spectralAction L z (spectralFlow L z time x) ≤
        Real.exp (-2 * time * generatedYangMillsGapSq L z) *
          spectralAction L z x
  lyapunov : ∀ {N L z time}, 0 < L → 0 < z → 0 ≤ time →
    ∀ x : SpectralConfiguration N,
      spectralAction L z (spectralFlow L z time x) ≤
        spectralAction L z x

theorem properties : Properties where
  semigroup := flow_add_time
  exponential_stability := spectralAction_flow_le
  lyapunov := spectralAction_flow_le_initial

end GeneratedFoundations.Physical.SourceGeneratedYangMillsFlow
