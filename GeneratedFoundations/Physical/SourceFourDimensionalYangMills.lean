module

public import GeneratedFoundations.Physical.SourceFourDimensionalGaugeKinematics
public import GeneratedFoundations.Physical.SourceColourCasimir
public import Mathlib.LinearAlgebra.Matrix.PosDef

/-!
# Source-generated four-dimensional colour Yang--Mills structure

The four coordinate directions are the Hermitian determinant readout already
generated from the two source modes.  The colour Lie directions are the eight
trace-normalized generators already obtained from the generated colour
carrier.  Thus neither the base dimension nor the gauge algebra is supplied
as a new input.

A connection jet is given by real coefficients in these eight directions.
Its matrix curvature has the usual derivative plus commutator form.  The
source trace normalization defines the quadratic colour density without an
additional coupling constant.  The Lorentz contraction uses the diagonal
signs of the generated determinant form.  Constant generated colour changes
act by conjugation and preserve the quadratic density.
-/

@[expose] public section

noncomputable section

open scoped BigOperators ComplexConjugate Matrix

namespace GeneratedFoundations.Physical.SourceFourDimensionalYangMills

open SourceFourDimensionalGaugeKinematics

abbrev Mat3 := SourceColourCasimir.Mat3
abbrev ColourGroup := SourceGeneratedGaugeGroup.ColourGroup
abbrev ColourIndex := Fin 8
abbrev ColourCoordinates := ColourIndex → ℝ

/-- Matrix representative of a real source-colour Lie coordinate. -/
def colourLieMatrix (c : ColourCoordinates) : Mat3 :=
  ∑ a, (Complex.I * (c a : ℂ)) • SourceColourCasimir.generator a

theorem colourLieMatrix_conjTranspose (c : ColourCoordinates) :
    (colourLieMatrix c)ᴴ = -colourLieMatrix c := by
  rw [colourLieMatrix, Matrix.conjTranspose_sum]
  simp_rw [Matrix.conjTranspose_smul,
    (SourceColourCasimir.generator_hermitian _).eq]
  simp [Finset.sum_neg_distrib]

theorem colourLieMatrix_trace (c : ColourCoordinates) :
    Matrix.trace (colourLieMatrix c) = 0 := by
  simp [colourLieMatrix, Matrix.trace_sum, Matrix.trace_smul,
    SourceColourCasimir.generator_trace]

/-- The intrinsic matrix predicate for the generated colour Lie algebra. -/
def IsColourLie (X : Mat3) : Prop := Xᴴ = -X ∧ Matrix.trace X = 0

theorem colourLieMatrix_mem (c : ColourCoordinates) :
    IsColourLie (colourLieMatrix c) :=
  ⟨colourLieMatrix_conjTranspose c, colourLieMatrix_trace c⟩

/-- Every skew-Hermitian traceless colour direction is generated by the eight
source colour directions. -/
theorem colourLieMatrix_surjective {X : Mat3} (hX : IsColourLie X) :
    ∃ c : ColourCoordinates, colourLieMatrix c = X := by
  let H : Mat3 := (-Complex.I) • X
  have hH : H.IsHermitian := by
    change Hᴴ = H
    simp [H, Matrix.conjTranspose_smul, hX.1, smul_neg, neg_smul]
  have htr : Matrix.trace H = 0 := by
    simp [H, Matrix.trace_smul, hX.2]
  let c : ColourCoordinates := fun a => (SourceColourCasimir.expansionCoefficient H a).re
  have hexpand := SourceColourCasimir.hermitian_generator_expansion H hH htr
  refine ⟨c, ?_⟩
  calc
    colourLieMatrix c = Complex.I •
        (∑ a, ((SourceColourCasimir.expansionCoefficient H a).re : ℂ) •
          SourceColourCasimir.generator a) := by
      rw [colourLieMatrix, Finset.smul_sum]
      apply Finset.sum_congr rfl
      intro a _
      rw [smul_smul]
    _ = Complex.I • H := congrArg (fun A : Mat3 => Complex.I • A) hexpand
    _ = X := by simp [H, smul_smul]

theorem colourLie_commutator_mem {X Y : Mat3}
    (hX : IsColourLie X) (hY : IsColourLie Y) :
    IsColourLie (X * Y - Y * X) := by
  constructor
  · rw [Matrix.conjTranspose_sub, Matrix.conjTranspose_mul,
      Matrix.conjTranspose_mul, hX.1, hY.1]
    noncomm_ring
  · rw [Matrix.trace_sub, Matrix.trace_mul_comm X Y, sub_self]

/-- Four-dimensional connection data in the generated eight-dimensional
colour Lie algebra. -/
structure ColourConnectionJet where
  value : CoordinateIndex → ColourCoordinates
  derivative : CoordinateIndex → CoordinateIndex → ColourCoordinates

def connectionMatrix (A : ColourConnectionJet) (μ : CoordinateIndex) : Mat3 :=
  colourLieMatrix (A.value μ)

def derivativeMatrix (A : ColourConnectionJet) (μ ν : CoordinateIndex) : Mat3 :=
  colourLieMatrix (A.derivative μ ν)

/-- The four-dimensional colour curvature. -/
def curvature (A : ColourConnectionJet) (μ ν : CoordinateIndex) : Mat3 :=
  derivativeMatrix A μ ν - derivativeMatrix A ν μ +
    (connectionMatrix A μ * connectionMatrix A ν -
      connectionMatrix A ν * connectionMatrix A μ)

theorem curvature_swap (A : ColourConnectionJet) (μ ν : CoordinateIndex) :
    curvature A ν μ = -curvature A μ ν := by
  simp only [curvature]
  abel

@[simp] theorem curvature_self (A : ColourConnectionJet) (μ : CoordinateIndex) :
    curvature A μ μ = 0 := by
  simp [curvature]

theorem curvature_mem (A : ColourConnectionJet) (μ ν : CoordinateIndex) :
    IsColourLie (curvature A μ ν) := by
  have hμν := colourLieMatrix_mem (A.derivative μ ν)
  have hνμ := colourLieMatrix_mem (A.derivative ν μ)
  have hμ := colourLieMatrix_mem (A.value μ)
  have hν := colourLieMatrix_mem (A.value ν)
  constructor
  · simp only [curvature, derivativeMatrix, connectionMatrix,
      Matrix.conjTranspose_add, Matrix.conjTranspose_sub,
      Matrix.conjTranspose_mul, hμν.1, hνμ.1, hμ.1, hν.1]
    noncomm_ring
  · have hcomm : Matrix.trace
        (connectionMatrix A μ * connectionMatrix A ν -
          connectionMatrix A ν * connectionMatrix A μ) = 0 := by
      rw [Matrix.trace_sub,
        Matrix.trace_mul_comm (connectionMatrix A μ) (connectionMatrix A ν), sub_self]
    rw [curvature, Matrix.trace_add, Matrix.trace_sub, hcomm]
    change Matrix.trace (colourLieMatrix (A.derivative μ ν)) -
        Matrix.trace (colourLieMatrix (A.derivative ν μ)) + 0 = 0
    rw [hμν.2, hνμ.2]
    simp

theorem curvature_generated (A : ColourConnectionJet) (μ ν : CoordinateIndex) :
    ∃ c : ColourCoordinates, colourLieMatrix c = curvature A μ ν :=
  colourLieMatrix_surjective (curvature_mem A μ ν)

/-- Source-normalized invariant quadratic form on colour Lie matrices. -/
def colourQuadratic (X : Mat3) : ℝ := -(Matrix.trace (X * X)).re

theorem colourQuadratic_coordinates (c : ColourCoordinates) :
    colourQuadratic (colourLieMatrix c) = (1 / 2 : ℝ) * ∑ a, (c a) ^ 2 := by
  simp [colourQuadratic, colourLieMatrix, Finset.sum_mul, Finset.mul_sum,
    Matrix.trace_sum, Matrix.trace_smul,
    SourceColourCasimir.generator_trace_pair, apply_ite]
  ring_nf

theorem colourQuadratic_nonneg {X : Mat3} (hX : IsColourLie X) :
    0 ≤ colourQuadratic X := by
  obtain ⟨c, rfl⟩ := colourLieMatrix_surjective hX
  rw [colourQuadratic_coordinates]
  positivity

theorem colourQuadratic_eq_zero_iff {X : Mat3} (hX : IsColourLie X) :
    colourQuadratic X = 0 ↔ X = 0 := by
  obtain ⟨c, rfl⟩ := colourLieMatrix_surjective hX
  rw [colourQuadratic_coordinates]
  constructor
  · intro h
    have hs : ∑ a, c a ^ 2 = 0 := by linarith
    have hc : ∀ a, c a = 0 := by
      intro a
      have hz := (Finset.sum_eq_zero_iff_of_nonneg
        (fun i _ => sq_nonneg (c i))).mp hs a (Finset.mem_univ a)
      exact sq_eq_zero_iff.mp hz
    simp [colourLieMatrix, hc]
  · intro h
    have hq : colourQuadratic (colourLieMatrix c) = 0 := by
      rw [h]
      simp [colourQuadratic]
    rw [colourQuadratic_coordinates] at hq
    exact hq

/-- Units underlying a generated special-unitary colour transformation. -/
def colourUnits (g : ColourGroup) : Mat3ˣ where
  val := g
  inv := ((g⁻¹ : ColourGroup) : Mat3)
  val_inv := by
    change (g : Mat3) * ((g⁻¹ : ColourGroup) : Mat3) = 1
    exact congrArg (fun h : ColourGroup => (h : Mat3)) (mul_inv_cancel g)
  inv_val := by
    change ((g⁻¹ : ColourGroup) : Mat3) * (g : Mat3) = 1
    exact congrArg (fun h : ColourGroup => (h : Mat3)) (inv_mul_cancel g)

/-- Constant generated colour change on a colour matrix. -/
def colourConjugate (g : ColourGroup) (X : Mat3) : Mat3 :=
  ((↑(colourUnits g)⁻¹ : Mat3) * X) * (↑(colourUnits g) : Mat3)

theorem colourQuadratic_conjugate (g : ColourGroup) (X : Mat3) :
    colourQuadratic (colourConjugate g X) = colourQuadratic X := by
  have hsq : colourConjugate g X * colourConjugate g X =
      ((↑(colourUnits g)⁻¹ : Mat3) * (X * X)) * (↑(colourUnits g) : Mat3) := by
    simp [colourConjugate, mul_assoc]
  rw [colourQuadratic, hsq, Matrix.trace_units_conj']
  rfl

/-! ## Local generated gauge covariance -/

/-- Matrix form of a connection first jet.  This auxiliary presentation is
used only to state the product rule for a local generated colour change. -/
structure MatrixConnectionJet where
  value : CoordinateIndex → Mat3
  derivative : CoordinateIndex → CoordinateIndex → Mat3

def colourMatrixConnectionJet (A : ColourConnectionJet) : MatrixConnectionJet where
  value := connectionMatrix A
  derivative := derivativeMatrix A

def matrixCurvature (A : MatrixConnectionJet) (μ ν : CoordinateIndex) : Mat3 :=
  A.derivative μ ν - A.derivative ν μ +
    (A.value μ * A.value ν - A.value ν * A.value μ)

@[simp] theorem matrixCurvature_colour (A : ColourConnectionJet) (μ ν : CoordinateIndex) :
    matrixCurvature (colourMatrixConnectionJet A) μ ν = curvature A μ ν := rfl

/-- The two-jet at a point of a local transformation valued in the generated
colour group.  Equality of the mixed second derivatives is the jet form of
commuting coordinate derivatives. -/
structure LocalColourGaugeTwoJet where
  value : ColourGroup
  first : CoordinateIndex → Mat3
  second : CoordinateIndex → CoordinateIndex → Mat3
  mixed_second : ∀ μ ν, second μ ν = second ν μ

def inverseDerivative (q : LocalColourGaugeTwoJet) (μ : CoordinateIndex) : Mat3 :=
  -((↑(colourUnits q.value)⁻¹ : Mat3) * q.first μ *
      (↑(colourUnits q.value)⁻¹ : Mat3))

/-- Connection two-jet product rule under a local generated colour change. -/
def transformMatrixConnectionJet (q : LocalColourGaugeTwoJet)
    (A : MatrixConnectionJet) : MatrixConnectionJet where
  value := fun μ =>
    (↑(colourUnits q.value)⁻¹ : Mat3) * A.value μ *
        (↑(colourUnits q.value) : Mat3) +
      (↑(colourUnits q.value)⁻¹ : Mat3) * q.first μ
  derivative := fun μ ν =>
    inverseDerivative q μ * A.value ν * (↑(colourUnits q.value) : Mat3) +
      (↑(colourUnits q.value)⁻¹ : Mat3) * A.derivative μ ν *
        (↑(colourUnits q.value) : Mat3) +
      (↑(colourUnits q.value)⁻¹ : Mat3) * A.value ν * q.first μ +
      inverseDerivative q μ * q.first ν +
      (↑(colourUnits q.value)⁻¹ : Mat3) * q.second μ ν

/-- The curvature computed from the transformed connection is the conjugate
of the original curvature.  This is derived from the connection product rule,
not imposed as a separate transformation law. -/
theorem matrixCurvature_transform (q : LocalColourGaugeTwoJet)
    (A : MatrixConnectionJet) (μ ν : CoordinateIndex) :
    matrixCurvature (transformMatrixConnectionJet q A) μ ν =
      colourConjugate q.value (matrixCurvature A μ ν) := by
  have huv : (↑(colourUnits q.value) : Mat3) *
      (↑(colourUnits q.value)⁻¹ : Mat3) = 1 := Units.mul_inv _
  have hvu : (↑(colourUnits q.value)⁻¹ : Mat3) *
      (↑(colourUnits q.value) : Mat3) = 1 := Units.inv_mul _
  have huv_assoc (X : Mat3) : (↑(colourUnits q.value) : Mat3) *
      ((↑(colourUnits q.value)⁻¹ : Mat3) * X) = X := by
    rw [← mul_assoc, huv, one_mul]
  have hvu_assoc (X : Mat3) : (↑(colourUnits q.value)⁻¹ : Mat3) *
      ((↑(colourUnits q.value) : Mat3) * X) = X := by
    rw [← mul_assoc, hvu, one_mul]
  have hmix := q.mixed_second μ ν
  simp only [matrixCurvature, transformMatrixConnectionJet,
    inverseDerivative, colourConjugate]
  noncomm_ring [huv, hvu, huv_assoc, hvu_assoc, hmix]

theorem localQuadraticDensity_gauge_invariant (q : LocalColourGaugeTwoJet)
    (A : MatrixConnectionJet) :
    (∑ μ, ∑ ν,
      colourQuadratic (matrixCurvature (transformMatrixConnectionJet q A) μ ν)) =
      ∑ μ, ∑ ν, colourQuadratic (matrixCurvature A μ ν) := by
  simp [matrixCurvature_transform, colourQuadratic_conjugate]

/-- The signs of the generated determinant form. -/
def lorentzSign : CoordinateIndex → ℝ
  | 0 => 1
  | _ => -1

theorem localLorentzDensity_gauge_invariant (q : LocalColourGaugeTwoJet)
    (A : MatrixConnectionJet) :
    (∑ μ, ∑ ν, lorentzSign μ * lorentzSign ν *
      colourQuadratic (matrixCurvature (transformMatrixConnectionJet q A) μ ν)) =
      ∑ μ, ∑ ν, lorentzSign μ * lorentzSign ν *
        colourQuadratic (matrixCurvature A μ ν) := by
  simp [matrixCurvature_transform, colourQuadratic_conjugate]

/-- Positive source-normalized colour curvature density.  Both ordered index
pairs are retained; the normalization is inherited from the source trace. -/
def euclideanCurvatureDensity (A : ColourConnectionJet) : ℝ :=
  ∑ μ, ∑ ν, colourQuadratic (curvature A μ ν)

theorem euclideanCurvatureDensity_nonneg (A : ColourConnectionJet) :
    0 ≤ euclideanCurvatureDensity A := by
  apply Finset.sum_nonneg
  intro μ _
  apply Finset.sum_nonneg
  intro ν _
  exact colourQuadratic_nonneg (curvature_mem A μ ν)

theorem euclideanCurvatureDensity_eq_zero_iff (A : ColourConnectionJet) :
    euclideanCurvatureDensity A = 0 ↔ ∀ μ ν, curvature A μ ν = 0 := by
  constructor
  · intro h μ ν
    have hμ : (∑ ν, colourQuadratic (curvature A μ ν)) = 0 :=
      (Finset.sum_eq_zero_iff_of_nonneg
        (fun i _ => Finset.sum_nonneg fun j _ =>
          colourQuadratic_nonneg (curvature_mem A i j))).mp h μ (Finset.mem_univ μ)
    have hμν : colourQuadratic (curvature A μ ν) = 0 :=
      (Finset.sum_eq_zero_iff_of_nonneg
        (fun j _ => colourQuadratic_nonneg (curvature_mem A μ j))).mp
          hμ ν (Finset.mem_univ ν)
    exact (colourQuadratic_eq_zero_iff (curvature_mem A μ ν)).mp hμν
  · intro h
    simp [euclideanCurvatureDensity, h, colourQuadratic]

/-- Lorentzian Yang--Mills density obtained by raising both curvature indices
with the diagonal form generated by the Hermitian determinant. -/
def lorentzCurvatureDensity (A : ColourConnectionJet) : ℝ :=
  ∑ μ, ∑ ν, lorentzSign μ * lorentzSign ν *
    colourQuadratic (curvature A μ ν)

/-- Gauge action on a curvature tensor under a constant generated colour
change. -/
def transformCurvature (g : ColourGroup)
    (F : CoordinateIndex → CoordinateIndex → Mat3) :
    CoordinateIndex → CoordinateIndex → Mat3 :=
  fun μ ν => colourConjugate g (F μ ν)

theorem quadraticDensity_gauge_invariant (g : ColourGroup)
    (F : CoordinateIndex → CoordinateIndex → Mat3) :
    (∑ μ, ∑ ν, colourQuadratic (transformCurvature g F μ ν)) =
      ∑ μ, ∑ ν, colourQuadratic (F μ ν) := by
  simp [transformCurvature, colourQuadratic_conjugate]

theorem lorentzDensity_gauge_invariant (g : ColourGroup)
    (F : CoordinateIndex → CoordinateIndex → Mat3) :
    (∑ μ, ∑ ν, lorentzSign μ * lorentzSign ν *
        colourQuadratic (transformCurvature g F μ ν)) =
      ∑ μ, ∑ ν, lorentzSign μ * lorentzSign ν *
        colourQuadratic (F μ ν) := by
  simp [transformCurvature, colourQuadratic_conjugate]

/-- Propositional certificate exported through the common source theorem. -/
structure Properties : Prop where
  generated_lie_algebra : ∀ X : Mat3, IsColourLie X →
    ∃ c : ColourCoordinates, colourLieMatrix c = X
  curvature_antisymmetric : ∀ A μ ν, curvature A ν μ = -curvature A μ ν
  curvature_generated : ∀ A μ ν,
    ∃ c : ColourCoordinates, colourLieMatrix c = curvature A μ ν
  quadratic_nonnegative : ∀ X, IsColourLie X → 0 ≤ colourQuadratic X
  quadratic_definite : ∀ X, IsColourLie X →
    (colourQuadratic X = 0 ↔ X = 0)
  quadratic_gauge_invariant : ∀ g X,
    colourQuadratic (colourConjugate g X) = colourQuadratic X
  local_curvature_covariant : ∀ q A μ ν,
    matrixCurvature (transformMatrixConnectionJet q A) μ ν =
      colourConjugate q.value (matrixCurvature A μ ν)
  local_quadratic_gauge_invariant : ∀ q A,
    (∑ μ, ∑ ν,
      colourQuadratic (matrixCurvature (transformMatrixConnectionJet q A) μ ν)) =
      ∑ μ, ∑ ν, colourQuadratic (matrixCurvature A μ ν)
  lorentz_gauge_invariant : ∀ g F,
    (∑ μ, ∑ ν, lorentzSign μ * lorentzSign ν *
        colourQuadratic (transformCurvature g F μ ν)) =
      ∑ μ, ∑ ν, lorentzSign μ * lorentzSign ν * colourQuadratic (F μ ν)

theorem sourceFourDimensionalYangMillsProperties : Properties where
  generated_lie_algebra := fun _ => colourLieMatrix_surjective
  curvature_antisymmetric := curvature_swap
  curvature_generated := curvature_generated
  quadratic_nonnegative := fun _ => colourQuadratic_nonneg
  quadratic_definite := fun _ => colourQuadratic_eq_zero_iff
  quadratic_gauge_invariant := colourQuadratic_conjugate
  local_curvature_covariant := matrixCurvature_transform
  local_quadratic_gauge_invariant := localQuadraticDensity_gauge_invariant
  lorentz_gauge_invariant := lorentzDensity_gauge_invariant

end GeneratedFoundations.Physical.SourceFourDimensionalYangMills
