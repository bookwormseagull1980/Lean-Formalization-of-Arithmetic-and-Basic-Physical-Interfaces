module

public import GeneratedFoundations.Geometry.SourceQuaternionAmplitude
public import GeneratedFoundations.Physical.ReversalRealConnector

/-!
# Reversal-real connectors in the generated amplitude algebra

The real algebra generated by the source operations is exactly the space
of complex matrices intertwining the source pseudoreal structure. Its
second column gives one complex-doublet coordinate, with real-linear
dependence on the amplitude. The same classification transports to two
distinct carriers when their source coordinates are specified.
-/

@[expose] public section

noncomputable section

open scoped Quaternion ComplexConjugate
open GeneratedFoundations.Operations.SourceSpinCornerGroup (canonical)
open GeneratedFoundations.Geometry.SourceQuaternionAmplitude
open GeneratedFoundations.Physical.ReversalRealConnector

namespace GeneratedFoundations.Physical.SourceReversalRealConnector

theorem matrixMap_reversalReal (q : ℍ) : ReversalReal (matrixMap q) := by
  rw [matrixMap_eq]
  change ReversalReal (canonicalMatrix _ _)
  exact canonicalMatrix_reversalReal _ _

theorem matrixMap_ofMatrix_of_reversalReal (M : Mat2) (hM : ReversalReal M) :
    matrixMap (ofMatrix M) = M := by
  rw [matrixMap_ofMatrix]
  obtain ⟨h10, h11⟩ := (reversalReal_iff_entries M).mp hM
  ext i j
  fin_cases i <;> fin_cases j <;> simp [canonical, h10, h11]

/-- No restriction on the input matrix is imposed before solving the equation. -/
theorem mem_amplitude_iff_reversalReal (M : Mat2) :
    M ∈ amplitudeAlgebra ↔ ReversalReal M := by
  constructor
  · rintro ⟨q, rfl⟩
    exact matrixMap_reversalReal q
  · intro hM
    exact ⟨ofMatrix M, matrixMap_ofMatrix_of_reversalReal M hM⟩

theorem amplitudeSubmodule_eq_reversalReal :
    amplitudeAlgebra.toSubmodule = reversalRealSubmodule := by
  ext M
  exact mem_amplitude_iff_reversalReal M

theorem reversalReal_iff_unique_sourceAmplitude (M : Mat2) :
    ReversalReal M ↔ ∃! q : ℍ, matrixMap q = M := by
  constructor
  · intro hM
    refine ⟨ofMatrix M, matrixMap_ofMatrix_of_reversalReal M hM, ?_⟩
    intro q hq
    apply matrixMap_injective
    exact hq.trans (matrixMap_ofMatrix_of_reversalReal M hM).symm
  · rintro ⟨q, rfl, _⟩
    exact matrixMap_reversalReal q

theorem connectorOfDoublet_mem_amplitude (H : Spinor) :
    connectorOfDoublet H ∈ amplitudeAlgebra :=
  (mem_amplitude_iff_reversalReal _).mpr (connectorOfDoublet_reversalReal H)

/-- The source amplitude and the reversal-real connector have the same coordinates. -/
def doubletAmplitudeEquiv : Spinor ≃ₗ[ℝ] amplitudeAlgebra where
  toFun H := ⟨connectorOfDoublet H, connectorOfDoublet_mem_amplitude H⟩
  invFun M := doubletOfMatrix M.1
  left_inv H := doubletOfMatrix_connectorOfDoublet H
  right_inv M := by
    apply Subtype.ext
    exact connectorOfDoublet_doubletOfMatrix M.1
      ((mem_amplitude_iff_reversalReal M.1).mp M.2)
  map_add' H K := Subtype.ext (connectorOfDoublet_add H K)
  map_smul' r H := Subtype.ext (connectorOfDoublet_real_smul r H)

def quaternionDoubletEquiv : ℍ ≃ₗ[ℝ] Spinor :=
  amplitudeEquiv.toLinearEquiv.trans doubletAmplitudeEquiv.symm

theorem sourceAmplitude_unique_doublet (M : amplitudeAlgebra) :
    ∃! H : Spinor, (M : Mat2) = connectorOfDoublet H :=
  (reversalReal_iff_existsUnique_doublet M.1).mp
    ((mem_amplitude_iff_reversalReal M.1).mp M.2)

theorem reversalReal_mul {M N : Mat2} (hM : ReversalReal M) (hN : ReversalReal N) :
    ReversalReal (M * N) :=
  (mem_amplitude_iff_reversalReal _).mp
    (amplitudeAlgebra.mul_mem ((mem_amplitude_iff_reversalReal M).mpr hM)
      ((mem_amplitude_iff_reversalReal N).mpr hN))

theorem reversalReal_adjoint {M : Mat2} (hM : ReversalReal M) :
    ReversalReal M.conjTranspose := by
  obtain ⟨q, rfl, _⟩ := (reversalReal_iff_unique_sourceAmplitude M).mp hM
  rw [← matrixMap_star]
  exact matrixMap_reversalReal (star q)

section CarrierTransport

variable {L R : Type*} [AddCommGroup L] [Module ℂ L]
  [AddCommGroup R] [Module ℂ R]

/-- Coordinates are supplied by the common-carrier realization. -/
def transportedReversal (e : L ≃ₗ[ℂ] Spinor) (v : L) : L :=
  e.symm (reversal (e v))

theorem transportedReversal_square (e : L ≃ₗ[ℂ] Spinor) (v : L) :
    transportedReversal e (transportedReversal e v) = -v := by
  simp [transportedReversal, reversal_square]

def sourceMap (eL : L ≃ₗ[ℂ] Spinor) (eR : R ≃ₗ[ℂ] Spinor) (M : Mat2) : R →ₗ[ℂ] L :=
  eL.symm.toLinearMap.comp (M.mulVecLin.comp eR.toLinearMap)

def matrixCoordinates (eL : L ≃ₗ[ℂ] Spinor) (eR : R ≃ₗ[ℂ] Spinor)
    (F : R →ₗ[ℂ] L) : Mat2 :=
  LinearMap.toMatrix' (eL.toLinearMap.comp (F.comp eR.symm.toLinearMap))

theorem matrixCoordinates_mulVec (eL : L ≃ₗ[ℂ] Spinor) (eR : R ≃ₗ[ℂ] Spinor)
    (F : R →ₗ[ℂ] L) (u : Spinor) :
    (matrixCoordinates eL eR F).mulVec u = eL (F (eR.symm u)) := by
  change Matrix.toLin' (LinearMap.toMatrix'
    (eL.toLinearMap.comp (F.comp eR.symm.toLinearMap))) u = _
  rw [Matrix.toLin'_toMatrix']
  rfl

theorem sourceMap_matrixCoordinates (eL : L ≃ₗ[ℂ] Spinor)
    (eR : R ≃ₗ[ℂ] Spinor) (F : R →ₗ[ℂ] L) :
    sourceMap eL eR (matrixCoordinates eL eR F) = F := by
  ext v
  apply eL.injective
  simp [sourceMap, matrixCoordinates_mulVec]

theorem matrixCoordinates_sourceMap (eL : L ≃ₗ[ℂ] Spinor)
    (eR : R ≃ₗ[ℂ] Spinor) (M : Mat2) :
    matrixCoordinates eL eR (sourceMap eL eR M) = M := by
  apply Matrix.toLin'.injective
  apply LinearMap.ext
  intro u
  change (matrixCoordinates eL eR (sourceMap eL eR M)).mulVec u = M.mulVec u
  rw [matrixCoordinates_mulVec]
  simp [sourceMap]

/-- The two pseudoreal maps need not act on the same underlying carrier. -/
def IntertwinesReversal (eL : L ≃ₗ[ℂ] Spinor) (eR : R ≃ₗ[ℂ] Spinor)
    (F : R →ₗ[ℂ] L) : Prop :=
  ∀ v, F (transportedReversal eR v) = transportedReversal eL (F v)

theorem intertwinesReversal_iff_coordinates (eL : L ≃ₗ[ℂ] Spinor)
    (eR : R ≃ₗ[ℂ] Spinor) (F : R →ₗ[ℂ] L) :
    IntertwinesReversal eL eR F ↔ ReversalReal (matrixCoordinates eL eR F) := by
  constructor
  · intro hF u
    rw [matrixCoordinates_mulVec, matrixCoordinates_mulVec]
    have hu := congrArg eL (hF (eR.symm u))
    simpa only [transportedReversal, LinearEquiv.apply_symm_apply] using hu
  · intro hF v
    apply eL.injective
    have hv := hF (eR v)
    rw [matrixCoordinates_mulVec, matrixCoordinates_mulVec] at hv
    simpa only [transportedReversal, LinearEquiv.apply_symm_apply,
      LinearEquiv.symm_apply_apply] using hv

theorem intertwinesReversal_iff_unique_doublet (eL : L ≃ₗ[ℂ] Spinor)
    (eR : R ≃ₗ[ℂ] Spinor) (F : R →ₗ[ℂ] L) :
    IntertwinesReversal eL eR F ↔
      ∃! H : Spinor, F = sourceMap eL eR (connectorOfDoublet H) := by
  rw [intertwinesReversal_iff_coordinates]
  constructor
  · intro hF
    obtain ⟨H, hH, huniq⟩ :=
      (reversalReal_iff_existsUnique_doublet _).mp hF
    refine ⟨H, ?_, ?_⟩
    · change F = sourceMap eL eR (connectorOfDoublet H)
      rw [← hH, sourceMap_matrixCoordinates]
    · intro K hK
      apply huniq
      rw [hK, matrixCoordinates_sourceMap]
  · rintro ⟨H, hH, _⟩
    rw [hH, matrixCoordinates_sourceMap]
    exact connectorOfDoublet_reversalReal H

end CarrierTransport

end GeneratedFoundations.Physical.SourceReversalRealConnector
