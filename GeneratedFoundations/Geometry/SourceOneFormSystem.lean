module

public import GeneratedFoundations.Geometry.SourceOneFormClosedHodge
public import GeneratedFoundations.Geometry.SourceOneFormCurlSpectrum
public import GeneratedFoundations.Geometry.SourceOneFormSpectralCore
public import GeneratedFoundations.Geometry.SourceOneFormHodgeLaplacian
public import GeneratedFoundations.Geometry.SourceOneFormCoclosedSpectrum
public import GeneratedFoundations.Geometry.SourceOneFormCompleteness
public import GeneratedFoundations.Geometry.SourceOneFormHilbertSum

/-!
# The generated coclosed one-form differential system

The original Haar one-form space, the source curl, the closed Hodge
Laplacian and the complete coclosed spectral basis are assembled here into a
single zero-argument conclusion.  The statement accepts no one-form carrier,
connection, spectrum, cutoff or normalization parameter.
-/

@[expose] public section

noncomputable section

open scoped BigOperators LinearPMap

namespace GeneratedFoundations.Geometry.SourceOneFormSystem

open SourceOneFormHaarBlock SourceOneFormHodgeLaplacian
open SourceOneFormCoclosedSpectrum SourceOneFormCompleteness
open SourceOneFormHilbertSum SourceOneFormClosedHodge
open SourceOneFormCurlSpectrum SourceOneFormSpectralCore

/-- The complete one-form differential system generated by the source. -/
structure Conclusions : Prop where
  complete_field_basis : finiteFieldCoreᗮ = ⊥
  field_expansion : ∀ A : OneFormL2,
    HasSum (fun a : FieldIndex =>
      inner ℂ (fieldBasisVector a) A • fieldBasisVector a) A
  hodge_selfAdjoint : IsSelfAdjoint closedHodge
  hodge_unique : ∀ S : coclosedField →ₗ.[ℂ] coclosedField,
    IsSelfAdjoint S → finiteHodge ≤ S → S = closedHodge
  hodge_domain : ∀ A : coclosedField,
    A ∈ closedHodge.domain ↔
      Summable (fun a : CoclosedIndex => eigenvalue a.val ^ 4 *
        ‖inner ℂ (coclosedHilbertBasis a) A‖ ^ 2)
  coclosed_lower_bound : ∀ a : CoclosedIndex, 4 ≤ eigenvalue a.val ^ 2
  complete_hilbert_sum :
    IsHilbertSum ℂ (fun r : RowIndex => FrameCarrier r.1.val) blockEmbedding

theorem generated : Conclusions where
  complete_field_basis := finiteFieldCore_orthogonal
  field_expansion := field_hasSum_expansion
  hodge_selfAdjoint := closedHodge_selfAdjoint
  hodge_unique := closedHodge_unique
  hodge_domain := closedHodge_domain
  coclosed_lower_bound := coclosed_eigenvalue_sq_ge_four
  complete_hilbert_sum := completeHilbertSum

end GeneratedFoundations.Geometry.SourceOneFormSystem
