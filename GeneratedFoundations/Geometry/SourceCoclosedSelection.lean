module

public import GeneratedFoundations.Correlation.Endpoints
public import GeneratedFoundations.Geometry.SourceFieldSpectrum
public import GeneratedFoundations.Geometry.SourceLeftRightRepresentations
public import Mathlib.Tactic.Linarith
public import Mathlib.Tactic.Positivity
public import Mathlib.Tactic.Ring
public meta import Lean.Elab.Tactic.Omega

/-!
# Canonical selection of the first coclosed source shells

The first symmetry shell and the next admissible odd shell are selected
from the actual common-source spectrum by leastness. Their representation
dimensions and Casimir are calculated. The endpoint ratio fixes the critical
coordinate; the unit-slope affine comparison then has a unique normalized
drive. These are common geometric statements, before any arithmetic or
physical choice of a matter representation or restoring action.
-/

@[expose] public section

noncomputable section

open GeneratedFoundations.Correlation.Endpoints
open GeneratedFoundations.Geometry.SourceLeftRightRepresentations
open GeneratedFoundations.Geometry.SourceFieldSpectrum

namespace GeneratedFoundations.Geometry.SourceCoclosedSelection

/-- Enumeration of all positive odd projective coclosed degrees. -/
def shellDegree (i : ℕ) : ℕ := 2 * i + 1

@[simp] theorem shellDegree_zero : shellDegree 0 = 1 := rfl

theorem shellDegree_positive (i : ℕ) : 1 ≤ shellDegree i := by
  simp [shellDegree]

theorem shellDegree_allowed (i : ℕ) : SourceFieldSpectrum.VectorDegree (shellDegree i) := by
  constructor
  · exact ⟨i, by simp [shellDegree, Nat.two_mul]⟩
  · exact shellDegree_positive i

local instance vectorDegreeDecidable : DecidablePred VectorDegree :=
  Classical.decPred _

/-- Degree one belongs to the generated projective coclosed vector spectrum. -/
theorem degree_one_isVectorDegree : VectorDegree 1 := by
  norm_num [VectorDegree]

theorem exists_vectorDegree : ∃ l : ℕ, VectorDegree l :=
  ⟨1, degree_one_isVectorDegree⟩

/-- The lowest symmetry shell is itself obtained as the least generated
coclosed vector degree.  No identification with Killing fields is used here. -/
def lowestSymmetryShellDegree : ℕ := Nat.find exists_vectorDegree

theorem lowestSymmetryShellDegree_spec :
    VectorDegree lowestSymmetryShellDegree :=
  Nat.find_spec exists_vectorDegree

theorem lowestSymmetryShellDegree_minimal {l : ℕ} (hl : VectorDegree l) :
    lowestSymmetryShellDegree ≤ l :=
  Nat.find_min' exists_vectorDegree hl

@[simp] theorem lowestSymmetryShellDegree_eq :
    lowestSymmetryShellDegree = 1 := by
  apply Nat.le_antisymm
  · exact lowestSymmetryShellDegree_minimal degree_one_isVectorDegree
  · exact lowestSymmetryShellDegree_spec.2

/-- Admissible long-root degrees are precisely generated coclosed vector
degrees lying strictly above the lowest symmetry shell. -/
def IsPostSymmetryCoclosedDegree (l : ℕ) : Prop :=
  VectorDegree l ∧ lowestSymmetryShellDegree < l

local instance postSymmetryCoclosedDegreeDecidable :
    DecidablePred IsPostSymmetryCoclosedDegree :=
  Classical.decPred _

theorem degree_three_isPostSymmetryCoclosedDegree :
    IsPostSymmetryCoclosedDegree 3 := by
  norm_num [IsPostSymmetryCoclosedDegree, lowestSymmetryShellDegree_eq,
    VectorDegree]

theorem exists_postSymmetryCoclosedDegree :
    ∃ l : ℕ, IsPostSymmetryCoclosedDegree l :=
  ⟨3, degree_three_isPostSymmetryCoclosedDegree⟩

/-- The long-root degree is generated by least deformation beyond the lowest
symmetry shell; it is not a separately selected integer. -/
def longRootDegree : ℕ := Nat.find exists_postSymmetryCoclosedDegree

theorem longRootDegree_spec :
    IsPostSymmetryCoclosedDegree longRootDegree :=
  Nat.find_spec exists_postSymmetryCoclosedDegree

theorem longRootDegree_minimal {l : ℕ}
    (hl : IsPostSymmetryCoclosedDegree l) :
    longRootDegree ≤ l :=
  Nat.find_min' exists_postSymmetryCoclosedDegree hl

/-- Oddness and strict separation from degree one force every admissible
degree to be at least three. -/
theorem three_le_of_postSymmetryCoclosedDegree {l : ℕ}
    (hl : IsPostSymmetryCoclosedDegree l) : 3 ≤ l := by
  rcases hl.1.1 with ⟨k, hk⟩
  have hlt : 1 < l := by
    simpa [lowestSymmetryShellDegree_eq] using hl.2
  omega

@[simp] theorem longRootDegree_eq : longRootDegree = 3 := by
  apply Nat.le_antisymm
  · exact longRootDegree_minimal degree_three_isPostSymmetryCoclosedDegree
  · exact three_le_of_postSymmetryCoclosedDegree longRootDegree_spec

/-- The least admissible post-symmetry coclosed degree is unique. -/
theorem longRootDegree_unique {l : ℕ}
    (hl : IsPostSymmetryCoclosedDegree l)
    (hleast : ∀ k : ℕ, IsPostSymmetryCoclosedDegree k → l ≤ k) :
    l = longRootDegree := by
  apply Nat.le_antisymm
  · exact hleast longRootDegree longRootDegree_spec
  · exact longRootDegree_minimal hl

/-- The generated long-root carrier is the positive vector branch at the
least admissible post-symmetry degree. -/
abbrev LongRootCarrier := VectorPlusCarrier longRootDegree

/-- The familiar bidegree `(4,2)` is an output of the least-degree
construction. -/
theorem longRootCarrier_eq_carrier_four_two :
    LongRootCarrier = Carrier 4 2 := by
  simp [LongRootCarrier, longRootDegree_eq, VectorPlusCarrier]

theorem longRoot_finrank : Module.finrank ℂ LongRootCarrier = 15 := by
  change Module.finrank ℂ
    (Carrier (longRootDegree + 1) (longRootDegree - 1)) = 15
  rw [carrier_finrank]
  norm_num [longRootDegree_eq]

/-- Its dimensionless Casimir is computed from the source representation. -/
def longRootCasimirIndex : ℝ :=
  casimirIndex (longRootDegree + 1) (longRootDegree - 1)

@[simp] theorem longRootCasimirIndex_eq : longRootCasimirIndex = 16 := by
  norm_num [longRootCasimirIndex, longRootDegree_eq, casimirIndex]

/-- The generated endpoint **ratio**, used as the internal critical radius.

This is `irEndpoint/uvEndpoint = sqrt(pi)`.  It is not an IR edge
(`sqrt(2*pi)`) and not the V5 finite-response TT endpoint `kL`; it is the
lower threshold of the condensed branch. -/
def criticalRadius : ℝ := Real.sqrt Real.pi

theorem criticalRadius_pos : 0 < criticalRadius := by
  exact Real.sqrt_pos.2 Real.pi_pos

theorem criticalRadius_ne_zero : criticalRadius ≠ 0 := criticalRadius_pos.ne'

/-- The critical radius is not an extra scale: it is the endpoint ratio of
every positive-width Gaussian source window. -/
theorem criticalRadius_eq_endpointRatio {b : ℝ} (hb : 0 < b) :
    criticalRadius = irEndpoint b / uvEndpoint b := by
  exact (endpoint_ratio hb).symm

/-- Radius-scaled eigenvalue of the actual source long-root carrier. -/
def longRootEigenvalue (L : ℝ) : ℝ := longRootCasimirIndex / L ^ 2

theorem longRootEigenvalue_eq (L : ℝ) :
    longRootEigenvalue L = 16 / L ^ 2 := by
  simp [longRootEigenvalue]

/-- The generated affine drive, normalized by its own long-root eigenvalue. -/
def longRootDrive (L : ℝ) : ℝ :=
  longRootEigenvalue L - longRootEigenvalue criticalRadius

theorem longRootDrive_eq (L : ℝ) :
    longRootDrive L = 16 * (L ^ (-2 : ℤ) - criticalRadius ^ (-2 : ℤ)) := by
  rw [longRootDrive, longRootEigenvalue_eq, longRootEigenvalue_eq]
  simp only [zpow_neg, zpow_ofNat]
  ring

@[simp] theorem longRootDrive_critical : longRootDrive criticalRadius = 0 := by
  simp [longRootDrive]

/-- Comparison class used for the affine-drive uniqueness statement. -/
def IsUnitSlopeAffineDrive (f : ℝ → ℝ) : Prop :=
  ∃ c : ℝ, ∀ L : ℝ, f L = longRootEigenvalue L + c

theorem longRootDrive_isUnitSlopeAffine :
    IsUnitSlopeAffineDrive longRootDrive := by
  refine ⟨-longRootEigenvalue criticalRadius, ?_⟩
  intro L
  simp only [longRootDrive]
  ring

/-- Within the generated affine comparison class, vanishing at the generated
critical radius uniquely fixes the drive. -/
theorem unitSlopeAffineDrive_unique {f : ℝ → ℝ}
    (hf : IsUnitSlopeAffineDrive f) (hcritical : f criticalRadius = 0) :
    f = longRootDrive := by
  obtain ⟨c, hc⟩ := hf
  funext L
  have hc0 := hc criticalRadius
  rw [hcritical] at hc0
  rw [hc L, longRootDrive]
  linarith

theorem longRootDrive_neg {L : ℝ} (hL : criticalRadius < L) :
    longRootDrive L < 0 := by
  have hLc : 0 < L := criticalRadius_pos.trans hL
  rw [longRootDrive, longRootEigenvalue_eq, longRootEigenvalue_eq]
  have hs : criticalRadius ^ 2 < L ^ 2 := by
    nlinarith [criticalRadius_pos, hLc]
  have hi : 1 / L ^ 2 < 1 / criticalRadius ^ 2 := by
    exact one_div_lt_one_div_of_lt (sq_pos_of_pos criticalRadius_pos) hs
  have hscaled : 16 / L ^ 2 < 16 / criticalRadius ^ 2 := by
    simpa only [div_eq_mul_inv, one_mul] using
      mul_lt_mul_of_pos_left hi (by norm_num : (0 : ℝ) < 16)
  exact sub_neg.mpr hscaled

structure Conclusions : Prop where
  first_shell : lowestSymmetryShellDegree = 1
  next_shell : longRootDegree = 3
  selected_dimension : Module.finrank ℂ LongRootCarrier = 15
  selected_casimir : longRootCasimirIndex = 16
  endpoint_origin : ∀ b, 0 < b → criticalRadius = irEndpoint b / uvEndpoint b
  normalized_drive : longRootDrive criticalRadius = 0
  unique_drive : ∀ f, IsUnitSlopeAffineDrive f → f criticalRadius = 0 →
    f = longRootDrive

theorem generated : Conclusions where
  first_shell := lowestSymmetryShellDegree_eq
  next_shell := longRootDegree_eq
  selected_dimension := longRoot_finrank
  selected_casimir := longRootCasimirIndex_eq
  endpoint_origin := fun _ hb => criticalRadius_eq_endpointRatio hb
  normalized_drive := longRootDrive_critical
  unique_drive := fun _ hf hz => unitSlopeAffineDrive_unique hf hz

end GeneratedFoundations.Geometry.SourceCoclosedSelection
