module

public import GeneratedFoundations.Geometry.SourceLeftRightAction
public import GeneratedFoundations.Geometry.SourcePolynomialCasimir
public import Mathlib.LinearAlgebra.TensorProduct.Finiteness
public import Mathlib.RepresentationTheory.Basic
public import Mathlib.Tactic.Module
public meta import Lean.Elab.Tactic.Omega

/-!
# Left--right representations generated by the common source

Both factors below are homogeneous powers of the same generated two-state
source representation.  Their tensor product therefore introduces neither
an external compact group nor an independently chosen representation table.
The dimensions, central characters and quadratic Casimir values are computed
from the already proved source symmetric-power identities.
-/

@[expose] public section

noncomputable section

open scoped TensorProduct
open GeneratedFoundations.Operations.SourceSpinCornerGroup
open GeneratedFoundations.Geometry.SourceSpinCentre
open GeneratedFoundations.Geometry.SourceSymmetricPowers
open GeneratedFoundations.Geometry.SourcePolynomialCasimir

namespace GeneratedFoundations.Geometry.SourceLeftRightRepresentations

abbrev SourcePair := SourceLeftRightAction.SourcePair

/-- The actual finite carrier of bidegree `(m,n)`. -/
abbrev Carrier (m n : ℕ) :=
  SourceSymmetricPowers.Carrier m ⊗[ℂ] SourceSymmetricPowers.Carrier n

/-- The first source factor acts on the first homogeneous power. -/
def leftRepresentation (m : ℕ) : Representation ℂ SourcePair
    (SourceSymmetricPowers.Carrier m) :=
  (sourceRepresentation m).comp (MonoidHom.fst SU2 SU2)

/-- The second source factor acts on the second homogeneous power. -/
def rightRepresentation (n : ℕ) : Representation ℂ SourcePair
    (SourceSymmetricPowers.Carrier n) :=
  (sourceRepresentation n).comp (MonoidHom.snd SU2 SU2)

/-- The left--right action is the tensor product of two generated source actions. -/
def representation (m n : ℕ) : Representation ℂ SourcePair (Carrier m n) :=
  (leftRepresentation m).tprod (rightRepresentation n)

theorem representation_apply (m n : ℕ) (p : SourcePair) :
    representation m n p =
      TensorProduct.map (sourceRepresentation m p.1) (sourceRepresentation n p.2) :=
  rfl

theorem carrier_finrank (m n : ℕ) :
    Module.finrank ℂ (Carrier m n) = (m + 1) * (n + 1) := by
  simp only [Carrier, Module.finrank_tensorProduct,
    SourceSymmetricPowers.carrier_finrank]

def leftCentral : SourcePair := (negativeIdentity, 1)
def rightCentral : SourcePair := (1, negativeIdentity)
def diagonalCentral : SourcePair := (negativeIdentity, negativeIdentity)

theorem representation_leftCentral_tmul (m n : ℕ)
    (x : SourceSymmetricPowers.Carrier m)
    (y : SourceSymmetricPowers.Carrier n) :
    representation m n leftCentral (x ⊗ₜ[ℂ] y) =
      (-1 : ℂ) ^ m • (x ⊗ₜ[ℂ] y) := by
  simp only [representation_apply, leftCentral,
    TensorProduct.map_tmul, map_one, Module.End.one_apply,
    sourceRepresentation_centre, TensorProduct.smul_tmul']

theorem representation_rightCentral_tmul (m n : ℕ)
    (x : SourceSymmetricPowers.Carrier m)
    (y : SourceSymmetricPowers.Carrier n) :
    representation m n rightCentral (x ⊗ₜ[ℂ] y) =
      (-1 : ℂ) ^ n • (x ⊗ₜ[ℂ] y) := by
  simp only [representation_apply, rightCentral,
    TensorProduct.map_tmul, map_one, Module.End.one_apply,
    sourceRepresentation_centre, TensorProduct.tmul_smul]

theorem representation_diagonalCentral_tmul (m n : ℕ)
    (x : SourceSymmetricPowers.Carrier m)
    (y : SourceSymmetricPowers.Carrier n) :
    representation m n diagonalCentral (x ⊗ₜ[ℂ] y) =
      ((-1 : ℂ) ^ (m + n)) • (x ⊗ₜ[ℂ] y) := by
  rw [representation_apply, TensorProduct.map_tmul]
  simp only [diagonalCentral, sourceRepresentation_centre,
    TensorProduct.smul_tmul', TensorProduct.tmul_smul, smul_smul, pow_add]
  rw [mul_comm]

theorem representation_leftCentral (m n : ℕ) :
    representation m n leftCentral =
      ((-1 : ℂ) ^ m) • (1 : Module.End ℂ (Carrier m n)) := by
  apply TensorProduct.ext'
  intro x y
  simpa only [LinearMap.smul_apply, Module.End.one_apply] using
    representation_leftCentral_tmul m n x y

theorem representation_rightCentral (m n : ℕ) :
    representation m n rightCentral =
      ((-1 : ℂ) ^ n) • (1 : Module.End ℂ (Carrier m n)) := by
  apply TensorProduct.ext'
  intro x y
  simpa only [LinearMap.smul_apply, Module.End.one_apply] using
    representation_rightCentral_tmul m n x y

theorem representation_diagonalCentral (m n : ℕ) :
    representation m n diagonalCentral =
      ((-1 : ℂ) ^ (m + n)) • (1 : Module.End ℂ (Carrier m n)) := by
  apply TensorProduct.ext'
  intro x y
  simpa only [LinearMap.smul_apply, Module.End.one_apply] using
    representation_diagonalCentral_tmul m n x y

theorem rightCentral_fixes_of_even (m : ℕ) {n : ℕ} (hn : Even n) :
    representation m n rightCentral = 1 := by
  rw [representation_rightCentral, hn.neg_one_pow, one_smul]

theorem rightCentral_negates_of_odd (m : ℕ) {n : ℕ} (hn : Odd n) :
    representation m n rightCentral =
      (-1 : ℂ) • (1 : Module.End ℂ (Carrier m n)) := by
  rw [representation_rightCentral, hn.neg_one_pow]

/-- The dimensionless left--right Casimir is one half of the two source
round Casimirs. -/
def casimirIndex (m n : ℕ) : ℝ :=
  ((m : ℝ) * ((m : ℝ) + 2) + (n : ℝ) * ((n : ℝ) + 2)) / 2

/-- The Casimir is built from the actual polynomial source operators. -/
def casimirOperator (m n : ℕ) : Module.End ℂ (Carrier m n) :=
  (1 / 2 : ℂ) •
    (TensorProduct.map (polynomialCasimir m) 1 +
      TensorProduct.map 1 (polynomialCasimir n))

theorem casimirOperator_tmul (m n : ℕ)
    (x : SourceSymmetricPowers.Carrier m)
    (y : SourceSymmetricPowers.Carrier n) :
    casimirOperator m n (x ⊗ₜ[ℂ] y) =
      (casimirIndex m n : ℂ) • (x ⊗ₜ[ℂ] y) := by
  change (1 / 2 : ℂ) •
      (((polynomialCasimir m x) ⊗ₜ[ℂ] y) +
        (x ⊗ₜ[ℂ] polynomialCasimir n y)) =
    (casimirIndex m n : ℂ) • (x ⊗ₜ[ℂ] y)
  rw [polynomialCasimir_apply, polynomialCasimir_apply,
    ← TensorProduct.smul_tmul', TensorProduct.tmul_smul, ← add_smul, smul_smul]
  congr 1
  simp only [casimirIndex, Complex.ofReal_div, Complex.ofReal_add,
    Complex.ofReal_mul, Complex.ofReal_natCast, Complex.ofReal_ofNat]
  ring

theorem casimirOperator_eq_scalar (m n : ℕ) :
    casimirOperator m n =
      (casimirIndex m n : ℂ) • (1 : Module.End ℂ (Carrier m n)) := by
  apply TensorProduct.ext'
  intro x y
  simpa only [LinearMap.smul_apply, Module.End.one_apply] using
    casimirOperator_tmul m n x y

/-- The full left--right family generated before any field-type selection.
This is the representation-theoretic output that can be attached to the root
construction without supplying a field table: every carrier is a tensor
product of two source powers, and its dimension, central characters and
Casimir are computed uniformly. -/
structure GeneratedFamilyProperties : Prop where
  dimension : ∀ m n,
    Module.finrank ℂ (Carrier m n) = (m + 1) * (n + 1)
  left_central : ∀ m n,
    representation m n leftCentral =
      ((-1 : ℂ) ^ m) • (1 : Module.End ℂ (Carrier m n))
  right_central : ∀ m n,
    representation m n rightCentral =
      ((-1 : ℂ) ^ n) • (1 : Module.End ℂ (Carrier m n))
  diagonal_central : ∀ m n,
    representation m n diagonalCentral =
      ((-1 : ℂ) ^ (m + n)) • (1 : Module.End ℂ (Carrier m n))
  casimir : ∀ m n,
    casimirOperator m n =
      (casimirIndex m n : ℂ) • (1 : Module.End ℂ (Carrier m n))

theorem generatedFamilyProperties : GeneratedFamilyProperties where
  dimension := carrier_finrank
  left_central := representation_leftCentral
  right_central := representation_rightCentral
  diagonal_central := representation_diagonalCentral
  casimir := casimirOperator_eq_scalar

/-- Equal bidegree is the unique source pair with total degree `2*l` and
zero left--right difference. -/
theorem scalar_bidegree_unique {m n l : ℕ}
    (hsum : m + n = 2 * l) (hbalance : m = n) :
    m = l ∧ n = l := by
  omega

/-- The positive one-form bidegree is forced by total degree and source-spin
difference two. -/
theorem vectorPlus_bidegree_unique {m n l : ℕ} (hl : 1 ≤ l)
    (hsum : m + n = 2 * l) (hdifference : m = n + 2) :
    m = l + 1 ∧ n = l - 1 := by
  omega

/-- The negative one-form branch is the exchanged unique solution. -/
theorem vectorMinus_bidegree_unique {m n l : ℕ} (hl : 1 ≤ l)
    (hsum : m + n = 2 * l) (hdifference : n = m + 2) :
    m = l - 1 ∧ n = l + 1 := by
  omega

/-- The positive transverse--traceless bidegree is forced by total degree and
source-spin difference four. -/
theorem ttPlus_bidegree_unique {m n k : ℕ} (hk : 2 ≤ k)
    (hsum : m + n = 2 * k) (hdifference : m = n + 4) :
    m = k + 2 ∧ n = k - 2 := by
  omega

/-- The negative transverse--traceless branch is the exchanged solution. -/
theorem ttMinus_bidegree_unique {m n k : ℕ} (hk : 2 ≤ k)
    (hsum : m + n = 2 * k) (hdifference : n = m + 4) :
    m = k - 2 ∧ n = k + 2 := by
  omega

/-- Adjacent positive spinor bidegree is the unique solution of odd total
degree and source-spin difference one. -/
theorem spinorPlus_bidegree_unique {m n k : ℕ}
    (hsum : m + n = 2 * k + 1) (hdifference : m = n + 1) :
    m = k + 1 ∧ n = k := by
  omega

/-- The opposite spinor branch is the exchanged unique solution. -/
theorem spinorMinus_bidegree_unique {m n k : ℕ}
    (hsum : m + n = 2 * k + 1) (hdifference : n = m + 1) :
    m = k ∧ n = k + 1 := by
  omega

/-- Scalar harmonics use equal source degrees. -/
abbrev ScalarCarrier (l : ℕ) := Carrier l l

/-- The two coclosed one-form branches are generated source bidegrees. -/
abbrev VectorPlusCarrier (l : ℕ) := Carrier (l + 1) (l - 1)
abbrev VectorMinusCarrier (l : ℕ) := Carrier (l - 1) (l + 1)

/-- The two TT branches are the bidegrees displaced by two. -/
abbrev TTPlusCarrier (k : ℕ) := Carrier (k + 2) (k - 2)
abbrev TTMinusCarrier (k : ℕ) := Carrier (k - 2) (k + 2)

/-- The two signed spinor branches are adjacent bidegrees. -/
abbrev SpinorPlusCarrier (k : ℕ) := Carrier (k + 1) k
abbrev SpinorMinusCarrier (k : ℕ) := Carrier k (k + 1)

theorem scalar_finrank (l : ℕ) :
    Module.finrank ℂ (ScalarCarrier l) = (l + 1) ^ 2 := by
  rw [carrier_finrank]
  ring

theorem vectorPlus_finrank {l : ℕ} (hl : 1 ≤ l) :
    Module.finrank ℂ (VectorPlusCarrier l) = l * (l + 2) := by
  rw [carrier_finrank]
  have hsub : l - 1 + 1 = l := Nat.sub_add_cancel hl
  have hadd : l + 1 + 1 = l + 2 := by omega
  rw [hsub, hadd]
  exact Nat.mul_comm _ _

theorem vectorMinus_finrank {l : ℕ} (hl : 1 ≤ l) :
    Module.finrank ℂ (VectorMinusCarrier l) = l * (l + 2) := by
  rw [carrier_finrank]
  have hsub : l - 1 + 1 = l := Nat.sub_add_cancel hl
  have hadd : l + 1 + 1 = l + 2 := by omega
  rw [hsub, hadd]

theorem ttPlus_finrank {k : ℕ} (hk : 2 ≤ k) :
    Module.finrank ℂ (TTPlusCarrier k) = (k - 1) * (k + 3) := by
  rw [carrier_finrank]
  have hsub : k - 2 + 1 = k - 1 := by omega
  have hadd : k + 2 + 1 = k + 3 := by omega
  rw [hsub, hadd]
  exact Nat.mul_comm _ _

theorem ttMinus_finrank {k : ℕ} (hk : 2 ≤ k) :
    Module.finrank ℂ (TTMinusCarrier k) = (k - 1) * (k + 3) := by
  rw [carrier_finrank]
  have hsub : k - 2 + 1 = k - 1 := by omega
  have hadd : k + 2 + 1 = k + 3 := by omega
  rw [hsub, hadd]

theorem spinorPlus_finrank (k : ℕ) :
    Module.finrank ℂ (SpinorPlusCarrier k) = (k + 1) * (k + 2) := by
  rw [carrier_finrank]
  have hadd : k + 1 + 1 = k + 2 := by omega
  rw [hadd]
  exact Nat.mul_comm _ _

theorem spinorMinus_finrank (k : ℕ) :
    Module.finrank ℂ (SpinorMinusCarrier k) = (k + 1) * (k + 2) := by
  rw [carrier_finrank]

theorem scalar_casimir (l : ℕ) :
    casimirIndex l l = (l : ℝ) * ((l : ℝ) + 2) := by
  simp only [casimirIndex]
  ring

theorem vectorPlus_casimir {l : ℕ} (hl : 1 ≤ l) :
    casimirIndex (l + 1) (l - 1) = ((l : ℝ) + 1) ^ 2 := by
  simp only [casimirIndex, Nat.cast_add, Nat.cast_one, Nat.cast_sub hl]
  ring

theorem vectorMinus_casimir {l : ℕ} (hl : 1 ≤ l) :
    casimirIndex (l - 1) (l + 1) = ((l : ℝ) + 1) ^ 2 := by
  simp only [casimirIndex, Nat.cast_add, Nat.cast_one, Nat.cast_sub hl]
  ring

theorem ttPlus_casimir {k : ℕ} (hk : 2 ≤ k) :
    casimirIndex (k + 2) (k - 2) = (k : ℝ) * ((k : ℝ) + 2) + 4 := by
  simp only [casimirIndex, Nat.cast_add, Nat.cast_ofNat, Nat.cast_sub hk]
  ring

theorem ttMinus_casimir {k : ℕ} (hk : 2 ≤ k) :
    casimirIndex (k - 2) (k + 2) = (k : ℝ) * ((k : ℝ) + 2) + 4 := by
  simp only [casimirIndex, Nat.cast_add, Nat.cast_ofNat, Nat.cast_sub hk]
  ring

theorem scalar_rightCentral {l : ℕ} (hl : Even l) :
    representation l l rightCentral = 1 :=
  rightCentral_fixes_of_even l hl

private theorem even_sub_one_of_odd {l : ℕ} (hl : Odd l) : Even (l - 1) := by
  obtain ⟨r, hr⟩ := hl
  refine ⟨r, ?_⟩
  omega

private theorem even_add_one_of_odd {l : ℕ} (hl : Odd l) : Even (l + 1) := by
  obtain ⟨r, hr⟩ := hl
  refine ⟨r + 1, ?_⟩
  omega

private theorem even_sub_two_of_even {k : ℕ} (hk : Even k) : Even (k - 2) := by
  obtain ⟨r, hr⟩ := hk
  refine ⟨r - 1, ?_⟩
  omega

private theorem even_add_two_of_even {k : ℕ} (hk : Even k) : Even (k + 2) := by
  obtain ⟨r, hr⟩ := hk
  refine ⟨r + 1, ?_⟩
  omega

theorem vectorPlus_rightCentral {l : ℕ} (hl : Odd l) :
    representation (l + 1) (l - 1) rightCentral = 1 :=
  rightCentral_fixes_of_even (l + 1) (even_sub_one_of_odd hl)

theorem vectorMinus_rightCentral {l : ℕ} (hl : Odd l) :
    representation (l - 1) (l + 1) rightCentral = 1 :=
  rightCentral_fixes_of_even (l - 1) (even_add_one_of_odd hl)

theorem ttPlus_rightCentral {k : ℕ} (hk : Even k) :
    representation (k + 2) (k - 2) rightCentral = 1 :=
  rightCentral_fixes_of_even (k + 2) (even_sub_two_of_even hk)

theorem ttMinus_rightCentral {k : ℕ} (hk : Even k) :
    representation (k - 2) (k + 2) rightCentral = 1 :=
  rightCentral_fixes_of_even (k - 2) (even_add_two_of_even hk)

theorem spinorPlus_rightCentral_of_even {k : ℕ} (hk : Even k) :
    representation (k + 1) k rightCentral = 1 :=
  rightCentral_fixes_of_even (k + 1) hk

theorem spinorMinus_rightCentral_of_odd {k : ℕ} (hk : Odd k) :
    representation k (k + 1) rightCentral = 1 :=
  rightCentral_fixes_of_even k (even_add_one_of_odd hk)

theorem spinorPlus_rightCentral_of_odd {k : ℕ} (hk : Odd k) :
    representation (k + 1) k rightCentral =
      (-1 : ℂ) • (1 : Module.End ℂ (SpinorPlusCarrier k)) :=
  rightCentral_negates_of_odd (k + 1) hk

theorem spinorMinus_rightCentral_of_even {k : ℕ} (hk : Even k) :
    representation k (k + 1) rightCentral =
      (-1 : ℂ) • (1 : Module.End ℂ (SpinorMinusCarrier k)) :=
  rightCentral_negates_of_odd k hk.add_one

end GeneratedFoundations.Geometry.SourceLeftRightRepresentations
