module

public import GeneratedFoundations.Analysis.PrimeCylinderDescent
public import Mathlib.Analysis.PSeries
public import Mathlib.Analysis.SpecialFunctions.Gaussian.GaussianIntegral
public import Mathlib.MeasureTheory.Integral.IntegralEqImproper
public import Mathlib.MeasureTheory.Integral.Lebesgue.Add

/-!
# Log-scale budget of the prime-cylinder central potential

The exact prime-cylinder update returns the old source at scale `L / p`.
After passage to logarithmic scale, this is translation by `-log p`.  The
weighted log-scale integral therefore receives the exact factor
`exp (-2 * sigma * log p)`.  This factor is generated by the same prime birth;
it is not a fitted damping coefficient.
-/

@[expose] public section

noncomputable section

open MeasureTheory
open scoped ENNReal

namespace GeneratedFoundations.Analysis.PrimeCylinderScaleBudget

open GeneratedFoundations.Arithmetic.JointOccupationScale
open CenterEndpointPotential PrimeCylinderDescent

/-- Positive scale parametrized by logarithmic coordinate. -/
def expScale (u : ℝ) : PositiveScale := ⟨Real.exp u, Real.exp_pos u⟩

theorem dividedScale_expScale (p : PrimeIndex) (u : ℝ) :
    dividedScale p (expScale u) = expScale (u - Real.log (p.1 : ℝ)) := by
  apply Subtype.ext
  change Real.exp u / (p.1 : ℝ) =
    Real.exp (u - Real.log (p.1 : ℝ))
  rw [Real.exp_sub, Real.exp_log (Nat.cast_pos.mpr p.2.pos)]

/-- The nonnegative center potential on logarithmic scale. -/
def potentialProfile (S : Finset PrimeIndex) (u : ℝ) : ℝ :=
  CentrePair.quadraticPotential (cylinderPair S (expScale u))

theorem potentialProfile_nonneg (S : Finset PrimeIndex) (u : ℝ) :
    0 ≤ potentialProfile S u := by
  apply CentrePair.quadraticPotential_nonneg
  simpa [potentialProfile] using (cylinderCapacity_pos S (expScale u)).le

theorem measurable_potentialProfile (S : Finset PrimeIndex) :
    Measurable (potentialProfile S) := by
  unfold potentialProfile CentrePair.quadraticPotential cylinderPair
    CentrePair.signed CentrePair.capacity cylinderCapacity cylinderAmplitude
    gaussianResponse ratio expScale label
  fun_prop

/-- The empty prime cylinder is the native Gaussian endpoint source itself. -/
theorem potentialProfile_empty (u : ℝ) :
    potentialProfile ∅ u = gaussianResponse (∅, expScale u) := by
  have hg : gaussianResponse (∅, expScale u) ≠ 0 :=
    (gaussianResponse_pos ∅ (expScale u)).ne'
  unfold potentialProfile CentrePair.quadraticPotential cylinderPair
    CentrePair.signed CentrePair.capacity cylinderCapacity cylinderAmplitude
  simp only [Finset.powerset_empty, Finset.sum_singleton]
  field_simp [hg]
  norm_num [centerCharacter]

/-- The positive-line Mellin density obtained from the empty-cylinder
Gaussian endpoint source. -/
def baseMellinDensity (sigma x : ℝ) : ℝ :=
  x ^ (sigma - 1) * (Real.exp (-x) - Real.exp (-Real.pi * x))

/-- The logarithmic base-budget integrand is the exponential pullback of its
positive-line Mellin density. -/
theorem baseBudgetIntegrand_eq (sigma u : ℝ) :
    Real.exp (-2 * sigma * u) * potentialProfile ∅ u =
      Real.exp (-2 * u) * baseMellinDensity sigma (Real.exp (-2 * u)) := by
  rw [potentialProfile_empty]
  unfold gaussianResponse ratio expScale label baseMellinDensity
  simp only [Finset.prod_empty, Nat.cast_one, one_div]
  have hexp : Real.exp (-2 * u) = (Real.exp u)⁻¹ ^ 2 := by
    rw [show -2 * u = -u + -u by ring, Real.exp_add, Real.exp_neg]
    ring
  rw [← hexp]
  have hrpow : Real.exp (-2 * u) ^ (sigma - 1) =
      Real.exp ((-2 * u) * (sigma - 1)) := by
    rw [Real.rpow_def_of_pos (Real.exp_pos _), Real.log_exp]
  rw [hrpow]
  have hcoef : Real.exp (-2 * sigma * u) =
      Real.exp (-2 * u) * Real.exp ((-2 * u) * (sigma - 1)) := by
    rw [← Real.exp_add]
    congr 1
    ring
  rw [hcoef]
  ring

theorem integrableOn_baseMellinDensity (sigma : ℝ) (hsigma : 0 < sigma) :
    IntegrableOn (baseMellinDensity sigma) (Set.Ioi 0) := by
  have hone : IntegrableOn
      (fun x : ℝ => x ^ (sigma - 1) * Real.exp (-1 * x ^ (1 : ℝ)))
      (Set.Ioi 0) :=
    integrableOn_rpow_mul_exp_neg_mul_rpow (by linarith) zero_lt_one zero_lt_one
  have hpi : IntegrableOn
      (fun x : ℝ => x ^ (sigma - 1) *
        Real.exp (-Real.pi * x ^ (1 : ℝ))) (Set.Ioi 0) :=
    integrableOn_rpow_mul_exp_neg_mul_rpow (by linarith) zero_lt_one Real.pi_pos
  exact (hone.sub hpi).congr_fun (fun x hx => by
    simp only [Pi.sub_apply, baseMellinDensity, Real.rpow_one, neg_one_mul,
      mul_sub]) measurableSet_Ioi

/-- Positive Mellin weight in logarithmic scale. -/
def logWeight (sigma u : ℝ) : ℝ≥0∞ :=
  ENNReal.ofReal (Real.exp (-2 * sigma * u))

theorem measurable_logWeight (sigma : ℝ) : Measurable (logWeight sigma) := by
  unfold logWeight
  fun_prop

/-- Extended nonnegative log-scale budget.  Its finiteness is a separate
analytic statement; the transport law below is valid before assuming it. -/
def potentialBudget (sigma : ℝ) (S : Finset PrimeIndex) : ℝ≥0∞ :=
  ∫⁻ u : ℝ, logWeight sigma u * ENNReal.ofReal (potentialProfile S u)

/-- The native Gaussian endpoint source has a finite weighted log-scale
budget.  Thus the uniform Euler bound below has a finite base value rather
than a merely formal extended-real right-hand side. -/
theorem potentialBudget_empty_lt_top (sigma : ℝ) (hsigma : 0 < sigma) :
    potentialBudget sigma ∅ < ∞ := by
  have hbase := integrableOn_baseMellinDensity sigma hsigma
  have hexp : Integrable (fun v : ℝ =>
      Real.exp v * baseMellinDensity sigma (Real.exp v)) := by
    simpa [smul_eq_mul] using
      (integrable_comp_exp (baseMellinDensity sigma)).2 hbase
  have hscaled : Integrable (fun u : ℝ =>
      Real.exp (-2 * u) * baseMellinDensity sigma (Real.exp (-2 * u))) := by
    simpa using hexp.comp_mul_left' (by norm_num : (-2 : ℝ) ≠ 0)
  have hreal : Integrable (fun u : ℝ =>
      Real.exp (-2 * sigma * u) * potentialProfile ∅ u) := by
    apply hscaled.congr
    exact ae_of_all _ fun u => (baseBudgetIntegrand_eq sigma u).symm
  have heq : ∀ u : ℝ,
      logWeight sigma u * ENNReal.ofReal (potentialProfile ∅ u) =
        ENNReal.ofReal
          (Real.exp (-2 * sigma * u) * potentialProfile ∅ u) := by
    intro u
    unfold logWeight
    rw [ENNReal.ofReal_mul (Real.exp_pos _).le]
  unfold potentialBudget
  simp_rw [heq]
  exact hreal.lintegral_lt_top

/-- Exact factor generated by returning one prime direction through the
weighted logarithmic scale. -/
def primeScaleFactor (sigma : ℝ) (p : PrimeIndex) : ℝ≥0∞ :=
  ENNReal.ofReal (Real.exp (-2 * sigma * Real.log (p.1 : ℝ)))

/-- Real-valued form of the scale return generated by one prime birth. -/
def primeReturn (sigma : ℝ) (p : PrimeIndex) : ℝ :=
  Real.exp (-2 * sigma * Real.log (p.1 : ℝ))

theorem primeReturn_nonneg (sigma : ℝ) (p : PrimeIndex) :
    0 ≤ primeReturn sigma p := (Real.exp_pos _).le

theorem primeReturn_eq_rpow (sigma : ℝ) (p : PrimeIndex) :
    primeReturn sigma p = (p.1 : ℝ) ^ (-2 * sigma) := by
  rw [primeReturn, Real.rpow_def_of_pos (Nat.cast_pos.mpr p.2.pos)]
  congr 1
  ring

/-- The return factors of all generated prime directions are summable exactly
in the half-plane selected by the quadratic scale weight. -/
theorem summable_primeReturn (sigma : ℝ) (hsigma : 1 / 2 < sigma) :
    Summable (primeReturn sigma) := by
  have hpow : Summable (fun p : Nat.Primes => (p.1 : ℝ) ^ (-2 * sigma)) :=
    (Real.summable_nat_rpow.mpr (by linarith)).subtype _
  exact hpow.congr (fun p => (primeReturn_eq_rpow sigma p).symm)

/-- All finite prime-return products lie below one common Euler budget.  The
bound is independent of the finite cylinder and therefore of generation
depth. -/
theorem primeScaleProduct_uniform (sigma : ℝ) (hsigma : 1 / 2 < sigma)
    (S : Finset PrimeIndex) :
    (∏ p ∈ S, (1 + primeScaleFactor sigma p) : ℝ≥0∞) ≤
      ENNReal.ofReal (Real.exp (∑' p : PrimeIndex, primeReturn sigma p)) := by
  have hs := summable_primeReturn sigma hsigma
  have hsum : (∑ p ∈ S, primeReturn sigma p) ≤
      ∑' p : PrimeIndex, primeReturn sigma p :=
    hs.sum_le_tsum S (fun p _hp => primeReturn_nonneg sigma p)
  have hfinite : ∀ T : Finset PrimeIndex,
      (∏ p ∈ T, (1 + primeReturn sigma p)) ≤
        Real.exp (∑ p ∈ T, primeReturn sigma p) := by
    intro T
    classical
    induction T using Finset.induction_on with
    | empty => simp
    | @insert p T hp ih =>
        rw [Finset.prod_insert hp, Finset.sum_insert hp, Real.exp_add]
        exact mul_le_mul
          (by simpa [add_comm] using Real.add_one_le_exp (primeReturn sigma p))
          ih
          (Finset.prod_nonneg fun q _hq =>
            add_nonneg zero_le_one (primeReturn_nonneg sigma q))
          (Real.exp_nonneg _)
  have hprod : (∏ p ∈ S, (1 + primeReturn sigma p)) ≤
      Real.exp (∑' p : PrimeIndex, primeReturn sigma p) :=
    (hfinite S).trans (Real.exp_le_exp.mpr hsum)
  calc
    (∏ p ∈ S, (1 + primeScaleFactor sigma p) : ℝ≥0∞) =
        ENNReal.ofReal (∏ p ∈ S, (1 + primeReturn sigma p)) := by
          rw [ENNReal.ofReal_prod_of_nonneg]
          · apply Finset.prod_congr rfl
            intro p hp
            rw [ENNReal.ofReal_add (by positivity) (primeReturn_nonneg sigma p)]
            simp [primeScaleFactor, primeReturn]
          · intro p hp
            exact add_nonneg zero_le_one (primeReturn_nonneg sigma p)
    _ ≤ ENNReal.ofReal
        (Real.exp (∑' p : PrimeIndex, primeReturn sigma p)) :=
      ENNReal.ofReal_le_ofReal hprod

theorem logWeight_shift (sigma a u : ℝ) :
    logWeight sigma u =
      logWeight sigma a * logWeight sigma (u - a) := by
  unfold logWeight
  rw [← ENNReal.ofReal_mul (Real.exp_pos _).le]
  congr 1
  rw [← Real.exp_add]
  congr 1
  ring

/-- Translation covariance of the weighted log-scale integral. -/
theorem weighted_lintegral_shift (sigma a : ℝ) (q : ℝ → ℝ≥0∞)
    (hq : Measurable q) :
    (∫⁻ u : ℝ, logWeight sigma u * q (u - a)) =
      logWeight sigma a * ∫⁻ u : ℝ, logWeight sigma u * q u := by
  have hshift :
      (∫⁻ u : ℝ, logWeight sigma (u - a) * q (u - a)) =
        ∫⁻ u : ℝ, logWeight sigma u * q u := by
    have hmp := measurePreserving_add_right volume (-a)
    have hmeas : Measurable (fun u : ℝ => logWeight sigma u * q u) :=
      (measurable_logWeight sigma).mul hq
    simpa [sub_eq_add_neg] using hmp.lintegral_comp hmeas
  calc
    (∫⁻ u : ℝ, logWeight sigma u * q (u - a)) =
        ∫⁻ u : ℝ, logWeight sigma a *
          (logWeight sigma (u - a) * q (u - a)) := by
            apply lintegral_congr
            intro u
            rw [logWeight_shift]
            ac_rfl
    _ = logWeight sigma a *
          ∫⁻ u : ℝ, logWeight sigma (u - a) * q (u - a) := by
            rw [lintegral_const_mul]
            exact ((measurable_logWeight sigma).comp
              (measurable_id.sub measurable_const)).mul
                (hq.comp (measurable_id.sub measurable_const))
    _ = logWeight sigma a *
          ∫⁻ u : ℝ, logWeight sigma u * q u := by rw [hshift]

/-- One genuine prime birth obeys a weighted scale-budget inequality with the
exact returned-scale factor. -/
theorem potentialBudget_insert_le (sigma : ℝ) (S : Finset PrimeIndex)
    (p : PrimeIndex) (hp : p ∉ S) :
    potentialBudget sigma (insert p S) ≤
      (1 + primeScaleFactor sigma p) * potentialBudget sigma S := by
  have hpoint : ∀ u : ℝ,
      logWeight sigma u * ENNReal.ofReal (potentialProfile (insert p S) u) ≤
        logWeight sigma u * ENNReal.ofReal (potentialProfile S u) +
        logWeight sigma u * ENNReal.ofReal
          (potentialProfile S (u - Real.log (p.1 : ℝ))) := by
    intro u
    have hpot := cylinderPotential_insert_le S p hp (expScale u)
    rw [dividedScale_expScale] at hpot
    have hpot' : potentialProfile (insert p S) u ≤
        potentialProfile S u +
          potentialProfile S (u - Real.log (p.1 : ℝ)) := by
      simpa [potentialProfile] using hpot
    have hmul : Real.exp (-2 * sigma * u) *
          potentialProfile (insert p S) u ≤
        Real.exp (-2 * sigma * u) * potentialProfile S u +
          Real.exp (-2 * sigma * u) *
            potentialProfile S (u - Real.log (p.1 : ℝ)) := by
      rw [← mul_add]
      exact mul_le_mul_of_nonneg_left hpot'
        (Real.exp_pos (-2 * sigma * u)).le
    have hleft : 0 ≤ Real.exp (-2 * sigma * u) * potentialProfile S u :=
      mul_nonneg (Real.exp_pos _).le (potentialProfile_nonneg S u)
    have hright : 0 ≤ Real.exp (-2 * sigma * u) *
        potentialProfile S (u - Real.log (p.1 : ℝ)) :=
      mul_nonneg (Real.exp_pos _).le
        (potentialProfile_nonneg S (u - Real.log (p.1 : ℝ)))
    unfold logWeight
    rw [← ENNReal.ofReal_mul (Real.exp_pos _).le,
      ← ENNReal.ofReal_mul (Real.exp_pos _).le,
      ← ENNReal.ofReal_mul (Real.exp_pos _).le,
      ← ENNReal.ofReal_add hleft hright]
    exact ENNReal.ofReal_le_ofReal hmul
  have hmono := lintegral_mono (μ := volume) hpoint
  have hmeas : Measurable (fun u : ℝ =>
      logWeight sigma u * ENNReal.ofReal (potentialProfile S u)) :=
    (measurable_logWeight sigma).mul
      (measurable_potentialProfile S).ennreal_ofReal
  have hadd :
      (∫⁻ u : ℝ,
          logWeight sigma u * ENNReal.ofReal (potentialProfile S u) +
          logWeight sigma u * ENNReal.ofReal
            (potentialProfile S (u - Real.log (p.1 : ℝ)))) =
        potentialBudget sigma S +
          ∫⁻ u : ℝ, logWeight sigma u * ENNReal.ofReal
            (potentialProfile S (u - Real.log (p.1 : ℝ))) := by
    rw [lintegral_add_left hmeas]
    rfl
  have hshift := weighted_lintegral_shift sigma (Real.log (p.1 : ℝ))
    (fun u => ENNReal.ofReal (potentialProfile S u))
    (measurable_potentialProfile S).ennreal_ofReal
  unfold potentialBudget at hmono ⊢
  rw [hadd] at hmono
  unfold primeScaleFactor
  rw [hshift] at hmono
  calc
    _ ≤ potentialBudget sigma S +
        ENNReal.ofReal (Real.exp (-2 * sigma * Real.log (p.1 : ℝ))) *
          potentialBudget sigma S := hmono
    _ = (1 + ENNReal.ofReal
          (Real.exp (-2 * sigma * Real.log (p.1 : ℝ)))) *
          potentialBudget sigma S := by
            rw [add_mul, one_mul]

/-- Iterating the genuine prime births retains the complete finite cylinder
and accumulates only their exact scale-return factors. -/
theorem potentialBudget_le_product (sigma : ℝ) (S : Finset PrimeIndex) :
    potentialBudget sigma S ≤
      potentialBudget sigma ∅ *
        (∏ p ∈ S, (1 + primeScaleFactor sigma p) : ℝ≥0∞) := by
  classical
  induction S using Finset.induction_on with
  | empty => simp
  | @insert p S hp ih =>
      calc
        potentialBudget sigma (insert p S) ≤
            (1 + primeScaleFactor sigma p) * potentialBudget sigma S :=
          potentialBudget_insert_le sigma S p hp
        _ ≤ (1 + primeScaleFactor sigma p) *
            (potentialBudget sigma ∅ *
              ∏ q ∈ S, (1 + primeScaleFactor sigma q)) :=
          by gcongr
        _ = potentialBudget sigma ∅ *
            ∏ q ∈ insert p S, (1 + primeScaleFactor sigma q) := by
          rw [Finset.prod_insert hp]
          ac_rfl

/-- Uniform finite-cylinder budget in every weight above the generated
half-density threshold. -/
theorem potentialBudget_uniform (sigma : ℝ) (hsigma : 1 / 2 < sigma)
    (S : Finset PrimeIndex) :
    potentialBudget sigma S ≤
      potentialBudget sigma ∅ *
        ENNReal.ofReal (Real.exp (∑' p : PrimeIndex, primeReturn sigma p)) := by
  calc
    potentialBudget sigma S ≤ potentialBudget sigma ∅ *
        (∏ p ∈ S, (1 + primeScaleFactor sigma p) : ℝ≥0∞) :=
      potentialBudget_le_product sigma S
    _ ≤ potentialBudget sigma ∅ *
        ENNReal.ofReal (Real.exp (∑' p : PrimeIndex, primeReturn sigma p)) := by
      exact mul_le_mul le_rfl (primeScaleProduct_uniform sigma hsigma S)
        bot_le bot_le

/-- The generated bound is genuinely finite for every finite prime cylinder
and every weight above one half. -/
theorem potentialBudget_uniform_lt_top (sigma : ℝ) (hsigma : 1 / 2 < sigma)
    (S : Finset PrimeIndex) : potentialBudget sigma S < ∞ := by
  apply lt_of_le_of_lt (potentialBudget_uniform sigma hsigma S)
  exact ENNReal.mul_lt_top
    (potentialBudget_empty_lt_top sigma (by linarith)) ENNReal.ofReal_lt_top

/-- Bundled log-scale prime budget. -/
structure ScaleBudgetConclusions : Prop where
  one_prime_budget : ∀ sigma S p, p ∉ S →
    potentialBudget sigma (insert p S) ≤
      (1 + primeScaleFactor sigma p) * potentialBudget sigma S
  finite_prime_product : ∀ sigma S,
    potentialBudget sigma S ≤
      potentialBudget sigma ∅ *
        (∏ p ∈ S, (1 + primeScaleFactor sigma p) : ℝ≥0∞)
  uniform_prime_budget : ∀ sigma, 1 / 2 < sigma → ∀ S,
    potentialBudget sigma S ≤
      potentialBudget sigma ∅ *
        ENNReal.ofReal (Real.exp (∑' p : PrimeIndex, primeReturn sigma p))
  finite_uniform_budget : ∀ sigma, 1 / 2 < sigma → ∀ S,
    potentialBudget sigma S < ∞

theorem conclusions : ScaleBudgetConclusions where
  one_prime_budget := potentialBudget_insert_le
  finite_prime_product := potentialBudget_le_product
  uniform_prime_budget := potentialBudget_uniform
  finite_uniform_budget := potentialBudget_uniform_lt_top

end GeneratedFoundations.Analysis.PrimeCylinderScaleBudget
