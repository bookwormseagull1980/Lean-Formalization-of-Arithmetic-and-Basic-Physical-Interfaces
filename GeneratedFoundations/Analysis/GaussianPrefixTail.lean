module

public import GeneratedFoundations.Analysis.GaussianWindowCapacity
public import Mathlib.Analysis.SpecificLimits.Basic

/-!
# Gaussian tails independent of the generation cutoff

The finite cardinal estimate is replaced by a geometric envelope beginning
at the actual first omitted natural label. The resulting capacity and signed
amplitude bounds are uniform in the complete prefix cutoff. The energy error
retains its visible--outside cross term.
-/

@[expose] public section

noncomputable section

open scoped BigOperators

namespace GeneratedFoundations.Analysis.GaussianPrefixTail

open GeneratedFoundations.Arithmetic.CompleteHistory
open GeneratedFoundations.Arithmetic.JointOccupationScale
open GeneratedMobiusObservation CanonicalMobiusReadout CanonicalEndpointLedger
open CenterEndpointPotential CapacityEnergyLedger MaximumPrimeFactorStage
open GaussianWindowCapacity

/-- Ratio of the geometric envelope generated by the first omitted label. -/
def tailRatio (L : PositiveScale) (K : ℕ) : ℝ :=
  Real.exp (-(K : ℝ) / L.1 ^ 2)

def tailBound (L : PositiveScale) (K : ℕ) : ℝ :=
  Real.exp (-(K : ℝ) ^ 2 / L.1 ^ 2) / (1 - tailRatio L K)

theorem tailRatio_nonneg (L : PositiveScale) (K : ℕ) : 0 ≤ tailRatio L K :=
  (Real.exp_pos _).le

theorem tailRatio_lt_one (L : PositiveScale) {K : ℕ} (hK : 0 < K) :
    tailRatio L K < 1 := by
  rw [tailRatio, Real.exp_lt_one_iff]
  exact div_neg_of_neg_of_pos (neg_neg_of_pos (Nat.cast_pos.mpr hK))
    (sq_pos_of_pos L.2)

theorem tailBound_nonneg (L : PositiveScale) {K : ℕ} (hK : 0 < K) :
    0 ≤ tailBound L K :=
  div_nonneg (Real.exp_pos _).le (sub_pos.mpr (tailRatio_lt_one L hK)).le

theorem weight_geometric_envelope (L : PositiveScale) {K n : ℕ}
    (hKn : K ≤ n) :
    gaussianWindowMass L.1 n ≤
      Real.exp (-(K : ℝ) ^ 2 / L.1 ^ 2) * tailRatio L K ^ (n - K) := by
  have hsub : ((n - K : ℕ) : ℝ) = (n : ℝ) - K := Nat.cast_sub hKn
  have hK0 : (0 : ℝ) ≤ K := Nat.cast_nonneg _
  have hnK : (K : ℝ) ≤ n := by exact_mod_cast hKn
  have hs : (K : ℝ) ^ 2 + (K : ℝ) * (n - K : ℕ) ≤ (n : ℝ) ^ 2 := by
    rw [hsub]
    nlinarith [mul_nonneg (sub_nonneg.mpr hnK) (Nat.cast_nonneg n)]
  calc
    gaussianWindowMass L.1 n ≤ Real.exp (-(n : ℝ) ^ 2 / L.1 ^ 2) := by
      calc
        _ ≤ gaussianRootMass 1 L.1 n := sub_le_self _ (Real.exp_nonneg _)
        _ = _ := by unfold gaussianRootMass; congr 1; ring
    _ ≤ Real.exp (-(K : ℝ) ^ 2 / L.1 ^ 2) * tailRatio L K ^ (n - K) := by
      rw [tailRatio, ← Real.exp_nat_mul, ← Real.exp_add]
      apply Real.exp_le_exp.mpr
      have hdiv := (div_le_div_iff_of_pos_right (sq_pos_of_pos L.2)).mpr hs
      convert neg_le_neg hdiv using 1 <;> ring

/-- A Gaussian sum over any finite set beyond `K` is bounded independently
of the size of that set. -/
theorem finite_tail_le (L : PositiveScale) {K : ℕ} (hK : 0 < K)
    (S : Finset ℕ) (hS : ∀ n ∈ S, K ≤ n) :
    ∑ n ∈ S, gaussianWindowMass L.1 n ≤ tailBound L K := by
  have hgeom := summable_geometric_of_lt_one
    (tailRatio_nonneg L K) (tailRatio_lt_one L hK)
  have hinj : ∀ a ∈ S, ∀ b ∈ S, a - K = b - K → a = b := by
    intro a ha b hb hab
    have := hS a ha
    have := hS b hb
    omega
  calc
    _ ≤ ∑ n ∈ S, Real.exp (-(K : ℝ) ^ 2 / L.1 ^ 2) *
        tailRatio L K ^ (n - K) :=
      Finset.sum_le_sum fun n hn => weight_geometric_envelope L (hS n hn)
    _ = Real.exp (-(K : ℝ) ^ 2 / L.1 ^ 2) *
        ∑ n ∈ S.image (fun n => n - K), tailRatio L K ^ n := by
      rw [Finset.sum_image hinj, Finset.mul_sum]
    _ ≤ Real.exp (-(K : ℝ) ^ 2 / L.1 ^ 2) *
        ∑' n : ℕ, tailRatio L K ^ n := by
      apply mul_le_mul_of_nonneg_left _ (Real.exp_pos _).le
      exact hgeom.sum_le_tsum _ (fun n _ => pow_nonneg (tailRatio_nonneg L K) n)
    _ = tailBound L K := by
      rw [tsum_geometric_of_lt_one (tailRatio_nonneg L K) (tailRatio_lt_one L hK)]
      rfl

theorem outside_label_ge_cutoff {R : ℝ} (hR : 0 ≤ R) (L : PositiveScale)
    (N : ℕ) {n : ℕ} (hn : n ∈ outsideLabels R L N) :
    windowCutoff R L ≤ n := by
  have hout := (mem_outsideLabels R L N n).mp hn |>.2
  have hedge : Real.sqrt R * L.1 ≤ (n : ℝ) := by
    exact le_of_not_gt (fun h => hout ((inWindow_iff_edge hR L n).mpr h))
  exact Nat.ceil_le.mpr hedge

/-- True squarefree outside capacity, with no cutoff-cardinality factor. -/
theorem outside_capacity_uniform {R : ℝ} (hR : 0 ≤ R) (L : PositiveScale)
    (hK : 0 < windowCutoff R L) (N : ℕ) :
    CentrePair.capacity (outsidePair R L N) ≤ tailBound L (windowCutoff R L) := by
  classical
  apply le_trans _ (finite_tail_le L hK (outsideLabels R L N)
    (fun _ hn => outside_label_ge_cutoff hR L N hn))
  unfold outsidePair sectorPairOn CentrePair.capacity
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_le_sum
  intro n hn
  have hw : 0 ≤ gaussianWindowMass L.1 n := endpointWeight_nonneg _ _
  by_cases hp : generatedMoebius n = 1
  · have hm : generatedMoebius n ≠ -1 := by omega
    simp [hp, hm]
  · by_cases hm : generatedMoebius n = -1
    · simp [hp, hm]
    · simp [hp, hm, hw]

theorem outside_amplitude_uniform {R : ℝ} (hR : 0 ≤ R) (L : PositiveScale)
    (hK : 0 < windowCutoff R L) (N : ℕ) :
    |canonicalOccupationAmplitude L N - CentrePair.signed (visiblePair R L N)| ≤
      tailBound L (windowCutoff R L) := by
  have hs := signed_reconstruction R L N
  have he : canonicalOccupationAmplitude L N -
      CentrePair.signed (visiblePair R L N) =
      CentrePair.signed (outsidePair R L N) := by linarith
  rw [he]
  exact (outside_signed_abs_le_capacity R L N).trans
    (outside_capacity_uniform hR L hK N)

theorem coherent_energy_uniform_error {R : ℝ} (hR : 0 ≤ R) (L : PositiveScale)
    (hK : 0 < windowCutoff R L) (N : ℕ) :
    |canonicalOccupationEnergy L N - coherentEnergy (visiblePair R L N)| ≤
      tailBound L (windowCutoff R L) ^ 2 +
        2 * |CentrePair.signed (visiblePair R L N)| * tailBound L (windowCutoff R L) := by
  have h := coherentEnergy_window_error R L N
  have hc := outside_capacity_uniform hR L hK N
  have hz := tailBound_nonneg L hK
  obtain ⟨hp, hm⟩ := sectorPairOn_nonnegative (gaussianWindowMass L.1)
    (outsideLabels R L N) (fun n _ => endpointWeight_nonneg _ _)
  have hcap : 0 ≤ CentrePair.capacity (outsidePair R L N) :=
    CentrePair.capacity_nonneg _ hp hm
  apply h.trans
  apply add_le_add
  · nlinarith
  · exact mul_le_mul_of_nonneg_left hc (by positivity)

structure Conclusions : Prop where
  capacity_tail : ∀ (R : ℝ), 0 ≤ R → ∀ L : PositiveScale,
    0 < windowCutoff R L → ∀ N,
      CentrePair.capacity (outsidePair R L N) ≤ tailBound L (windowCutoff R L)
  amplitude_tail : ∀ (R : ℝ), 0 ≤ R → ∀ L : PositiveScale,
    0 < windowCutoff R L → ∀ N,
      |canonicalOccupationAmplitude L N - CentrePair.signed (visiblePair R L N)| ≤
        tailBound L (windowCutoff R L)
  coherent_tail : ∀ (R : ℝ), 0 ≤ R → ∀ L : PositiveScale,
    0 < windowCutoff R L → ∀ N,
      |canonicalOccupationEnergy L N - coherentEnergy (visiblePair R L N)| ≤
        tailBound L (windowCutoff R L) ^ 2 +
          2 * |CentrePair.signed (visiblePair R L N)| * tailBound L (windowCutoff R L)

theorem conclusions : Conclusions where
  capacity_tail := fun _ hR L hK => outside_capacity_uniform hR L hK
  amplitude_tail := fun _ hR L hK => outside_amplitude_uniform hR L hK
  coherent_tail := fun _ hR L hK => coherent_energy_uniform_error hR L hK

end GeneratedFoundations.Analysis.GaussianPrefixTail
