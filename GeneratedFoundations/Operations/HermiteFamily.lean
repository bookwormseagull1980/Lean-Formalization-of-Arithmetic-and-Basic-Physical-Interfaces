module

public import GeneratedFoundations.Operations.GaussianLadderCore
public import Mathlib.Analysis.InnerProductSpace.Orthonormal

/-!
# The Hermite family generated by the Gaussian differential ladder

Every vector is constructed in Schwartz space by repeated application of the
actual raising differential operator to the normalized generated Gaussian.
Integration by parts and the differential commutator give the factorial norms
and orthogonality in Lebesgue `L²`. Normalization then yields the all-order
ladder relations. No abstract sequence-space model or orthogonality assumption
is used. Completeness and self-adjoint closure are separate statements.
-/

@[expose] public section

noncomputable section

open MeasureTheory
open scoped SchwartzMap ComplexConjugate
open GeneratedFoundations.Correlation.ComplexGaussianStates
open GeneratedFoundations.Operations.HermiteSource
open GeneratedFoundations.Operations.GaussianAffineLadder
open GeneratedFoundations.Operations.GaussianLadderCore

namespace GeneratedFoundations.Operations.HermiteFamily

def annihilation (b : ℝ) : Core →L[ℂ] Core := core b canonicalCoefficients

def creation (b : ℝ) : Core →L[ℂ] Core :=
  core b (formalCoefficients canonicalCoefficients)

theorem annihilation_apply (b : ℝ) (f : Core) (x : ℝ) :
    annihilation b f x = lowering b f x := by
  simp only [annihilation, core_apply, differential, canonicalCoefficients, lowering]
  ring

theorem creation_apply (b : ℝ) (f : Core) (x : ℝ) :
    creation b f x = raising b f x := by
  simp only [creation, core_apply, differential, formalCoefficients,
    canonicalCoefficients, map_inv₀, Complex.conj_ofReal, map_zero, raising]
  ring

theorem annihilation_ground {b : ℝ} (hb : 0 < b) :
    annihilation b (groundSchwartz hb) = 0 := by
  ext x
  rw [annihilation_apply, groundSchwartz_coe]
  exact congrFun (lowering_ground hb) x

theorem canonical_commutator {b : ℝ} (hb : 0 < b) (f : Core) :
    annihilation b (creation b f) - creation b (annihilation b f) = f := by
  have hs : (Real.sqrt 2 : ℂ) ^ 2 = 2 := by
    exact_mod_cast Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)
  have hc : canonicalCoefficients.c₁ * conj canonicalCoefficients.c₂ +
      canonicalCoefficients.c₂ * conj canonicalCoefficients.c₁ = 1 := by
    simp only [canonicalCoefficients, map_inv₀, Complex.conj_ofReal]
    calc
      (Real.sqrt 2 : ℂ)⁻¹ * (Real.sqrt 2 : ℂ)⁻¹ +
          (Real.sqrt 2 : ℂ)⁻¹ * (Real.sqrt 2 : ℂ)⁻¹ =
            2 * ((Real.sqrt 2 : ℂ) ^ 2)⁻¹ := by ring
      _ = 1 := by rw [hs]; norm_num
  simpa only [annihilation, creation, hc, one_smul] using
    core_commutator hb canonicalCoefficients f

theorem annihilation_creation {b : ℝ} (hb : 0 < b) (f : Core) :
    annihilation b (creation b f) = creation b (annihilation b f) + f := by
  exact (sub_eq_iff_eq_add.mp (canonical_commutator hb f)).trans (add_comm _ _)

theorem annihilation_adjoint (b : ℝ) (f g : Core) :
    inner ℂ (embedding (annihilation b f)) (embedding g) =
      inner ℂ (embedding f) (embedding (creation b g)) :=
  formal_adjoint_identity b canonicalCoefficients f g

theorem creation_adjoint (b : ℝ) (f g : Core) :
    inner ℂ (embedding (creation b f)) (embedding g) =
      inner ℂ (embedding f) (embedding (annihilation b g)) := by
  have h := formal_adjoint_identity b (formalCoefficients canonicalCoefficients) f g
  have hf : formalCoefficients (formalCoefficients canonicalCoefficients) =
      canonicalCoefficients := by simp [formalCoefficients, canonicalCoefficients]
  rw [hf] at h
  exact h

/-- The unnormalized family consists of actual Schwartz functions. -/
def raw {b : ℝ} (hb : 0 < b) : ℕ → Core
  | 0 => groundSchwartz hb
  | n + 1 => creation b (raw hb n)

@[simp] theorem raw_zero {b : ℝ} (hb : 0 < b) : raw hb 0 = groundSchwartz hb := rfl

@[simp] theorem raw_succ {b : ℝ} (hb : 0 < b) (n : ℕ) :
    raw hb (n + 1) = creation b (raw hb n) := rfl

theorem annihilation_raw_zero {b : ℝ} (hb : 0 < b) :
    annihilation b (raw hb 0) = 0 := annihilation_ground hb

theorem annihilation_raw_succ {b : ℝ} (hb : 0 < b) (n : ℕ) :
    annihilation b (raw hb (n + 1)) = (n + 1 : ℂ) • raw hb n := by
  induction n with
  | zero =>
      rw [raw_succ, annihilation_creation hb, annihilation_raw_zero, map_zero]
      simp
  | succ n ih =>
      rw [raw_succ, annihilation_creation hb, ih, map_smul]
      change (n + 1 : ℂ) • raw hb (n + 1) + raw hb (n + 1) = _
      simp only [Nat.cast_add, Nat.cast_one, add_smul, one_smul]

def number (b : ℝ) : Core →L[ℂ] Core := (creation b).comp (annihilation b)

theorem number_raw {b : ℝ} (hb : 0 < b) (n : ℕ) :
    number b (raw hb n) = (n : ℂ) • raw hb n := by
  cases n with
  | zero => simp [number, annihilation_ground]
  | succ n =>
      simp only [number, ContinuousLinearMap.comp_apply,
        annihilation_raw_succ, map_smul, Nat.cast_add, Nat.cast_one]
      rfl

theorem number_symmetric (b : ℝ) (f g : Core) :
    inner ℂ (embedding (number b f)) (embedding g) =
      inner ℂ (embedding f) (embedding (number b g)) := by
  change inner ℂ (embedding (creation b (annihilation b f))) (embedding g) = _
  rw [creation_adjoint, annihilation_adjoint]
  rfl

/-- Distinct degrees are orthogonal as Lebesgue `L²` functions. -/
theorem raw_inner_eq_zero {b : ℝ} (hb : 0 < b) {m n : ℕ} (hmn : m ≠ n) :
    inner ℂ (embedding (raw hb m)) (embedding (raw hb n)) = 0 := by
  have h := number_symmetric b (raw hb m) (raw hb n)
  simp only [number_raw, map_smul, inner_smul_left, inner_smul_right,
    map_natCast] at h
  have hn : (m : ℂ) - n ≠ 0 := sub_ne_zero.mpr (by exact_mod_cast hmn)
  apply (mul_eq_zero.mp ?_).resolve_left hn
  rw [sub_mul, h, sub_self]

/-- Integration by parts gives the factorial norm, rather than assuming it. -/
theorem raw_inner_self {b : ℝ} (hb : 0 < b) (n : ℕ) :
    inner ℂ (embedding (raw hb n)) (embedding (raw hb n)) = (n.factorial : ℂ) := by
  induction n with
  | zero =>
      rw [raw_zero, embedding_groundSchwartz, inner_self_eq_norm_sq_to_K, groundState_norm]
      norm_num
  | succ n ih =>
      calc
        inner ℂ (embedding (raw hb (n + 1))) (embedding (raw hb (n + 1))) =
            inner ℂ (embedding (raw hb n))
              (embedding (annihilation b (raw hb (n + 1)))) :=
          creation_adjoint b (raw hb n) (raw hb (n + 1))
        _ = (n + 1 : ℂ) * (n.factorial : ℂ) := by
          rw [annihilation_raw_succ, map_smul, inner_smul_right, ih]
        _ = ((n + 1).factorial : ℂ) := by rw [Nat.factorial_succ]; push_cast; rfl

def factorialRoot (n : ℕ) : ℝ := Real.sqrt (n.factorial : ℝ)

theorem factorialRoot_pos (n : ℕ) : 0 < factorialRoot n := by
  exact Real.sqrt_pos.mpr (by exact_mod_cast Nat.factorial_pos n)

theorem factorialRoot_sq (n : ℕ) : (factorialRoot n : ℂ) ^ 2 = (n.factorial : ℂ) := by
  change (Real.sqrt (n.factorial : ℝ) : ℂ) ^ 2 = (n.factorial : ℂ)
  exact_mod_cast Real.sq_sqrt (Nat.cast_nonneg n.factorial : (0 : ℝ) ≤ n.factorial)

theorem factorialRoot_succ (n : ℕ) :
    factorialRoot (n + 1) = Real.sqrt (n + 1 : ℝ) * factorialRoot n := by
  simp only [factorialRoot, Nat.factorial_succ, Nat.cast_mul, Nat.cast_add, Nat.cast_one]
  exact Real.sqrt_mul (by positivity) _

/-- Normalized Hermite functions retain their actual Schwartz representatives. -/
def hermite {b : ℝ} (hb : 0 < b) (n : ℕ) : Core :=
  ((factorialRoot n : ℂ)⁻¹) • raw hb n

def state {b : ℝ} (hb : 0 < b) (n : ℕ) : ComplexL2 := embedding (hermite hb n)

theorem state_coe {b : ℝ} (hb : 0 < b) (n : ℕ) :
    state hb n =ᵐ[volume] hermite hb n := (hermite hb n).coeFn_toLp 2 volume

theorem state_mem_core {b : ℝ} (hb : 0 < b) (n : ℕ) : state hb n ∈ coreDomain :=
  (coreEquiv (hermite hb n)).property

theorem state_inner_self {b : ℝ} (hb : 0 < b) (n : ℕ) :
    inner ℂ (state hb n) (state hb n) = 1 := by
  have hn : (factorialRoot n : ℂ) ≠ 0 := by exact_mod_cast (factorialRoot_pos n).ne'
  simp only [state, hermite, map_smul, inner_smul_left, inner_smul_right,
    map_inv₀, Complex.conj_ofReal, raw_inner_self]
  rw [← factorialRoot_sq n]
  field_simp [hn]

theorem state_inner_eq_zero {b : ℝ} (hb : 0 < b) {m n : ℕ} (hmn : m ≠ n) :
    inner ℂ (state hb m) (state hb n) = 0 := by
  simp only [state, hermite, map_smul, inner_smul_left, inner_smul_right,
    raw_inner_eq_zero hb hmn, mul_zero]

/-- The entire countable family is orthonormal in the generated Lebesgue space. -/
theorem state_orthonormal {b : ℝ} (hb : 0 < b) : Orthonormal ℂ (state hb) := by
  apply orthonormal_iff_ite.mpr
  intro m n
  split_ifs with h
  · subst n
    exact state_inner_self hb m
  · exact state_inner_eq_zero hb h

theorem creation_hermite {b : ℝ} (hb : 0 < b) (n : ℕ) :
    creation b (hermite hb n) = (Real.sqrt (n + 1 : ℝ) : ℂ) • hermite hb (n + 1) := by
  have hn : (Real.sqrt (n + 1 : ℝ) : ℂ) ≠ 0 := by
    exact_mod_cast (Real.sqrt_pos.mpr (by positivity : (0 : ℝ) < n + 1)).ne'
  simp only [hermite, map_smul, raw_succ, smul_smul, factorialRoot_succ,
    Complex.ofReal_mul, mul_inv_rev]
  congr 1
  field_simp [hn]

theorem annihilation_hermite_zero {b : ℝ} (hb : 0 < b) :
    annihilation b (hermite hb 0) = 0 := by
  simp only [hermite, map_smul, annihilation_raw_zero, smul_zero]

theorem annihilation_hermite_succ {b : ℝ} (hb : 0 < b) (n : ℕ) :
    annihilation b (hermite hb (n + 1)) =
      (Real.sqrt (n + 1 : ℝ) : ℂ) • hermite hb n := by
  have hn : (Real.sqrt (n + 1 : ℝ) : ℂ) ≠ 0 := by
    exact_mod_cast (Real.sqrt_pos.mpr (by positivity : (0 : ℝ) < n + 1)).ne'
  have hs : (Real.sqrt (n + 1 : ℝ) : ℂ) ^ 2 = (n + 1 : ℂ) := by
    exact_mod_cast Real.sq_sqrt (by positivity : (0 : ℝ) ≤ n + 1)
  simp only [hermite, map_smul, annihilation_raw_succ, smul_smul,
    factorialRoot_succ, Complex.ofReal_mul, mul_inv_rev]
  congr 1
  rw [← hs]
  field_simp [hn]

theorem number_hermite {b : ℝ} (hb : 0 < b) (n : ℕ) :
    number b (hermite hb n) = (n : ℂ) • hermite hb n := by
  simp only [hermite, map_smul, number_raw, smul_smul]
  congr 1
  ring

/-- The order-neutral differential generator has the half-shifted eigenvalues. -/
theorem symmetric_generator_hermite {b : ℝ} (hb : 0 < b) (n : ℕ) :
    (1 / 2 : ℂ) • (creation b (annihilation b (hermite hb n)) +
      annihilation b (creation b (hermite hb n))) =
        (n + 1 / 2 : ℂ) • hermite hb n := by
  rw [annihilation_creation hb]
  change (1 / 2 : ℂ) • (number b (hermite hb n) +
    (number b (hermite hb n) + hermite hb n)) = _
  rw [number_hermite, smul_add, smul_add, smul_smul,
    ← add_smul, ← add_smul]
  congr 1
  ring

@[simp] theorem hermite_zero {b : ℝ} (hb : 0 < b) :
    hermite hb 0 = groundSchwartz hb := by
  simp [hermite, factorialRoot]

@[simp] theorem state_zero {b : ℝ} (hb : 0 < b) : state hb 0 = groundState hb := by
  rw [state, hermite_zero, embedding_groundSchwartz]

/-- The first excited vector agrees with the previously derived two-state source. -/
theorem state_one {b : ℝ} (hb : 0 < b) : state hb 1 = firstState hb := by
  apply Lp.ext
  filter_upwards [state_coe hb 1, firstState_coe hb] with x hs hf
  rw [hs, hf]
  have h : hermite hb 1 = creation b (groundSchwartz hb) := by
    simp [hermite, factorialRoot, raw]
  rw [h, creation_apply, groundSchwartz_coe]
  exact congrFun (raising_ground hb) x

theorem hilbert_annihilation_state_zero {b : ℝ} (hb : 0 < b) :
    liftCore (annihilation b) (coreEquiv (hermite hb 0)) = 0 := by
  rw [liftCore_coreEquiv, annihilation_hermite_zero, map_zero]

theorem hilbert_annihilation_state_succ {b : ℝ} (hb : 0 < b) (n : ℕ) :
    liftCore (annihilation b) (coreEquiv (hermite hb (n + 1))) =
      (Real.sqrt (n + 1 : ℝ) : ℂ) • state hb n := by
  rw [liftCore_coreEquiv, annihilation_hermite_succ, map_smul]
  rfl

/-- The all-order relation also holds for the actual maximal adjoint on its core. -/
theorem hilbert_adjoint_state {b : ℝ} (hb : 0 < b) (n : ℕ) :
    (liftCore (annihilation b)).adjoint
      (adjointCorePoint b canonicalCoefficients (hermite hb n)) =
        (Real.sqrt (n + 1 : ℝ) : ℂ) • state hb (n + 1) := by
  change (liftCore (core b canonicalCoefficients)).adjoint
    (adjointCorePoint b canonicalCoefficients (hermite hb n)) = _
  rw [adjoint_on_core]
  change embedding (creation b (hermite hb n)) = _
  rw [creation_hermite, map_smul]
  rfl

end GeneratedFoundations.Operations.HermiteFamily
