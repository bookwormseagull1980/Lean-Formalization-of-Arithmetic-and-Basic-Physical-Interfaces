module

public import GeneratedFoundations.Operations.SourceSpinCornerGroup
public import Mathlib.Analysis.InnerProductSpace.TensorProduct
public import Mathlib.Analysis.Normed.Lp.Matrix
public import Mathlib.Tactic.LinearCombination

/-!
# Vacuum transport on the Gaussian source carrier

The determinant line is the line generated by the normalized alternating
tensor of the two actual Gaussian modes. Its action is computed from the
tensor square of the same source operator. Tensoring with this line gives
a unitary source intertwiner, unique up to phase. The determinant factor
is retained for arbitrary matrices; it disappears only on the special
unitary subgroup.

An identification with a right-frame carrier requires specified unitary
maps of the determinant and spin factors. No identification of independently
chosen frame bundles is asserted here.
-/

@[expose] public section

noncomputable section

open scoped TensorProduct ComplexConjugate
open GeneratedFoundations.Correlation.ComplexGaussianStates
open GeneratedFoundations.Operations.HermiteSource
open GeneratedFoundations.Operations.SourceSpinCorner
open GeneratedFoundations.Operations.SourceSpinCornerGroup

namespace GeneratedFoundations.Operations.SourceVacuumTransport

variable {b : ℝ} (hb : 0 < b)

abbrev V := sourceSpace hb
abbrev TensorSquare := V hb ⊗[ℂ] V hb

instance tensorSquareNormedAddCommGroup : NormedAddCommGroup (TensorSquare hb) :=
  TensorProduct.instNormedAddCommGroup

instance tensorSquareInnerProductSpace : InnerProductSpace ℂ (TensorSquare hb) :=
  TensorProduct.instInnerProductSpace

/-- The ordered basis is the original Gaussian vacuum and its first excitation. -/
def basisVector (i : Fin 2) : V hb :=
  (sourceCoordinates hb).symm (WithLp.toLp 2 (Pi.single i 1))

theorem sourceCoordinates_symm_coe (v : Coordinates) :
    ((sourceCoordinates hb).symm v : ComplexL2) = synthesis hb v := rfl

@[simp] theorem basisVector_coordinates (i j : Fin 2) :
    sourceCoordinates hb (basisVector hb i) j = if j = i then 1 else 0 := by
  simp [basisVector]

@[simp] theorem basisVector_zero_coe :
    (basisVector hb 0 : ComplexL2) = groundState hb := by
  rw [basisVector, sourceCoordinates_symm_coe]
  simp [synthesis]

@[simp] theorem basisVector_one_coe :
    (basisVector hb 1 : ComplexL2) = firstState hb := by
  rw [basisVector, sourceCoordinates_symm_coe]
  simp [synthesis]

@[simp] theorem basisVector_inner (i j : Fin 2) :
    inner ℂ (basisVector hb i) (basisVector hb j) = if i = j then 1 else 0 := by
  rw [← (sourceCoordinates hb).inner_map_map]
  fin_cases i <;> fin_cases j <;>
    simp [basisVector, PiLp.inner_apply, RCLike.inner_apply]

@[simp] theorem basisVector_norm (i : Fin 2) : ‖basisVector hb i‖ = 1 := by
  rw [← (sourceCoordinates hb).norm_map]
  simp [basisVector]

theorem basisVector_decomposition (v : V hb) :
    v = (sourceCoordinates hb v) 0 • basisVector hb 0 +
      (sourceCoordinates hb v) 1 • basisVector hb 1 := by
  apply (sourceCoordinates hb).injective
  ext i
  fin_cases i <;> simp

/-- Matrix coordinates of the already constructed Gaussian corner. -/
def sourceActionEquiv : Mat2 ≃ₐ[ℂ] Module.End ℂ (V hb) :=
  (Matrix.toLpLinAlgEquiv 2).trans
    ((sourceCoordinates hb).symm.toLinearEquiv.conjAlgEquiv ℂ)

abbrev sourceAction (M : Mat2) := sourceActionEquiv hb M

theorem sourceAction_coordinates (M : Mat2) (v : V hb) :
    sourceCoordinates hb (sourceAction hb M v) =
      WithLp.toLp 2 (M.mulVec (fun i => sourceCoordinates hb v i)) := by
  change sourceCoordinates hb ((sourceCoordinates hb).symm
    (WithLp.toLp 2 (M.mulVec (fun i => sourceCoordinates hb v i)))) = _
  exact (sourceCoordinates hb).apply_symm_apply _

theorem sourceAction_basis (M : Mat2) (j : Fin 2) :
    sourceAction hb M (basisVector hb j) =
      M 0 j • basisVector hb 0 + M 1 j • basisVector hb 1 := by
  apply (sourceCoordinates hb).injective
  ext i
  rw [sourceAction_coordinates]
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mulVec, dotProduct]

/-- The action is the restriction of the original rank-one Gaussian corner. -/
theorem sourceAction_coe (M : Mat2) (v : V hb) :
    (sourceAction hb M v : ComplexL2) = corner hb M v := by
  obtain ⟨c, rfl⟩ := (sourceCoordinates hb).symm.surjective v
  have h := sourceAction_coordinates hb M ((sourceCoordinates hb).symm c)
  have he := congrArg (sourceCoordinates hb).symm h
  simp only [LinearIsometryEquiv.symm_apply_apply,
    LinearIsometryEquiv.apply_symm_apply] at he
  rw [he, sourceCoordinates_symm_coe, sourceCoordinates_symm_coe, corner_synthesis]

theorem sourceAction_control (M : Mat2) (v : V hb) :
    (sourceAction hb M v : ComplexL2) = control hb M v := by
  rw [sourceAction_coe]
  simp only [GeneratedFoundations.Operations.SourceSpinCorner.control, add_apply, sub_apply,
    one_apply_eq_self, (projection_eq_self_iff hb v).mpr v.property,
    sub_self, zero_add]

theorem sourceAction_norm (M : Mat2) (hM : M ∈ Matrix.unitaryGroup (Fin 2) ℂ)
    (v : V hb) : ‖sourceAction hb M v‖ = ‖v‖ := by
  change ‖(sourceAction hb M v : ComplexL2)‖ = ‖(v : ComplexL2)‖
  rw [sourceAction_control]
  exact (control hb M).norm_map_of_mem_unitary (control_mem_unitary hb M hM) v

def rawAlternating : TensorSquare hb :=
  basisVector hb 0 ⊗ₜ[ℂ] basisVector hb 1 -
    basisVector hb 1 ⊗ₜ[ℂ] basisVector hb 0

theorem rawAlternating_inner :
    inner ℂ (rawAlternating hb) (rawAlternating hb) = 2 := by
  simp only [rawAlternating, inner_sub_left, inner_sub_right, TensorProduct.inner_tmul,
    basisVector_inner]
  norm_num

theorem rawAlternating_ne_zero : rawAlternating hb ≠ 0 := by
  intro hz
  have h := rawAlternating_inner hb
  rw [hz, inner_zero_left] at h
  norm_num at h

def omega : TensorSquare hb :=
  ((‖rawAlternating hb‖ : ℂ)⁻¹) • rawAlternating hb

theorem omega_norm : ‖omega hb‖ = 1 := by
  have hn : ‖rawAlternating hb‖ ≠ 0 := norm_ne_zero_iff.mpr (rawAlternating_ne_zero hb)
  simp [omega, norm_smul, Complex.norm_real, hn]

theorem omega_ne_zero : omega hb ≠ 0 := by
  intro hz
  have h := omega_norm hb
  rw [hz, norm_zero] at h
  norm_num at h

theorem omega_alternating :
    TensorProduct.comm ℂ (V hb) (V hb) (omega hb) = -omega hb := by
  simp [omega, rawAlternating, TensorProduct.comm_tmul, map_smul, map_sub,
    ← smul_neg, neg_sub]

/-- Determinant covariance follows from the actual tensor-square action. -/
theorem tensorSquare_rawAlternating (M : Mat2) :
    TensorProduct.map (sourceAction hb M) (sourceAction hb M) (rawAlternating hb) =
      M.det • rawAlternating hb := by
  simp only [rawAlternating, map_sub, TensorProduct.map_tmul, sourceAction_basis,
    TensorProduct.add_tmul, TensorProduct.tmul_add, TensorProduct.smul_tmul,
    TensorProduct.tmul_smul, Matrix.det_fin_two]
  module

theorem tensorSquare_omega (M : Mat2) :
    TensorProduct.map (sourceAction hb M) (sourceAction hb M) (omega hb) =
      M.det • omega hb := by
  simp only [omega, map_smul, tensorSquare_rawAlternating, smul_smul]
  congr 1
  ring

def omegaEmbedding : ℂ →ₗᵢ[ℂ] TensorSquare hb where
  toLinearMap := LinearMap.toSpanSingleton ℂ _ (omega hb)
  norm_map' z := by
    change ‖z • omega hb‖ = ‖z‖
    rw [norm_smul, omega_norm, mul_one]

/-- A subspace of the source tensor square, with its inherited Hilbert norm. -/
abbrev DeterminantLine := LinearMap.range (omegaEmbedding hb).toLinearMap

def determinantCoordinate : ℂ ≃ₗᵢ[ℂ] DeterminantLine hb :=
  (omegaEmbedding hb).equivRange

def determinantVector : DeterminantLine hb := determinantCoordinate hb 1

@[simp] theorem determinantCoordinate_coe (z : ℂ) :
    (determinantCoordinate hb z : TensorSquare hb) = z • omega hb := rfl

@[simp] theorem determinantVector_coe :
    (determinantVector hb : TensorSquare hb) = omega hb := by
  simp [determinantVector]

theorem determinantLine_finrank : Module.finrank ℂ (DeterminantLine hb) = 1 := by
  rw [← (determinantCoordinate hb).toLinearEquiv.finrank_eq]
  exact Module.finrank_self ℂ

def determinantAction (M : Mat2) : Module.End ℂ (DeterminantLine hb) :=
  M.det • LinearMap.id

theorem determinantAction_coe (M : Mat2) (w : DeterminantLine hb) :
    (determinantAction hb M w : TensorSquare hb) =
      TensorProduct.map (sourceAction hb M) (sourceAction hb M) w := by
  obtain ⟨z, rfl⟩ := (determinantCoordinate hb).surjective w
  simp [determinantAction, determinantCoordinate_coe, map_smul,
    tensorSquare_omega, smul_smul, mul_comm]

abbrev TwistedCarrier := DeterminantLine hb ⊗[ℂ] V hb

instance twistedCarrierNormedAddCommGroup : NormedAddCommGroup (TwistedCarrier hb) :=
  TensorProduct.instNormedAddCommGroup

instance twistedCarrierInnerProductSpace : InnerProductSpace ℂ (TwistedCarrier hb) :=
  TensorProduct.instInnerProductSpace

def twistedAction (M : Mat2) : Module.End ℂ (TwistedCarrier hb) :=
  TensorProduct.map (determinantAction hb M) (sourceAction hb M)

/-- The normalized alternating tensor determines the transport; no target
isomorphism is assumed. -/
def transport : V hb ≃ₗᵢ[ℂ] TwistedCarrier hb :=
  (TensorProduct.lidIsometry ℂ (V hb)).symm.trans
    ((determinantCoordinate hb).rTensor (V hb))

theorem transport_apply (v : V hb) :
    transport hb v = determinantVector hb ⊗ₜ[ℂ] v := rfl

/-- Conjugation transports the original source action without inserting a
determinant character. -/
def conjugatedAction (M : Mat2) : Module.End ℂ (TwistedCarrier hb) :=
  (transport hb).toLinearEquiv.conjAlgEquiv ℂ (sourceAction hb M)

theorem conjugatedAction_apply (M : Mat2) (w : TwistedCarrier hb) :
    conjugatedAction hb M w =
      transport hb (sourceAction hb M ((transport hb).symm w)) := rfl

theorem conjugatedAction_transport (M : Mat2) (v : V hb) :
    conjugatedAction hb M (transport hb v) = transport hb (sourceAction hb M v) := by
  rw [conjugatedAction_apply, LinearIsometryEquiv.symm_apply_apply]

theorem twistedAction_transport (M : Mat2) (v : V hb) :
    twistedAction hb M (transport hb v) = M.det • transport hb (sourceAction hb M v) := by
  simp [twistedAction, transport_apply, determinantAction, TensorProduct.smul_tmul]

/-- Tensoring the source action with its determinant line differs from
conjugation by the determinant factor. These actions agree on SU(2), but
need not agree on a source number flow in U(2). -/
theorem twistedAction_eq_det_smul_conjugatedAction (M : Mat2) :
    twistedAction hb M = M.det • conjugatedAction hb M := by
  apply LinearMap.ext
  intro w
  obtain ⟨v, rfl⟩ := (transport hb).surjective w
  simp only [LinearMap.smul_apply, twistedAction_transport, conjugatedAction_transport]

theorem transport_intertwines (U : SU2) (v : V hb) :
    transport hb (sourceAction hb (U : Mat2) v) =
      twistedAction hb (U : Mat2) (transport hb v) := by
  rw [twistedAction_transport]
  have hd : (U : Mat2).det = 1 := (Matrix.mem_specialUnitaryGroup_iff.mp U.property).2
  rw [hd, one_smul]

theorem twistedAction_norm (U : SU2) (v : TwistedCarrier hb) :
    ‖twistedAction hb (U : Mat2) v‖ = ‖v‖ := by
  obtain ⟨w, rfl⟩ := (transport hb).surjective v
  rw [← transport_intertwines, (transport hb).norm_map, (transport hb).norm_map]
  exact sourceAction_norm hb _ (Matrix.mem_specialUnitaryGroup_iff.mp U.property).1 w

def transportedVacuum : TwistedCarrier hb := transport hb (basisVector hb 0)

theorem transportedVacuum_apply :
    transportedVacuum hb = determinantVector hb ⊗ₜ[ℂ] basisVector hb 0 := rfl

theorem transportedVacuum_norm : ‖transportedVacuum hb‖ = 1 := by
  rw [transportedVacuum, (transport hb).norm_map, basisVector_norm]

/-- Annihilation selects precisely the line whose image is the transported
Gaussian vacuum. -/
theorem transported_vacuum_line (v : V hb) :
    compressedLowering hb v = 0 ↔
      ∃ z : ℂ, transport hb v = z • transportedVacuum hb := by
  rw [source_vacuum_line hb v v.property]
  constructor
  · rintro ⟨z, hz⟩
    refine ⟨z, ?_⟩
    have he : v = z • basisVector hb 0 := by
      apply Subtype.ext
      simpa only [Submodule.coe_smul, basisVector_zero_coe] using hz
    rw [he, map_smul]
    rfl
  · rintro ⟨z, hz⟩
    refine ⟨z, ?_⟩
    have he : v = z • basisVector hb 0 :=
      (transport hb).injective (hz.trans (map_smul (transport hb) z _).symm)
    have hc := congrArg (fun w : V hb => (w : ComplexL2)) he
    simpa only [Submodule.coe_smul, basisVector_zero_coe] using hc

theorem sourceAction_scalar (z : ℂ) (v : V hb) :
    sourceAction hb (z • (1 : Mat2)) v = z • v := by
  simp only [sourceAction, map_smul, map_one, LinearMap.smul_apply,
    Module.End.one_apply]

/-- The determinant twist is visible on the full unitary centre: its tensor
weight is three, whereas the source spin weight is one. -/
theorem twistedAction_scalar (z : ℂ) (v : TwistedCarrier hb) :
    twistedAction hb (z • (1 : Mat2)) v = z ^ 3 • v := by
  obtain ⟨w, rfl⟩ := (transport hb).surjective v
  rw [twistedAction_transport, sourceAction_scalar, map_smul]
  have hd : Matrix.det (z • (1 : Mat2)) = z ^ 2 := by
    simp [pow_two]
  rw [hd, smul_smul]
  congr 1

private def diagonalSource : SU2 :=
  ⟨canonical Complex.I 0, canonical_mem_specialUnitary _ _ (by norm_num)⟩

private def exchangeSource : SU2 :=
  ⟨canonical 0 1, canonical_mem_specialUnitary _ _ (by norm_num)⟩

/-- Commutation with two generated source operations already forces a
complex-linear source endomorphism to be scalar. -/
theorem source_commutant_scalar (T : Module.End ℂ (V hb))
    (hT : ∀ (U : SU2) (v : V hb),
      T (sourceAction hb (U : Mat2) v) = sourceAction hb (U : Mat2) (T v)) :
    ∃ z : ℂ, ∀ v : V hb, T v = z • v := by
  let M := (sourceActionEquiv hb).symm T
  have hcomm (U : SU2) : M * (U : Mat2) = (U : Mat2) * M := by
    apply (sourceActionEquiv hb).injective
    simp only [map_mul, M, AlgEquiv.apply_symm_apply]
    exact LinearMap.ext (hT U)
  have h01 := congrArg (fun A : Mat2 => A 0 1) (hcomm diagonalSource)
  have h10 := congrArg (fun A : Mat2 => A 1 0) (hcomm diagonalSource)
  simp [diagonalSource, canonical, Matrix.mul_apply, Fin.sum_univ_two] at h01 h10
  have hm01 : M 0 1 = 0 := by
    apply mul_left_cancel₀ (show (2 : ℂ) * Complex.I ≠ 0 by norm_num)
    linear_combination -h01
  have hm10 : M 1 0 = 0 := by
    apply mul_left_cancel₀ (show (2 : ℂ) * Complex.I ≠ 0 by norm_num)
    linear_combination h10
  have hd := congrArg (fun A : Mat2 => A 0 1) (hcomm exchangeSource)
  have hm11 : M 0 0 = M 1 1 := by
    simpa [exchangeSource, canonical, Matrix.mul_apply, Fin.sum_univ_two] using hd
  have hm : M = M 0 0 • (1 : Mat2) := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp [hm01, hm10, hm11]
  refine ⟨M 0 0, fun v => ?_⟩
  have he : T = sourceAction hb (M 0 0 • (1 : Mat2)) := by
    rw [← hm]
    exact ((sourceActionEquiv hb).apply_symm_apply T).symm
  rw [he, sourceAction_scalar]

/-- The scalar in the source commutant classification is itself unique. -/
theorem source_commutant_scalar_unique (T : Module.End ℂ (V hb))
    (hT : ∀ (U : SU2) (v : V hb),
      T (sourceAction hb (U : Mat2) v) = sourceAction hb (U : Mat2) (T v)) :
    ∃! z : ℂ, ∀ v : V hb, T v = z • v := by
  obtain ⟨z, hz⟩ := source_commutant_scalar hb T hT
  refine ⟨z, hz, ?_⟩
  intro w hw
  have hvec : z • basisVector hb 0 = w • basisVector hb 0 :=
    (hz (basisVector hb 0)).symm.trans (hw (basisVector hb 0))
  have hcoord := congrArg (fun v : V hb => sourceCoordinates hb v 0) hvec
  simpa using hcoord.symm

/-- Every unitary source intertwiner differs from the constructed transport
by one scalar of modulus one. -/
theorem transport_unique_up_to_phase
    (F : V hb ≃ₗᵢ[ℂ] TwistedCarrier hb)
    (hF : ∀ (U : SU2) (v : V hb),
      F (sourceAction hb (U : Mat2) v) = twistedAction hb (U : Mat2) (F v)) :
    ∃ z : ℂ, ‖z‖ = 1 ∧ ∀ v : V hb, F v = z • transport hb v := by
  let T : Module.End ℂ (V hb) :=
    (transport hb).symm.toLinearEquiv.toLinearMap.comp F.toLinearEquiv.toLinearMap
  have hT (U : SU2) (v : V hb) :
      T (sourceAction hb (U : Mat2) v) = sourceAction hb (U : Mat2) (T v) := by
    apply (transport hb).injective
    calc
      transport hb (T (sourceAction hb (U : Mat2) v)) =
          F (sourceAction hb (U : Mat2) v) := by simp [T]
      _ = twistedAction hb (U : Mat2) (F v) := hF U v
      _ = twistedAction hb (U : Mat2) (transport hb (T v)) := by simp [T]
      _ = transport hb (sourceAction hb (U : Mat2) (T v)) :=
        (transport_intertwines hb U (T v)).symm
  obtain ⟨z, hz⟩ := source_commutant_scalar hb T hT
  have he (v : V hb) : F v = z • transport hb v := by
    have h := congrArg (transport hb) (hz v)
    simpa [T, map_smul] using h
  refine ⟨z, ?_, he⟩
  have hn := congrArg norm (he (basisVector hb 0))
  simpa only [norm_smul, F.norm_map, (transport hb).norm_map, basisVector_norm,
    mul_one] using hn.symm

private def negativeSource : SU2 :=
  ⟨canonical (-1) 0, canonical_mem_specialUnitary _ _ (by norm_num)⟩

private theorem negativeSource_matrix :
    (negativeSource : Mat2) = (-1 : ℂ) • (1 : Mat2) := by
  ext i j
  fin_cases i <;> fin_cases j <;> norm_num [negativeSource, canonical]

/-- In particular, no nonzero invariant vector lies on the transported
vacuum line: there are none anywhere in its two-dimensional carrier. -/
theorem twisted_invariant_eq_zero (v : TwistedCarrier hb)
    (hv : ∀ U : SU2, twistedAction hb (U : Mat2) v = v) : v = 0 := by
  have h := hv negativeSource
  rw [negativeSource_matrix, twistedAction_scalar] at h
  have hn : -v = v := by
    simpa only [show (-1 : ℂ) ^ 3 = -1 by norm_num, neg_one_smul] using h
  have hz : (2 : ℂ) • v = 0 := by
    calc
      (2 : ℂ) • v = v + v := by module
      _ = -v + v := congrArg (fun w => w + v) hn.symm
      _ = 0 := neg_add_cancel v
  exact (smul_eq_zero.mp hz).resolve_left (by norm_num)

theorem transportedVacuum_not_invariant :
    ¬ ∀ U : SU2, twistedAction hb (U : Mat2) (transportedVacuum hb) =
      transportedVacuum hb := by
  intro hv
  have h := transportedVacuum_norm hb
  rw [twisted_invariant_eq_zero hb _ hv, norm_zero] at h
  norm_num at h

end GeneratedFoundations.Operations.SourceVacuumTransport
