module

public import GeneratedFoundations.Operations.SourceSpinCorner
public import Mathlib.Algebra.Star.Subalgebra

/-!
# Matrix units generated by the normalized Gaussian ladder

The bounded shift is constructed on the original Lebesgue Hilbert space
from its proved Hermite basis. Its action on the dense polynomial Gaussian
core agrees with the actual differential annihilator after number
normalization. Thus it is the unique continuous extension of that source
operation. The vacuum projection and every rank-one matrix unit are then
words in this shift and its adjoint, rather than additional generators.
The algebra of finite source observations is generated by these matrix
units and the identity; it is a subalgebra of the ladder operation algebra.
-/

@[expose] public section

noncomputable section

open scoped ComplexConjugate lp
open GeneratedFoundations.Correlation.ComplexGaussianStates
open GeneratedFoundations.Operations.GaussianAffineLadder (embedding)
open GeneratedFoundations.Operations.HermiteFamily
open GeneratedFoundations.Operations.HermiteCompleteness
open GeneratedFoundations.Operations.SourceSpinCorner (End)

namespace GeneratedFoundations.Operations.SourceMatrixUnits

theorem state_inner {b : ℝ} (hb : 0 < b) (i j : ℕ) :
    inner ℂ (state hb i) (state hb j) = if i = j then 1 else 0 :=
  orthonormal_iff_ite.mp (state_orthonormal hb) i j

theorem end_ext {b : ℝ} (hb : 0 < b) {A B : End}
    (h : ∀ n, A (state hb n) = B (state hb n)) : A = B := by
  apply ContinuousLinearMap.ext
  intro F
  have hA := (hasSum_expansion hb F).mapL A
  have hB := (hasSum_expansion hb F).mapL B
  exact hA.unique (by simpa only [map_smul, h] using hB)

theorem shifted_orthonormal {b : ℝ} (hb : 0 < b) :
    Orthonormal ℂ (fun n : ℕ => state hb (n + 1)) :=
  (state_orthonormal hb).comp Nat.succ Nat.succ_injective

def raisingIsometry {b : ℝ} (hb : 0 < b) : ComplexL2 →ₗᵢ[ℂ] ComplexL2 :=
  (shifted_orthonormal hb).orthogonalFamily.linearIsometry.comp
    (coefficients hb).toLinearIsometry

def raisingShift {b : ℝ} (hb : 0 < b) : End :=
  (raisingIsometry hb).toContinuousLinearMap

def loweringShift {b : ℝ} (hb : 0 < b) : End := (raisingShift hb).adjoint

@[simp] theorem raisingShift_state {b : ℝ} (hb : 0 < b) (n : ℕ) :
    raisingShift hb (state hb n) = state hb (n + 1) := by
  have hc : coefficients hb (state hb n) = lp.single 2 n (1 : ℂ) := by
    simpa only [coefficients, basis_apply] using (basis hb).repr_self n
  change (shifted_orthonormal hb).orthogonalFamily.linearIsometry
    (coefficients hb (state hb n)) = _
  rw [hc, OrthogonalFamily.linearIsometry_apply_single]
  simp [LinearIsometry.toSpanSingleton_apply]

@[simp] theorem loweringShift_inner {b : ℝ} (hb : 0 < b) (F : ComplexL2) (n : ℕ) :
    inner ℂ (state hb n) (loweringShift hb F) = inner ℂ (state hb (n + 1)) F := by
  rw [loweringShift, ContinuousLinearMap.adjoint_inner_right, raisingShift_state]

@[simp] theorem loweringShift_state_zero {b : ℝ} (hb : 0 < b) :
    loweringShift hb (state hb 0) = 0 := by
  apply eq_of_coefficients_eq hb
  intro n
  simp only [loweringShift_inner, state_inner, Nat.add_one_ne_zero, ite_false,
    inner_zero_right]

@[simp] theorem loweringShift_state_succ {b : ℝ} (hb : 0 < b) (n : ℕ) :
    loweringShift hb (state hb (n + 1)) = state hb n := by
  apply eq_of_coefficients_eq hb
  intro m
  simp [state_inner]

@[simp] theorem loweringShift_adjoint {b : ℝ} (hb : 0 < b) :
    (loweringShift hb).adjoint = raisingShift hb := by simp [loweringShift]

/-- Number normalization is applied to the actual Schwartz mode before differentiation. -/
theorem normalized_annihilation {b : ℝ} (hb : 0 < b) (n : ℕ) :
    embedding (annihilation b (((Real.sqrt n : ℂ)⁻¹) • hermite hb n)) =
      loweringShift hb (state hb n) := by
  cases n with
  | zero =>
    rw [loweringShift_state_zero]
    simp only [Nat.cast_zero, Real.sqrt_zero, Complex.ofReal_zero, inv_zero, zero_smul,
      map_zero]
  | succ n =>
    have hn : (Real.sqrt (n + 1 : ℝ) : ℂ) ≠ 0 := by
      exact_mod_cast (Real.sqrt_pos.2 (by positivity : 0 < (n + 1 : ℝ))).ne'
    simp only [map_smul, annihilation_hermite_succ, smul_smul,
      SourceSpinCorner.embedding_hermite, loweringShift_state_succ]
    simp only [Nat.cast_add, Nat.cast_one]
    rw [inv_mul_cancel₀ hn, one_smul]

/-- The normalization agrees on every actual finite Gaussian preparation. -/
theorem normalized_annihilation_sum {b : ℝ} (hb : 0 < b)
    (s : Finset ℕ) (c : ℕ → ℂ) :
    embedding (annihilation b
      (∑ n ∈ s, c n • ((Real.sqrt n : ℂ)⁻¹ • hermite hb n))) =
      loweringShift hb (∑ n ∈ s, c n • state hb n) := by
  simp only [map_sum]
  apply Finset.sum_congr rfl
  intro n _
  rw [map_smul, map_smul, normalized_annihilation, map_smul]

/-- Density makes the bounded extension unique; no shift action is postulated. -/
theorem normalized_extension_unique {b : ℝ} (hb : 0 < b) (T : End)
    (hT : ∀ n, T (state hb n) =
      embedding (annihilation b ((Real.sqrt n : ℂ)⁻¹ • hermite hb n))) :
    T = loweringShift hb :=
  end_ext hb fun n => (hT n).trans (normalized_annihilation hb n)

/-- The weights are the unique nonnegative roots of the differential number eigenvalues. -/
theorem number_root_unique (n : ℕ) (r : ℝ) (hr : 0 ≤ r) (hs : r ^ 2 = n) :
    r = Real.sqrt n := by
  have hn : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  nlinarith [Real.sqrt_nonneg (n : ℝ), Real.sq_sqrt hn]

theorem annihilation_factorization {b : ℝ} (hb : 0 < b) (n : ℕ) :
    embedding (annihilation b (hermite hb n)) =
      loweringShift hb ((Real.sqrt n : ℂ) • state hb n) := by
  cases n with
  | zero =>
    rw [annihilation_hermite_zero]
    simp only [map_zero, Nat.cast_zero, Real.sqrt_zero, Complex.ofReal_zero, zero_smul]
  | succ n =>
    simp only [annihilation_hermite_succ, map_smul,
      SourceSpinCorner.embedding_hermite, loweringShift_state_succ, Nat.cast_add, Nat.cast_one]

/-- On the actual polynomial Gaussian core, the order is exactly `a = S sqrt(N)`. -/
theorem annihilation_factorization_sum {b : ℝ} (hb : 0 < b)
    (s : Finset ℕ) (c : ℕ → ℂ) :
    embedding (annihilation b (∑ n ∈ s, c n • hermite hb n)) =
      loweringShift hb (∑ n ∈ s, c n • ((Real.sqrt n : ℂ) • state hb n)) := by
  simp only [map_sum, map_smul, annihilation_factorization]

/-- The same finite source operations converge strongly on every original Hilbert-space vector. -/
theorem loweringShift_strong_expansion {b : ℝ} (hb : 0 < b) (F : ComplexL2) :
    HasSum (fun n => inner ℂ (state hb n) F • loweringShift hb (state hb n))
      (loweringShift hb F) := by
  simpa only [map_smul] using (hasSum_expansion hb F).mapL (loweringShift hb)

def matrixUnit {b : ℝ} (hb : 0 < b) (i j : ℕ) : End :=
  InnerProductSpace.rankOne ℂ (state hb i) (state hb j)

@[simp] theorem matrixUnit_apply {b : ℝ} (hb : 0 < b) (i j : ℕ) (F : ComplexL2) :
    matrixUnit hb i j F = inner ℂ (state hb j) F • state hb i := rfl

@[simp] theorem matrixUnit_state {b : ℝ} (hb : 0 < b) (i j k : ℕ) :
    matrixUnit hb i j (state hb k) = if j = k then state hb i else 0 := by
  simp [matrixUnit_apply, state_inner]

@[simp] theorem matrixUnit_adjoint {b : ℝ} (hb : 0 < b) (i j : ℕ) :
    (matrixUnit hb i j).adjoint = matrixUnit hb j i := by
  simp [matrixUnit, InnerProductSpace.adjoint_rankOne]

theorem matrixUnit_mul {b : ℝ} (hb : 0 < b) (i j k l : ℕ) :
    matrixUnit hb i j * matrixUnit hb k l =
      if j = k then matrixUnit hb i l else 0 := by
  apply ContinuousLinearMap.ext
  intro F
  change matrixUnit hb i j (matrixUnit hb k l F) = _
  by_cases h : j = k <;>
    simp [h, matrixUnit_apply, state_inner, (state_orthonormal hb).norm_eq_one]

theorem vacuum_projection {b : ℝ} (hb : 0 < b) :
    1 - (loweringShift hb).adjoint * loweringShift hb = matrixUnit hb 0 0 := by
  apply end_ext hb
  intro n
  rw [loweringShift_adjoint]
  simp only [sub_apply, one_apply_eq_self, mul_apply_eq_comp, matrixUnit_state]
  cases n with
  | zero => rw [loweringShift_state_zero, map_zero, ite_eq_left rfl, sub_zero]
  | succ n =>
    rw [loweringShift_state_succ, raisingShift_state, ite_eq_right (by omega), sub_self]

theorem raisingShift_pow_vacuum {b : ℝ} (hb : 0 < b) (n : ℕ) :
    (raisingShift hb ^ n) (state hb 0) = state hb n := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ']
    change raisingShift hb ((raisingShift hb ^ n) (state hb 0)) = _
    rw [ih, raisingShift_state]

theorem loweringShift_pow_inner {b : ℝ} (hb : 0 < b) (j n : ℕ) (F : ComplexL2) :
    inner ℂ (state hb n) ((loweringShift hb ^ j) F) =
      inner ℂ (state hb (n + j)) F := by
  induction j generalizing n with
  | zero => simp
  | succ j ih =>
    rw [pow_succ']
    change inner ℂ (state hb n) (loweringShift hb ((loweringShift hb ^ j) F)) = _
    rw [loweringShift_inner, ih]
    congr 2
    omega

/-- The rank-one matrix units are outputs of words in the same normalized differential source. -/
theorem matrixUnit_word {b : ℝ} (hb : 0 < b) (i j : ℕ) :
    (loweringShift hb).adjoint ^ i *
      (1 - (loweringShift hb).adjoint * loweringShift hb) * loweringShift hb ^ j =
        matrixUnit hb i j := by
  rw [vacuum_projection, loweringShift_adjoint]
  apply ContinuousLinearMap.ext
  intro F
  change (raisingShift hb ^ i) (matrixUnit hb 0 0 ((loweringShift hb ^ j) F)) = _
  rw [matrixUnit_apply, map_smul, raisingShift_pow_vacuum, loweringShift_pow_inner,
    Nat.zero_add, matrixUnit_apply]

/-- The algebra of words in the normalized ladder and its adjoint. -/
def ladderOperationAlgebra {b : ℝ} (hb : 0 < b) : StarSubalgebra ℂ End :=
  StarAlgebra.adjoin ℂ {loweringShift hb}

theorem loweringShift_mem {b : ℝ} (hb : 0 < b) :
    loweringShift hb ∈ ladderOperationAlgebra hb :=
  StarAlgebra.self_mem_adjoin_singleton ℂ _

theorem raisingShift_mem {b : ℝ} (hb : 0 < b) :
    raisingShift hb ∈ ladderOperationAlgebra hb := by
  have h : star (loweringShift hb) ∈ ladderOperationAlgebra hb :=
    star_mem (loweringShift_mem hb)
  simpa only [ContinuousLinearMap.star_eq_adjoint, loweringShift_adjoint] using h

theorem matrixUnit_mem_ladder {b : ℝ} (hb : 0 < b) (i j : ℕ) :
    matrixUnit hb i j ∈ ladderOperationAlgebra hb := by
  rw [← matrixUnit_word, loweringShift_adjoint]
  exact (ladderOperationAlgebra hb).mul_mem
    ((ladderOperationAlgebra hb).mul_mem
      ((ladderOperationAlgebra hb).pow_mem (raisingShift_mem hb) i)
      ((ladderOperationAlgebra hb).sub_mem (ladderOperationAlgebra hb).one_mem
        ((ladderOperationAlgebra hb).mul_mem (raisingShift_mem hb) (loweringShift_mem hb))))
    ((ladderOperationAlgebra hb).pow_mem (loweringShift_mem hb) j)

/-- The unital algebra generated by finite source matrix units. -/
def finiteSourceAlgebra {b : ℝ} (hb : 0 < b) : StarSubalgebra ℂ End :=
  StarAlgebra.adjoin ℂ (Set.range (fun ij : ℕ × ℕ => matrixUnit hb ij.1 ij.2))

theorem matrixUnit_mem {b : ℝ} (hb : 0 < b) (i j : ℕ) :
    matrixUnit hb i j ∈ finiteSourceAlgebra hb :=
  StarAlgebra.subset_adjoin ℂ _ ⟨(i, j), rfl⟩

/-- Every finite source observation is generated by the normalized differential ladder. -/
theorem finiteSourceAlgebra_le_ladder {b : ℝ} (hb : 0 < b) :
    finiteSourceAlgebra hb ≤ ladderOperationAlgebra hb := by
  apply StarAlgebra.adjoin_le
  rintro _ ⟨⟨i, j⟩, rfl⟩
  exact matrixUnit_mem_ladder hb i j

end GeneratedFoundations.Operations.SourceMatrixUnits
